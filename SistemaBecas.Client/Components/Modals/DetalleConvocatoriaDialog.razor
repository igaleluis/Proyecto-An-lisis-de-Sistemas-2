@using Radzen
@using Radzen.Blazor

@inject DialogService DialogService
@using SistemaBecas.Client.Services
@using SistemaBecas.Library.Dtos
@inject GestionApiClient Api
@inject NotificationService Notifications

<RadzenStack Gap="0.7rem">

    <RadzenText Text="Código"
                Style="font-size:12px;color:#6b7280;" />

    <RadzenText Text="@Id.ToString()"
                Style="font-weight:600;" />


    <RadzenText Text="Nombre"
                Style="font-size:12px;color:#6b7280;" />

    <RadzenText Text="@convocatoria?.Nombre"
                Style="font-weight:600;" />


    <RadzenText Text="Descripción"
                Style="font-size:12px;color:#6b7280;" />

    <RadzenText Text="@convocatoria?.Descripcion"
                Style="color:#374151;" />


    <RadzenText Text="Fecha inicio"
                Style="font-size:12px;color:#6b7280;" />

    <RadzenText Text="@(convocatoria?.FechaInicio.ToString("dd/MM/yyyy") ?? "")" />


    <RadzenText Text="Fecha fin"
                Style="font-size:12px;color:#6b7280;" />

    <RadzenText Text="@(convocatoria?.FechaFin.ToString("dd/MM/yyyy") ?? "")" />


    <RadzenText Text="Cupos"
                Style="font-size:12px;color:#6b7280;" />

    <RadzenText Text="@(convocatoria?.Cupos.ToString() ?? "")"
                Style="font-weight:700;color:#1565c0;" />


    <RadzenText Text="Estado"
                Style="font-size:12px;color:#6b7280;" />

    <RadzenBadge Text="@convocatoria?.Estado"
                 BadgeStyle="BadgeStyle.Primary" />


    <RadzenStack Orientation="Orientation.Horizontal"
                 JustifyContent="JustifyContent.End"
                 Style="margin-top:15px;">

        <RadzenButton Text="Cerrar"
                      ButtonStyle="ButtonStyle.Light"
                      Click="@Cerrar" />

    </RadzenStack>

</RadzenStack>


@code {

    [Parameter]
    public int Id { get; set; }

    private ConvocatoriaDto? convocatoria;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            convocatoria = await Api.ObtenerConvocatoriaAsync(Id);
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error, "No se pudo cargar", ex.Message);
        }
    }


    void Cerrar()
    {
        DialogService.Close();
    }

}

@using Radzen
@using Radzen.Blazor
@using SistemaBecas.Client.Services
@using SistemaBecas.Library.Dtos
@inject DialogService DialogService
@inject GestionApiClient Api
@inject NotificationService Notifications

<RadzenStack Gap="1rem">

    <!-- ENCABEZADO -->

    <RadzenCard Style="
        background:linear-gradient(135deg,#1565c0,#1e88e5);
        color:white;
        border-radius:12px;">

        <RadzenRow AlignItems="AlignItems.Center">

            <RadzenColumn Size="8">

                <RadzenText Text="Revisión de Solicitud"
                            TextStyle="TextStyle.H5"
                            Style="color:white;font-weight:700;" />

                <RadzenText Text="@($"Solicitud #{Solicitud.IdSolicitud}")"
                            Style="color:rgba(255,255,255,.9);" />

            </RadzenColumn>

            <RadzenColumn Size="4"
                          Style="text-align:right;">

                @if (Solicitud.Estado == "Pendiente")
                {
                    <RadzenBadge Text="Pendiente"
                                 BadgeStyle="BadgeStyle.Warning" />
                }
                else if (Solicitud.Estado == "En revisión")
                {
                    <RadzenBadge Text="En revisión"
                                 BadgeStyle="BadgeStyle.Info" />
                }
                else if (Solicitud.Estado == "Aprobada")
                {
                    <RadzenBadge Text="Aprobada"
                                 BadgeStyle="BadgeStyle.Success" />
                }
                else
                {
                    <RadzenBadge Text="Rechazada"
                                 BadgeStyle="BadgeStyle.Danger" />
                }

            </RadzenColumn>

        </RadzenRow>

    </RadzenCard>


    <!-- ESTUDIANTE -->

    <RadzenCard>

        <RadzenText Text="Datos del estudiante"
                    TextStyle="TextStyle.H6"
                    Style="color:#1565c0;font-weight:700;" />

        <hr />

        <RadzenRow Gap="1rem">

            <RadzenColumn Size="12" SizeMD="6">

                <RadzenText Text="Nombre"
                            Style="font-size:12px;color:#6b7280;" />

                <RadzenText Text="@Solicitud.Estudiante"
                            Style="font-weight:600;" />

            </RadzenColumn>


            <RadzenColumn Size="12" SizeMD="6">

                <RadzenText Text="DPI"
                            Style="font-size:12px;color:#6b7280;" />

                <RadzenText Text="@Solicitud.Dpi"
                            Style="font-weight:600;" />

            </RadzenColumn>


            <RadzenColumn Size="12" SizeMD="6">

                <RadzenText Text="Correo"
                            Style="font-size:12px;color:#6b7280;" />

                <RadzenText Text="@Solicitud.Correo" />

            </RadzenColumn>


            <RadzenColumn Size="12" SizeMD="6">

                <RadzenText Text="Teléfono"
                            Style="font-size:12px;color:#6b7280;" />

                <RadzenText Text="@Solicitud.Telefono" />

            </RadzenColumn>


            <RadzenColumn Size="12">

                <RadzenText Text="Dirección"
                            Style="font-size:12px;color:#6b7280;" />

                <RadzenText Text="@Solicitud.Direccion" />

            </RadzenColumn>

        </RadzenRow>

    </RadzenCard>


    <!-- CONVOCATORIA -->

    <RadzenCard>

        <RadzenText Text="Convocatoria"
                    TextStyle="TextStyle.H6"
                    Style="color:#1565c0;font-weight:700;" />

        <hr />

        <RadzenText Text="@Solicitud.Convocatoria"
                    Style="font-size:16px;font-weight:600;" />

        <RadzenText Text="@($"Solicitud realizada el {Solicitud.FechaSolicitud:dd/MM/yyyy}")"
                    Style="color:#6b7280;font-size:13px;" />

    </RadzenCard>


    @if (Solicitud.Punteo.HasValue)
    {
        <RadzenCard>
            <RadzenText Text="Punteo de evaluación" TextStyle="TextStyle.H6" Style="color:#1565c0;font-weight:700;" />
            <RadzenText Text="@Solicitud.Punteo.Value.ToString("0.##")" />
        </RadzenCard>
    }


    <!-- DECISIÓN -->

    @if (Solicitud.Estado == "Pendiente" ||
         Solicitud.Estado == "En revisión")
    {
        <RadzenCard>

            <RadzenText Text="Decisión"
                        TextStyle="TextStyle.H6"
                        Style="color:#1565c0;font-weight:700;" />

            <RadzenFormField Text="Justificación"
                             Style="width:100%;">

                <RadzenTextArea @bind-Value="justificacion"
                                Rows="4"
                                Style="width:100%;"
                                Placeholder="Escriba la justificación..." />

            </RadzenFormField>


            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.End"
                         Gap="0.5rem"
                         Style="margin-top:20px;">

                <RadzenButton Text="Rechazar"
                              Icon="cancel"
                              ButtonStyle="ButtonStyle.Danger"
                              Click="@Rechazar" />

                <RadzenButton Text="Aprobar"
                              Icon="check_circle"
                              ButtonStyle="ButtonStyle.Success"
                              Click="@Aprobar" />

            </RadzenStack>

        </RadzenCard>
    }

</RadzenStack>

@code {

    [Parameter]
    public SolicitudGestionDto Solicitud { get; set; } = new();

    private string justificacion = "";


    private async Task Aprobar()
    {
        await GuardarDecisionAsync("Aprobada");
    }


    private async Task Rechazar()
    {
        if (string.IsNullOrWhiteSpace(justificacion))
        {
            Notifications.Notify(NotificationSeverity.Warning, "Justificación requerida", "Escribe el motivo del rechazo.");
            return;
        }
        await GuardarDecisionAsync("Rechazada");
    }

    private async Task GuardarDecisionAsync(string estado)
    {
        try
        {
            await Api.ActualizarEstadoSolicitudAsync(Solicitud.IdSolicitud, new SolicitudEstadoDto
            {
                Estado = estado,
                Observaciones = string.IsNullOrWhiteSpace(justificacion) ? Solicitud.Observaciones : justificacion.Trim()
            });
            Solicitud.Estado = estado;
            Solicitud.Observaciones = string.IsNullOrWhiteSpace(justificacion) ? Solicitud.Observaciones : justificacion.Trim();
            DialogService.Close(true);
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error, "No se pudo guardar la decisión", ex.Message);
        }
    }

}

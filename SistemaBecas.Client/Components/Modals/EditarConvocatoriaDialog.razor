@using Radzen
@using Radzen.Blazor

@inject DialogService DialogService

<RadzenStack Gap="1rem">

    <RadzenFormField Text="Nombre"
                     Style="width: 100%;">

        <RadzenTextBox @bind-Value="Nombre"
                       Style="width: 100%;" />

    </RadzenFormField>


    <RadzenFormField Text="Descripción"
                     Style="width: 100%;">

        <RadzenTextArea @bind-Value="Descripcion"
                        Rows="4"
                        Style="width: 100%;" />

    </RadzenFormField>


    <RadzenRow Gap="1rem">

        <RadzenColumn Size="12" SizeMD="6">

            <RadzenFormField Text="Fecha inicio"
                             Style="width: 100%;">

                <RadzenDatePicker @bind-Value="FechaInicio"
                                  DateFormat="dd/MM/yyyy"
                                  Style="width: 100%;" />

            </RadzenFormField>

        </RadzenColumn>


        <RadzenColumn Size="12" SizeMD="6">

            <RadzenFormField Text="Fecha fin"
                             Style="width: 100%;">

                <RadzenDatePicker @bind-Value="FechaFin"
                                  DateFormat="dd/MM/yyyy"
                                  Style="width: 100%;" />

            </RadzenFormField>

        </RadzenColumn>

    </RadzenRow>


    <RadzenFormField Text="Cupos"
                     Style="width: 100%;">

        <RadzenNumeric @bind-Value="Cupos"
                       Min="0"
                       Step="1"
                       Style="width: 100%;" />

    </RadzenFormField>


    <RadzenFormField Text="Estado"
                     Style="width: 100%;">

        <RadzenDropDown @bind-Value="Estado"
                        Data="@(new[] {
                                            "Activa",
                                            "Próxima",
                                            "Cerrada"
                                        })"
                        Style="width: 100%;" />

    </RadzenFormField>


    <RadzenStack Orientation="Orientation.Horizontal"
                 JustifyContent="JustifyContent.End"
                 Gap="0.5rem"
                 Style="margin-top: 10px;">

        <RadzenButton Text="Cancelar"
                      ButtonStyle="ButtonStyle.Light"
                      Click="@Cancelar" />

        <RadzenButton Text="Guardar cambios"
                      Icon="save"
                      ButtonStyle="ButtonStyle.Primary"
                      Click="@GuardarCambios" />

    </RadzenStack>

</RadzenStack>


@code {

    [Parameter]
    public int Id { get; set; }


    string Nombre { get; set; } = "";

    string Descripcion { get; set; } = "";

    DateTime? FechaInicio { get; set; }

    DateTime? FechaFin { get; set; }

    int? Cupos { get; set; }

    string Estado { get; set; } = "";


    protected override void OnInitialized()
    {
        // Temporalmente cargamos datos de ejemplo
        // posteriormente vendrán del API según Id

        Nombre = "Beca Nacional Universitaria 2026";

        Descripcion =
            "Convocatoria dirigida a estudiantes universitarios que deseen optar a una beca para continuar sus estudios durante el año 2026.";

        FechaInicio = new DateTime(2026, 3, 1);

        FechaFin = new DateTime(2026, 12, 15);

        Cupos = 100;

        Estado = "Activa";
    }


    void Cancelar()
    {
        DialogService.Close(false);
    }


    void GuardarCambios()
    {
        // Posteriormente aquí irá el PUT/PATCH al API

        DialogService.Close(true);
    }

}
@using Radzen
@using Radzen.Blazor

@inject DialogService DialogService
@using SistemaBecas.Client.Services
@using SistemaBecas.Library.Dtos
@inject GestionApiClient Api
@inject NotificationService Notifications

<RadzenStack Gap="1rem">

    <RadzenFormField Text="Nombre"
                     Style="width: 100%;">

        <RadzenTextBox @bind-Value="Nombre"
                       Style="width: 100%;" />

    </RadzenFormField>


    <RadzenFormField Text="Descripción"
                     Style="width: 100%;">

        <RadzenTextArea @bind-Value="Descripcion"
                        Rows="4"
                        Style="width: 100%;" />

    </RadzenFormField>


    <RadzenRow Gap="1rem">

        <RadzenColumn Size="12" SizeMD="6">

            <RadzenFormField Text="Fecha inicio"
                             Style="width: 100%;">

                <RadzenDatePicker @bind-Value="FechaInicio"
                                  DateFormat="dd/MM/yyyy"
                                  Style="width: 100%;" />

            </RadzenFormField>

        </RadzenColumn>


        <RadzenColumn Size="12" SizeMD="6">

            <RadzenFormField Text="Fecha fin"
                             Style="width: 100%;">

                <RadzenDatePicker @bind-Value="FechaFin"
                                  DateFormat="dd/MM/yyyy"
                                  Style="width: 100%;" />

            </RadzenFormField>

        </RadzenColumn>

    </RadzenRow>


    <RadzenFormField Text="Cupos"
                     Style="width: 100%;">

        <RadzenNumeric @bind-Value="Cupos"
                       Min="0"
                       Step="1"
                       Style="width: 100%;" />

    </RadzenFormField>


    <RadzenFormField Text="Estado"
                     Style="width: 100%;">

        <RadzenDropDown @bind-Value="Estado"
                        Data="@(new[] {
                                            "Activa",
                                            "Próxima",
                                            "Cerrada"
                                        })"
                        Style="width: 100%;" />

    </RadzenFormField>


    <RadzenStack Orientation="Orientation.Horizontal"
                 JustifyContent="JustifyContent.End"
                 Gap="0.5rem"
                 Style="margin-top: 10px;">

        <RadzenButton Text="Cancelar"
                      ButtonStyle="ButtonStyle.Light"
                      Click="@Cancelar" />

        <RadzenButton Text="Guardar cambios"
                      Icon="save"
                      ButtonStyle="ButtonStyle.Primary"
                      Click="@GuardarCambios" />

    </RadzenStack>

</RadzenStack>


@code {

    [Parameter]
    public int Id { get; set; }


    string Nombre { get; set; } = "";

    string Descripcion { get; set; } = "";

    DateTime? FechaInicio { get; set; }

    DateTime? FechaFin { get; set; }

    int? Cupos { get; set; }

    string Estado { get; set; } = "";
    bool Guardando { get; set; }
    bool Cargando { get; set; }


    protected override async Task OnInitializedAsync()
    {
        Cargando = true;
        try
        {
            var convocatoria = await Api.ObtenerConvocatoriaAsync(Id);
            if (convocatoria is null)
            {
                Notifications.Notify(NotificationSeverity.Warning, "No encontrada", "La convocatoria ya no existe.");
                DialogService.Close(false);
                return;
            }
            Nombre = convocatoria.Nombre;
            Descripcion = convocatoria.Descripcion;
            FechaInicio = convocatoria.FechaInicio;
            FechaFin = convocatoria.FechaFin;
            Cupos = convocatoria.Cupos;
            Estado = convocatoria.Estado;
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error, "No se pudo cargar", ex.Message);
            DialogService.Close(false);
        }
        finally
        {
            Cargando = false;
        }
    }


    void Cancelar()
    {
        DialogService.Close(false);
    }


    async Task GuardarCambios()
    {
        if (string.IsNullOrWhiteSpace(Nombre) || FechaInicio is null || FechaFin is null || Cupos is null)
        {
            Notifications.Notify(NotificationSeverity.Warning, "Datos incompletos", "Completa nombre, fechas y cupos.");
            return;
        }
        Guardando = true;
        try
        {
            await Api.ActualizarConvocatoriaAsync(Id, new ConvocatoriaGuardarDto
            {
                Nombre = Nombre,
                Descripcion = Descripcion,
                FechaInicio = FechaInicio.Value,
                FechaFin = FechaFin.Value,
                Cupos = Cupos.Value,
                Estado = Estado
            });
            DialogService.Close(true);
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error, "No se pudo actualizar", ex.Message);
        }
        finally
        {
            Guardando = false;
        }
    }

}

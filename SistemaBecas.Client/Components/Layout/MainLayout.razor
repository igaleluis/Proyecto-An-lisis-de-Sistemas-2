@inherits LayoutComponentBase

<RadzenLayout>

    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     Gap="1rem">

            <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />

            <RadzenLabel Text="Sistema de Becas" />

        </RadzenStack>
    </RadzenHeader>


    <RadzenSidebar @bind-Expanded="@sidebarExpanded">

        <RadzenPanelMenu>

            <RadzenPanelMenuItem Text="Inicio"
                                 Icon="home"
                                 Path="/" />

            <RadzenPanelMenuItem Text="Becas"
                                 Icon="school">

                <RadzenPanelMenuItem Text="Listado de becas"
                                     Icon="list"
                                     Path="/becas" />

                <RadzenPanelMenuItem Text="Nueva beca"
                                     Icon="add"
                                     Path="/becas/nueva" />

            </RadzenPanelMenuItem>

            <RadzenPanelMenuItem Text="Solicitudes"
                                 Icon="description"
                                 Path="/solicitudes" />

            <RadzenPanelMenuItem Text="Usuarios"
                                 Icon="account_circle"
                                 Path="/usuarios" />

            <RadzenPanelMenuItem Text="Reportes"
                                 Icon="bar_chart"
                                 Path="/reportes" />

        </RadzenPanelMenu>

    </RadzenSidebar>


    <RadzenBody>

        <div class="rz-p-4">
            @Body
        </div>

    </RadzenBody>


    

</RadzenLayout>


@code {

    bool sidebarExpanded = true;

}
@inherits LayoutComponentBase
@using Radzen

<RadzenDialog />

<RadzenNotification />

<RadzenTooltip />

<RadzenContextMenu />
<RadzenLayout>

    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     JustifyContent="JustifyContent.SpaceBetween"
                     Gap="1rem"
                     class="rz-p-2">

            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         Gap="1rem">

                <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />

                <RadzenLabel Text="Sistema de Becas" />

            </RadzenStack>

            <RadzenLink Path="/Login"
                        Text="Iniciar Sesión"
                        Icon="login"
                        class="login-button" />

        </RadzenStack>
    </RadzenHeader>


    <RadzenSidebar @bind-Expanded="@sidebarExpanded">

        <RadzenPanelMenu Multiple="false">

            <RadzenPanelMenuItem Text="Inicio"
                                 Icon="home"
                                 Path="/"
                                 Click="@CloseSidebar" />


            <!-- CONVOCATORIAS -->
            <RadzenPanelMenuItem Text="Convocatorias"
                                 Icon="add_ad">

                <RadzenPanelMenuItem Text="Administrar Convocatorias"
                                     Path="/"
                                     Click="@CloseSidebar" />

            </RadzenPanelMenuItem>


            <!-- ESTUDIANTES -->
            <RadzenPanelMenuItem Text="Estudiantes"
                                 Icon="person">

                <RadzenPanelMenuItem Text="Registrar Estudiantes"
                                     Path="/registrar-estudiante"
                                     Click="@CloseSidebar" />

            </RadzenPanelMenuItem>


            <!-- SOLICITUDES -->
            <RadzenPanelMenuItem Text="Solicitudes"
                                 Icon="description">

                <RadzenPanelMenuItem Text="Gestionar Solicitudes"
                                     Path="/"
                                     Click="@CloseSidebar" />

                <RadzenPanelMenuItem Text="Cargar Documentación"
                                     Path="/cargar-documentacion"
                                     Click="@CloseSidebar" />

                <RadzenPanelMenuItem Text="Consultar Estado de Becas"
                                     Path="/consultar-estado-beca"
                                     Click="@CloseSidebar" />

            </RadzenPanelMenuItem>


            <!-- EVALUACIONES -->
            <RadzenPanelMenuItem Text="Evaluaciones"
                                 Icon="quiz">

                <RadzenPanelMenuItem Text="Administrar Evaluaciones"
                                     Path="/"
                                     Click="@CloseSidebar" />

            </RadzenPanelMenuItem>


            <!-- COMITÉS -->
            <RadzenPanelMenuItem Text="Comités"
                                 Icon="group">

                <RadzenPanelMenuItem Text="Gestionar Comités Evaluadores"
                                     Path="/gestionar-comites-evaluadores"
                                     Click="@CloseSidebar" />

            </RadzenPanelMenuItem>


            <!-- RESOLUCIÓN -->
            <RadzenPanelMenuItem Text="Resolución"
                                 Icon="rule">

                <RadzenPanelMenuItem Text="Aprobar o Rechazar Solicitudes"
                                     Path="/"
                                     Click="@CloseSidebar" />

            </RadzenPanelMenuItem>


            <!-- REPORTES -->
            <RadzenPanelMenuItem Text="Reportes"
                                 Icon="picture_as_pdf">

                <RadzenPanelMenuItem Text="Generar Reportes Básicos"
                                     Path="/"
                                     Click="@CloseSidebar" />

            </RadzenPanelMenuItem>

        </RadzenPanelMenu>

    </RadzenSidebar>


    <RadzenBody>

        <div class="rz-p-4">
            @Body
        </div>

    </RadzenBody>


    

</RadzenLayout>


@code {

    bool sidebarExpanded = true;

    


    void CloseSidebar()
    {
        sidebarExpanded = false;
    }

}
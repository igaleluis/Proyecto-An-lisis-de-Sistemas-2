@page "/adminconvocatorias"
<PageTitle>Administración de Convocatorias</PageTitle>

<div class="convocatorias-page">

    <div class="convocatorias-container">

        <div class="convocatorias-card">

            <!-- ENCABEZADO -->
            <div class="convocatorias-header">

                <div class="header-texto">
                    <h1>Administración de Convocatorias</h1>
                    <p>Crear, editar y gestionar convocatorias de becas</p>
                </div>

                <button type="button" class="btn-nueva" @onclick="() => AbrirFormulario(null)">
                    + Nueva Convocatoria
                </button>

            </div>

            <!-- CONTENIDO -->
            <div class="contenido">

                <!-- TARJETAS DE ESTADO -->
                <div class="stats-row">

                    <div class="stat-box">
                        <div>
                            <div class="stat-label">Activas</div>
                            <div class="stat-value azul">@convocatorias.Count(x => x.Estado == "Activa")</div>
                        </div>
                        <div class="stat-icon">🚀</div>
                    </div>

                    <div class="stat-box">
                        <div>
                            <div class="stat-label">Próximas</div>
                            <div class="stat-value celeste">@convocatorias.Count(x => x.Estado == "Próxima")</div>
                        </div>
                        <div class="stat-icon">🕒</div>
                    </div>

                    <div class="stat-box">
                        <div>
                            <div class="stat-label">Cerradas</div>
                            <div class="stat-value gris">@convocatorias.Count(x => x.Estado == "Cerrada")</div>
                        </div>
                        <div class="stat-icon">🔒</div>
                    </div>

                </div>

                <!-- FILTROS -->
                <div class="filter-card">

                    <div class="form-title">
                        <h3>Filtros de búsqueda</h3>
                        <p>Utilice los filtros para encontrar una convocatoria.</p>
                    </div>

                    <div class="filter-row">

                        <div class="form-group">
                            <label>Estado</label>
                            <select @bind="estadoFiltro">
                                <option value="">Todos</option>
                                @foreach (var e in estados)
                                {
                                    <option value="@e">@e</option>
                                }
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Tipo</label>
                            <select @bind="tipoFiltro">
                                <option value="">Todos</option>
                                @foreach (var t in tipos)
                                {
                                    <option value="@t">@t</option>
                                }
                            </select>
                        </div>

                        <div class="form-group grow">
                            <label>Buscar convocatoria</label>
                            <input type="text" @bind="busqueda" placeholder="Nombre o código" />
                        </div>

                        <div class="form-group btn-wrap">
                            <button type="button" class="btn-buscar" @onclick="Buscar">
                                Buscar
                            </button>
                        </div>

                    </div>

                </div>

                <!-- TABLA -->
                <div class="table-card">

                    <div class="form-title">
                        <h3>Convocatorias</h3>
                        <p>Listado de convocatorias de becas</p>
                    </div>

                    <div class="table-wrapper">

                        <table>
                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Nombre</th>
                                    <th>Tipo</th>
                                    <th>Fecha inicio</th>
                                    <th>Fecha fin</th>
                                    <th>Monto (Q)</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (convocatoriasFiltradas.Count == 0)
                                {
                                    <tr>
                                        <td colspan="8" class="empty-text">No se encontraron convocatorias.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var c in convocatoriasFiltradas)
                                    {
                                        <tr>
                                            <td>@c.Codigo</td>
                                            <td>@c.Nombre</td>
                                            <td>@c.Tipo</td>
                                            <td>@c.FechaInicio.ToString("dd/MM/yyyy")</td>
                                            <td>@c.FechaFin.ToString("dd/MM/yyyy")</td>
                                            <td class="monto">@c.Monto.ToString("N0")</td>
                                            <td>
                                                @if (c.Estado == "Activa")
                                                {
                                                    <span class="badge-activa">Activa</span>
                                                }
                                                else if (c.Estado == "Próxima")
                                                {
                                                    <span class="badge-proxima">Próxima</span>
                                                }
                                                else
                                                {
                                                    <span class="badge-cerrada">Cerrada</span>
                                                }
                                            </td>
                                            <td class="acciones">
                                                <button class="btn-icon" title="Editar" @onclick="() => AbrirFormulario(c)">✏️</button>
                                                <button class="btn-icon" title="Ver" @onclick="() => VerDetalle(c)">👁️</button>
                                                <button class="btn-icon btn-danger" title="Eliminar" @onclick="() => PedirEliminar(c)">🗑️</button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- MODAL: NUEVA / EDITAR CONVOCATORIA -->
@if (mostrarFormulario && convocatoriaForm is not null)
{
    <div class="modal-overlay">
        <div class="modal-box">

            <h3>@(esNuevaConvocatoria ? "Nueva Convocatoria" : "Editar Convocatoria")</h3>

            <div class="form-group">
                <label>Nombre</label>
                <input type="text" @bind="convocatoriaForm.Nombre" placeholder="Nombre de la convocatoria" />
            </div>

            <div class="form-group">
                <label>Tipo</label>
                <select @bind="convocatoriaForm.Tipo">
                    @foreach (var t in tipos)
                    {
                        <option value="@t">@t</option>
                    }
                </select>
            </div>

            <div class="filter-row">
                <div class="form-group">
                    <label>Fecha inicio</label>
                    <input type="date" @bind="convocatoriaForm.FechaInicio" />
                </div>
                <div class="form-group">
                    <label>Fecha fin</label>
                    <input type="date" @bind="convocatoriaForm.FechaFin" />
                </div>
            </div>

            <div class="form-group">
                <label>Monto (Q)</label>
                <input type="number" min="0" step="500" @bind="convocatoriaForm.Monto" />
            </div>

            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <div class="error-msg">@mensajeError</div>
            }

            <div class="modal-actions">
                <button type="button" class="btn-cancelar" @onclick="CerrarFormulario">Cancelar</button>
                <button type="button" class="btn-guardar" @onclick="GuardarFormulario">Guardar</button>
            </div>

        </div>
    </div>
}


<!-- MODAL: DETALLE -->
@if (mostrarDetalle && convocatoriaDetalle is not null)
{
    <div class="modal-overlay">
        <div class="modal-box">

            <h3>Detalle: @convocatoriaDetalle.Nombre</h3>

            <div class="detalle-item"><strong>Código:</strong> @convocatoriaDetalle.Codigo</div>
            <div class="detalle-item"><strong>Nombre:</strong> @convocatoriaDetalle.Nombre</div>
            <div class="detalle-item"><strong>Tipo:</strong> @convocatoriaDetalle.Tipo</div>
            <div class="detalle-item"><strong>Inicio:</strong> @convocatoriaDetalle.FechaInicio.ToString("dd/MM/yyyy")</div>
            <div class="detalle-item"><strong>Fin:</strong> @convocatoriaDetalle.FechaFin.ToString("dd/MM/yyyy")</div>
            <div class="detalle-item"><strong>Monto:</strong> Q@(convocatoriaDetalle.Monto.ToString("N0"))</div>
            <div class="detalle-item"><strong>Estado:</strong> @convocatoriaDetalle.Estado</div>

            <div class="modal-actions">
                <button type="button" class="btn-cancelar" @onclick="() => mostrarDetalle = false">Cerrar</button>
            </div>

        </div>
    </div>
}


<!-- MODAL: CONFIRMAR ELIMINACIÓN -->
@if (mostrarConfirmarEliminar && convocatoriaAEliminar is not null)
{
    <div class="modal-overlay">
        <div class="modal-box modal-box-sm">

            <h3>Confirmar eliminación</h3>
            <p>¿Desea eliminar la convocatoria "@convocatoriaAEliminar.Nombre"?</p>

            <div class="modal-actions">
                <button type="button" class="btn-cancelar" @onclick="() => mostrarConfirmarEliminar = false">Cancelar</button>
                <button type="button" class="btn-eliminar" @onclick="ConfirmarEliminar">Eliminar</button>
            </div>

        </div>
    </div>
}



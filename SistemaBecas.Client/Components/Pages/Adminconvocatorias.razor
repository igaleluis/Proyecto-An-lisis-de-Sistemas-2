@page "/adminconvocatorias"

@using Radzen
@using Radzen.Blazor

<PageTitle>Administración de Convocatorias</PageTitle>

<RadzenStack Gap="1.5rem"
             Style="padding: 2rem; background-color: #f4f7fb; min-height: 100vh;">

    <!-- ====================================================== -->
    <!-- ENCABEZADO                                             -->
    <!-- ====================================================== -->

    <RadzenCard Style="
        background: linear-gradient(135deg, #1565c0, #1e88e5);
        color: white;
        border-radius: 16px;
        border: none;
        padding: 2rem;">

        <RadzenRow AlignItems="AlignItems.Center">

            <RadzenColumn Size="12" SizeMD="8">

                <RadzenText Text="Administración de Convocatorias"
                            TextStyle="TextStyle.H4"
                            Style="
                color: white;
                font-weight: 700;
                margin-bottom: 6px;" />

                <RadzenText Text="Crear, editar y gestionar convocatorias de becas"
                            Style="
                color: rgba(255,255,255,0.9);
                font-size: 15px;" />

            </RadzenColumn>

            <RadzenColumn Size="12"
                          SizeMD="4"
                          Style="text-align: right;">

                <RadzenButton Text="Nueva Convocatoria"
                              Icon="add"
                              ButtonStyle="ButtonStyle.Light" />

            </RadzenColumn>

        </RadzenRow>

    </RadzenCard>


    <!-- ====================================================== -->
    <!-- ESTADÍSTICAS                                           -->
    <!-- ====================================================== -->

    <RadzenRow>

        <!-- ACTIVAS -->
        <RadzenColumn Size="12" SizeMD="4">

            <RadzenCard Style="
                border-radius: 12px;
                border: 1px solid #e5e7eb;">

                <RadzenRow AlignItems="AlignItems.Center">

                    <RadzenColumn Size="8">

                        <RadzenText Text="Activas"
                                    Style="
                        color: #6b7280;
                        font-size: 13px;" />

                        <RadzenText Text="2"
                                    TextStyle="TextStyle.H4"
                                    Style="
                        color: #1565c0;
                        font-weight: 700;
                        margin-top: 5px;" />

                    </RadzenColumn>

                    <RadzenColumn Size="4"
                                  Style="text-align: right;">

                        <RadzenIcon Icon="check_circle"
                                    Style="
                        font-size: 38px;
                        color: #1565c0;" />

                    </RadzenColumn>

                </RadzenRow>

            </RadzenCard>

        </RadzenColumn>


        <!-- PRÓXIMAS -->
        <RadzenColumn Size="12" SizeMD="4">

            <RadzenCard Style="
                border-radius: 12px;
                border: 1px solid #e5e7eb;">

                <RadzenRow AlignItems="AlignItems.Center">

                    <RadzenColumn Size="8">

                        <RadzenText Text="Próximas"
                                    Style="
                        color: #6b7280;
                        font-size: 13px;" />

                        <RadzenText Text="1"
                                    TextStyle="TextStyle.H4"
                                    Style="
                        color: #64b5f6;
                        font-weight: 700;
                        margin-top: 5px;" />

                    </RadzenColumn>

                    <RadzenColumn Size="4"
                                  Style="text-align: right;">

                        <RadzenIcon Icon="event"
                                    Style="
                        font-size: 38px;
                        color: #64b5f6;" />

                    </RadzenColumn>

                </RadzenRow>

            </RadzenCard>

        </RadzenColumn>


        <!-- CERRADAS -->
        <RadzenColumn Size="12" SizeMD="4">

            <RadzenCard Style="
                border-radius: 12px;
                border: 1px solid #e5e7eb;">

                <RadzenRow AlignItems="AlignItems.Center">

                    <RadzenColumn Size="8">

                        <RadzenText Text="Cerradas"
                                    Style="
                        color: #6b7280;
                        font-size: 13px;" />

                        <RadzenText Text="2"
                                    TextStyle="TextStyle.H4"
                                    Style="
                        color: #94a3b8;
                        font-weight: 700;
                        margin-top: 5px;" />

                    </RadzenColumn>

                    <RadzenColumn Size="4"
                                  Style="text-align: right;">

                        <RadzenIcon Icon="lock"
                                    Style="
                        font-size: 38px;
                        color: #94a3b8;" />

                    </RadzenColumn>

                </RadzenRow>

            </RadzenCard>

        </RadzenColumn>

    </RadzenRow>


    <!-- ====================================================== -->
    <!-- FILTROS                                                -->
    <!-- ====================================================== -->

    <RadzenCard Style="
        border-radius: 12px;
        background-color: #f7fbff;
        border: 1px solid #e3edf7;">

        <RadzenText Text="Filtros de búsqueda"
                    TextStyle="TextStyle.H6"
                    Style="
        color: #1565c0;
        font-weight: 700;
        margin-bottom: 5px;" />

        <RadzenText Text="Utilice los filtros para encontrar una convocatoria."
                    Style="
        color: #6b7280;
        font-size: 13px;
        margin-bottom: 20px;" />

        <RadzenRow AlignItems="AlignItems.End">

            <!-- ESTADO -->

            <RadzenColumn Size="12" SizeMD="3">

                <RadzenFormField Text="Estado"
                                 Style="width: 100%;">

                    <RadzenDropDown TValue="string"
                                    Data="@(new[] { "Activa", "Próxima", "Cerrada" })"
                                    Placeholder="Todos"
                                    AllowClear="true"
                                    Style="width: 100%;" />

                </RadzenFormField>

            </RadzenColumn>


            <!-- BUSCAR -->

            <RadzenColumn Size="12" SizeMD="5">

                <RadzenFormField Text="Buscar convocatoria"
                                 Style="width: 100%;">

                    <RadzenTextBox TValue="string"
                                   Placeholder="Nombre o código"
                                   Style="width: 100%;" />

                </RadzenFormField>

            </RadzenColumn>


            <!-- BOTÓN -->

            <RadzenColumn Size="12" SizeMD="2">

                <RadzenButton Text="Buscar"
                              Icon="search"
                              ButtonStyle="ButtonStyle.Primary"
                              Style="width: 100%;" />

            </RadzenColumn>

        </RadzenRow>

    </RadzenCard>


    <!-- ====================================================== -->
    <!-- TABLA VISUAL                                           -->
    <!-- ====================================================== -->

    <RadzenCard Style="
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        overflow-x: auto;">

        <RadzenText Text="Convocatorias"
                    TextStyle="TextStyle.H6"
                    Style="
        color: #1565c0;
        font-weight: 700;
        margin-bottom: 5px;" />

        <RadzenText Text="Listado de convocatorias de becas"
                    Style="
        color: #6b7280;
        font-size: 13px;
        margin-bottom: 20px;" />


        <!-- ENCABEZADO -->

        <RadzenRow Style="
            background-color: #f1f5f9;
            padding: 14px 10px;
            font-weight: 700;
            color: #475569;
            min-width: 1050px;">

            <RadzenColumn Size="1">
                Código
            </RadzenColumn>

            <RadzenColumn Size="3">
                Nombre
            </RadzenColumn>

            <RadzenColumn Size="2">
                Fecha inicio
            </RadzenColumn>

            <RadzenColumn Size="2">
                Fecha fin
            </RadzenColumn>

            <RadzenColumn Size="1">
                Cupos
            </RadzenColumn>

            <RadzenColumn Size="1">
                Estado
            </RadzenColumn>

            <RadzenColumn Size="2">
                Acciones
            </RadzenColumn>

        </RadzenRow>


        <!-- FILA 1 -->

        <RadzenRow Style="
            padding: 16px 10px;
            border-bottom: 1px solid #e5e7eb;
            min-width: 1050px;
            align-items: center;">

            <RadzenColumn Size="1">
                <strong>1</strong>
            </RadzenColumn>

            <RadzenColumn Size="3">
                Beca Nacional Universitaria 2026
            </RadzenColumn>

            <RadzenColumn Size="2">
                01/03/2026
            </RadzenColumn>

            <RadzenColumn Size="2">
                15/12/2026
            </RadzenColumn>

            <RadzenColumn Size="1">
                100
            </RadzenColumn>

            <RadzenColumn Size="1">

                <RadzenBadge Text="Activa"
                             BadgeStyle="BadgeStyle.Primary" />

            </RadzenColumn>

            <RadzenColumn Size="2">

                <RadzenStack Orientation="Orientation.Horizontal"
                             Gap="0.3rem">

                    <RadzenButton Icon="edit"
                                  ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small" />

                    <RadzenButton Icon="visibility"
                                  ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small" />

                    <RadzenButton Icon="delete"
                                  ButtonStyle="ButtonStyle.Danger"
                                  Size="ButtonSize.Small" />

                </RadzenStack>

            </RadzenColumn>

        </RadzenRow>


        <!-- FILA 2 -->

        <RadzenRow Style="
            padding: 16px 10px;
            border-bottom: 1px solid #e5e7eb;
            min-width: 1050px;
            align-items: center;">

            <RadzenColumn Size="1">
                <strong>2</strong>
            </RadzenColumn>

            <RadzenColumn Size="3">
                Beca Internacional Posgrado
            </RadzenColumn>

            <RadzenColumn Size="2">
                01/11/2026
            </RadzenColumn>

            <RadzenColumn Size="2">
                31/03/2027
            </RadzenColumn>

            <RadzenColumn Size="1">
                50
            </RadzenColumn>

            <RadzenColumn Size="1">

                <RadzenBadge Text="Próxima"
                             BadgeStyle="BadgeStyle.Info" />

            </RadzenColumn>

            <RadzenColumn Size="2">

                <RadzenStack Orientation="Orientation.Horizontal"
                             Gap="0.3rem">

                    <RadzenButton Icon="edit"
                                  ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small" />

                    <RadzenButton Icon="visibility"
                                  ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small" />

                    <RadzenButton Icon="delete"
                                  ButtonStyle="ButtonStyle.Danger"
                                  Size="ButtonSize.Small" />

                </RadzenStack>

            </RadzenColumn>

        </RadzenRow>


        <!-- FILA 3 -->

        <RadzenRow Style="
            padding: 16px 10px;
            border-bottom: 1px solid #e5e7eb;
            min-width: 1050px;
            align-items: center;">

            <RadzenColumn Size="1">
                <strong>3</strong>
            </RadzenColumn>

            <RadzenColumn Size="3">
                Beca Técnica Media
            </RadzenColumn>

            <RadzenColumn Size="2">
                01/09/2025
            </RadzenColumn>

            <RadzenColumn Size="2">
                15/12/2025
            </RadzenColumn>

            <RadzenColumn Size="1">
                75
            </RadzenColumn>

            <RadzenColumn Size="1">

                <RadzenBadge Text="Cerrada"
                             BadgeStyle="BadgeStyle.Light" />

            </RadzenColumn>

            <RadzenColumn Size="2">

                <RadzenStack Orientation="Orientation.Horizontal"
                             Gap="0.3rem">

                    <RadzenButton Icon="edit"
                                  ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small" />

                    <RadzenButton Icon="visibility"
                                  ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small" />

                    <RadzenButton Icon="delete"
                                  ButtonStyle="ButtonStyle.Danger"
                                  Size="ButtonSize.Small" />

                </RadzenStack>

            </RadzenColumn>

        </RadzenRow>


        <!-- FILA 4 -->

        <RadzenRow Style="
            padding: 16px 10px;
            border-bottom: 1px solid #e5e7eb;
            min-width: 1050px;
            align-items: center;">

            <RadzenColumn Size="1">
                <strong>4</strong>
            </RadzenColumn>

            <RadzenColumn Size="3">
                Beca Investigación Interna
            </RadzenColumn>

            <RadzenColumn Size="2">
                15/04/2026
            </RadzenColumn>

            <RadzenColumn Size="2">
                15/10/2026
            </RadzenColumn>

            <RadzenColumn Size="1">
                30
            </RadzenColumn>

            <RadzenColumn Size="1">

                <RadzenBadge Text="Activa"
                             BadgeStyle="BadgeStyle.Primary" />

            </RadzenColumn>

            <RadzenColumn Size="2">

                <RadzenStack Orientation="Orientation.Horizontal"
                             Gap="0.3rem">

                    <RadzenButton Icon="edit"
                                  ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small" />

                    <RadzenButton Icon="visibility"
                                  ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small" />

                    <RadzenButton Icon="delete"
                                  ButtonStyle="ButtonStyle.Danger"
                                  Size="ButtonSize.Small" />

                </RadzenStack>

            </RadzenColumn>

        </RadzenRow>


        <!-- FILA 5 -->

        <RadzenRow Style="
            padding: 16px 10px;
            min-width: 1050px;
            align-items: center;">

            <RadzenColumn Size="1">
                <strong>5</strong>
            </RadzenColumn>

            <RadzenColumn Size="3">
                Beca Deportiva Nacional
            </RadzenColumn>

            <RadzenColumn Size="2">
                01/06/2025
            </RadzenColumn>

            <RadzenColumn Size="2">
                30/09/2025
            </RadzenColumn>

            <RadzenColumn Size="1">
                40
            </RadzenColumn>

            <RadzenColumn Size="1">

                <RadzenBadge Text="Cerrada"
                             BadgeStyle="BadgeStyle.Light" />

            </RadzenColumn>

            <RadzenColumn Size="2">

                <RadzenStack Orientation="Orientation.Horizontal"
                             Gap="0.3rem">

                    <RadzenButton Icon="edit"
                                  ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small" />

                    <RadzenButton Icon="visibility"
                                  ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small" />

                    <RadzenButton Icon="delete"
                                  ButtonStyle="ButtonStyle.Danger"
                                  Size="ButtonSize.Small" />

                </RadzenStack>

            </RadzenColumn>

        </RadzenRow>

    </RadzenCard>


    <!-- ====================================================== -->
    <!-- FORMULARIO - PREVISUALIZACIÓN                          -->
    <!-- ====================================================== -->

    <RadzenCard Style="
        max-width: 700px;
        width: 100%;
        margin: 1rem auto;
        border-radius: 14px;">

        <RadzenText Text="Nueva Convocatoria"
                    TextStyle="TextStyle.H5"
                    Style="
        color: #1565c0;
        font-weight: 700;
        margin-bottom: 20px;" />

        <RadzenStack Gap="1rem">

            <!-- NOMBRE -->

            <RadzenFormField Text="Nombre"
                             Style="width: 100%;">

                <RadzenTextBox TValue="string"
                               Placeholder="Nombre de la convocatoria"
                               Style="width: 100%;" />

            </RadzenFormField>


            <!-- DESCRIPCIÓN -->

            <RadzenFormField Text="Descripción"
                             Style="width: 100%;">

                <RadzenTextArea Placeholder="Descripción de la convocatoria"
                                Rows="4"
                                Style="width: 100%;" />

            </RadzenFormField>


            <!-- FECHAS -->

            <RadzenRow Gap="1rem">

                <RadzenColumn Size="12" SizeMD="6">

                    <RadzenFormField Text="Fecha inicio"
                                     Style="width: 100%;">

                        <RadzenDatePicker TValue="DateTime?"
                                          DateFormat="dd/MM/yyyy"
                                          Style="width: 100%;" />

                    </RadzenFormField>

                </RadzenColumn>


                <RadzenColumn Size="12" SizeMD="6">

                    <RadzenFormField Text="Fecha fin"
                                     Style="width: 100%;">

                        <RadzenDatePicker TValue="DateTime?"
                                          DateFormat="dd/MM/yyyy"
                                          Style="width: 100%;" />

                    </RadzenFormField>

                </RadzenColumn>

            </RadzenRow>


            <!-- CUPOS -->

            <RadzenFormField Text="Cupos"
                             Style="width: 100%;">

                <RadzenNumeric TValue="int?"
                               Min="0"
                               Step="1"
                               Placeholder="Cantidad de cupos"
                               Style="width: 100%;" />

            </RadzenFormField>


            <!-- ESTADO -->

            <RadzenFormField Text="Estado"
                             Style="width: 100%;">

                <RadzenDropDown TValue="string"
                                Data="@(new[] {
                                                    "Activa",
                                                    "Próxima",
                                                    "Cerrada"
                                                })"
                                Placeholder="Seleccione un estado"
                                Style="width: 100%;" />

            </RadzenFormField>


            <!-- BOTONES -->

            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.End"
                         Gap="0.5rem"
                         Style="margin-top: 10px;">

                <RadzenButton Text="Cancelar"
                              ButtonStyle="ButtonStyle.Light" />

                <RadzenButton Text="Guardar"
                              Icon="save"
                              ButtonStyle="ButtonStyle.Primary" />

            </RadzenStack>

        </RadzenStack>

    </RadzenCard>


    <!-- ====================================================== -->
    <!-- DETALLE - PREVISUALIZACIÓN                             -->
    <!-- ====================================================== -->

    <RadzenCard Style="
        max-width: 600px;
        width: 100%;
        margin: 1rem auto;
        border-radius: 14px;">

        <RadzenText Text="Detalle de Convocatoria"
                    TextStyle="TextStyle.H5"
                    Style="
        color: #1565c0;
        font-weight: 700;
        margin-bottom: 20px;" />

        <RadzenStack Gap="0.7rem">

            <!-- ID -->

            <RadzenText Text="Código"
                        Style="font-size:12px;color:#6b7280;" />

            <RadzenText Text="1"
                        Style="font-weight:600;" />


            <!-- NOMBRE -->

            <RadzenText Text="Nombre"
                        Style="font-size:12px;color:#6b7280;" />

            <RadzenText Text="Beca Nacional Universitaria 2026"
                        Style="font-weight:600;" />


            <!-- DESCRIPCIÓN -->

            <RadzenText Text="Descripción"
                        Style="font-size:12px;color:#6b7280;" />

            <RadzenText Text="Convocatoria dirigida a estudiantes universitarios que deseen optar a una beca para continuar sus estudios durante el año 2026."
                        Style="color:#374151;" />


            <!-- FECHA INICIO -->

            <RadzenText Text="Fecha inicio"
                        Style="font-size:12px;color:#6b7280;" />

            <RadzenText Text="01/03/2026" />


            <!-- FECHA FIN -->

            <RadzenText Text="Fecha fin"
                        Style="font-size:12px;color:#6b7280;" />

            <RadzenText Text="15/12/2026" />


            <!-- CUPOS -->

            <RadzenText Text="Cupos"
                        Style="font-size:12px;color:#6b7280;" />

            <RadzenText Text="100"
                        Style="
            font-weight:700;
            color:#1565c0;" />


            <!-- ESTADO -->

            <RadzenText Text="Estado"
                        Style="font-size:12px;color:#6b7280;" />

            <RadzenBadge Text="Activa"
                         BadgeStyle="BadgeStyle.Primary" />


            <!-- BOTÓN -->

            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.End"
                         Style="margin-top:15px;">

                <RadzenButton Text="Cerrar"
                              ButtonStyle="ButtonStyle.Light" />

            </RadzenStack>

        </RadzenStack>

    </RadzenCard>


    <!-- ====================================================== -->
    <!-- CONFIRMACIÓN - PREVISUALIZACIÓN                        -->
    <!-- ====================================================== -->

    <RadzenCard Style="
        max-width: 450px;
        width: 100%;
        margin: 1rem auto 2rem;
        border-radius: 14px;">

        <RadzenText Text="Confirmar eliminación"
                    TextStyle="TextStyle.H5"
                    Style="
        color: #1565c0;
        font-weight: 700;
        margin-bottom: 15px;" />

        <RadzenText Text="¿Desea eliminar la convocatoria?"
                    Style="color:#374151;" />

        <RadzenText Text="Beca Nacional Universitaria 2026"
                    Style="
        font-weight:600;
        margin-top:5px;" />

        <RadzenStack Orientation="Orientation.Horizontal"
                     JustifyContent="JustifyContent.End"
                     Gap="0.5rem"
                     Style="margin-top:20px;">

            <RadzenButton Text="Cancelar"
                          ButtonStyle="ButtonStyle.Light" />

            <RadzenButton Text="Eliminar"
                          Icon="delete"
                          ButtonStyle="ButtonStyle.Danger" />

        </RadzenStack>

    </RadzenCard>

</RadzenStack>
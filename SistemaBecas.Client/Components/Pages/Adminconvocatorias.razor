@page "/adminconvocatorias"

@using Radzen
@using Radzen.Blazor
@using SistemaBecas.Client.Services
@using SistemaBecas.Library.Dtos
@inject GestionApiClient Api
@inject NotificationService Notifications

<PageTitle>Administración de Convocatorias</PageTitle>

<RadzenStack Gap="1.5rem"
             Style="padding: 2rem; background-color: #f4f7fb; min-height: 100vh;">

    <!-- ====================================================== -->
    <!-- ENCABEZADO                                             -->
    <!-- ====================================================== -->

    <RadzenCard Style="
        background: linear-gradient(135deg, #1565c0, #1e88e5);
        color: white;
        border-radius: 16px;
        border: none;
        padding: 2rem;">

        <RadzenRow AlignItems="AlignItems.Center">

            <RadzenColumn Size="12" SizeMD="8">

                <RadzenText Text="Administración de Convocatorias"
                            TextStyle="TextStyle.H4"
                            Style="
                color: white;
                font-weight: 700;
                margin-bottom: 6px;" />

                <RadzenText Text="Crear, editar y gestionar convocatorias de becas"
                            Style="
                color: rgba(255,255,255,0.9);
                font-size: 15px;" />

            </RadzenColumn>

            <RadzenColumn Size="12"
                          SizeMD="4"
                          Style="text-align: right;">

                <RadzenButton Text="Nueva Convocatoria"
                              Icon="add"
                              ButtonStyle="ButtonStyle.Light"
                              Click="@AbrirNuevaConvocatoria" />

            </RadzenColumn>

        </RadzenRow>

    </RadzenCard>

    @if (mostrarFormulario)
    {
        <RadzenCard>
            <RadzenText Text="@(idConvocatoriaEditando.HasValue ? "Editar convocatoria" : "Nueva convocatoria")"
                        TextStyle="TextStyle.H6" />
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Nombre" Style="width:100%">
                        <RadzenTextBox @bind-Value="formConvocatoria.Nombre" Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Estado" Style="width:100%">
                        <RadzenDropDown @bind-Value="formConvocatoria.Estado"
                                        Data="@(new[] { "Activa", "Próxima", "Cerrada" })"
                                        Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12">
                    <RadzenFormField Text="Descripción" Style="width:100%">
                        <RadzenTextArea @bind-Value="formConvocatoria.Descripcion" Rows="3" Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Fecha de inicio" Style="width:100%">
                        <RadzenDatePicker @bind-Value="formConvocatoria.FechaInicio" DateFormat="dd/MM/yyyy" Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Fecha de fin" Style="width:100%">
                        <RadzenDatePicker @bind-Value="formConvocatoria.FechaFin" DateFormat="dd/MM/yyyy" Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Cupos" Style="width:100%">
                        <RadzenNumeric @bind-Value="formConvocatoria.Cupos" Min="0" Step="1" Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" Style="margin-top:1rem">
                <RadzenButton Text="Cancelar" ButtonStyle="ButtonStyle.Light" Click="@CancelarFormulario" />
                <RadzenButton Text="@(idConvocatoriaEditando.HasValue ? "Guardar cambios" : "Crear convocatoria")"
                              Icon="save" ButtonStyle="ButtonStyle.Primary" Click="@GuardarConvocatoriaAsync" Disabled="@guardando" />
            </RadzenStack>
        </RadzenCard>
    }

    @if (convocatoriaDetalle is not null)
    {
        <RadzenCard>
            <RadzenRow AlignItems="AlignItems.Center">
                <RadzenColumn Size="10">
                    <RadzenText Text="Detalle de convocatoria" TextStyle="TextStyle.H6" />
                </RadzenColumn>
                <RadzenColumn Size="2" Style="text-align:right">
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Click="@(() => convocatoriaDetalle = null)" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenText Text="@convocatoriaDetalle.Nombre" TextStyle="TextStyle.H5" />
            <RadzenText Text="@convocatoriaDetalle.Descripcion" />
            <RadzenText Text="@($"Fechas: {convocatoriaDetalle.FechaInicio:dd/MM/yyyy} a {convocatoriaDetalle.FechaFin:dd/MM/yyyy} · Cupos: {convocatoriaDetalle.Cupos} · Estado: {convocatoriaDetalle.Estado}")" />
        </RadzenCard>
    }

    @if (idConvocatoriaPorEliminar.HasValue)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning"
                     Text="Confirma la eliminación de la convocatoria seleccionada.">
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                <RadzenButton Text="Cancelar" ButtonStyle="ButtonStyle.Light" Click="@(() => idConvocatoriaPorEliminar = null)" />
                <RadzenButton Text="Eliminar" Icon="delete" ButtonStyle="ButtonStyle.Danger" Click="@EliminarConvocatoriaAsync" Disabled="@guardando" />
            </RadzenStack>
        </RadzenAlert>
    }


    <!-- ====================================================== -->
    <!-- ESTADÍSTICAS                                           -->
    <!-- ====================================================== -->

    <RadzenRow>

        <!-- ACTIVAS -->

        <RadzenColumn Size="12" SizeMD="4">

            <RadzenCard Style="
                border-radius: 12px;
                border: 1px solid #e5e7eb;">

                <RadzenRow AlignItems="AlignItems.Center">

                    <RadzenColumn Size="8">

                        <RadzenText Text="Activas"
                                    Style="
                        color: #6b7280;
                        font-size: 13px;" />

                        <RadzenText Text="@convocatorias.Count(c => c.Estado == "Activa").ToString()"
                                    TextStyle="TextStyle.H4"
                                    Style="
                        color: #1565c0;
                        font-weight: 700;
                        margin-top: 5px;" />

                    </RadzenColumn>

                    <RadzenColumn Size="4"
                                  Style="text-align: right;">

                        <RadzenIcon Icon="check_circle"
                                    Style="
                        font-size: 38px;
                        color: #1565c0;" />

                    </RadzenColumn>

                </RadzenRow>

            </RadzenCard>

        </RadzenColumn>


        <!-- PRÓXIMAS -->

        <RadzenColumn Size="12" SizeMD="4">

            <RadzenCard Style="
                border-radius: 12px;
                border: 1px solid #e5e7eb;">

                <RadzenRow AlignItems="AlignItems.Center">

                    <RadzenColumn Size="8">

                        <RadzenText Text="Próximas"
                                    Style="
                        color: #6b7280;
                        font-size: 13px;" />

                        <RadzenText Text="@convocatorias.Count(c => c.Estado == "Próxima").ToString()"
                                    TextStyle="TextStyle.H4"
                                    Style="
                        color: #64b5f6;
                        font-weight: 700;
                        margin-top: 5px;" />

                    </RadzenColumn>

                    <RadzenColumn Size="4"
                                  Style="text-align: right;">

                        <RadzenIcon Icon="event"
                                    Style="
                        font-size: 38px;
                        color: #64b5f6;" />

                    </RadzenColumn>

                </RadzenRow>

            </RadzenCard>

        </RadzenColumn>


        <!-- CERRADAS -->

        <RadzenColumn Size="12" SizeMD="4">

            <RadzenCard Style="
                border-radius: 12px;
                border: 1px solid #e5e7eb;">

                <RadzenRow AlignItems="AlignItems.Center">

                    <RadzenColumn Size="8">

                        <RadzenText Text="Cerradas"
                                    Style="
                        color: #6b7280;
                        font-size: 13px;" />

                        <RadzenText Text="@convocatorias.Count(c => c.Estado == "Cerrada").ToString()"
                                    TextStyle="TextStyle.H4"
                                    Style="
                        color: #94a3b8;
                        font-weight: 700;
                        margin-top: 5px;" />

                    </RadzenColumn>

                    <RadzenColumn Size="4"
                                  Style="text-align: right;">

                        <RadzenIcon Icon="lock"
                                    Style="
                        font-size: 38px;
                        color: #94a3b8;" />

                    </RadzenColumn>

                </RadzenRow>

            </RadzenCard>

        </RadzenColumn>

    </RadzenRow>


    <!-- ====================================================== -->
    <!-- FILTROS                                                -->
    <!-- ====================================================== -->

    <RadzenCard Style="
        border-radius: 12px;
        background-color: #f7fbff;
        border: 1px solid #e3edf7;">

        <RadzenText Text="Filtros de búsqueda"
                    TextStyle="TextStyle.H6"
                    Style="
        color: #1565c0;
        font-weight: 700;
        margin-bottom: 5px;" />

        <RadzenText Text="Utilice los filtros para encontrar una convocatoria."
                    Style="
        color: #6b7280;
        font-size: 13px;
        margin-bottom: 20px;" />

        <RadzenRow AlignItems="AlignItems.End">

            <!-- ESTADO -->

            <RadzenColumn Size="12" SizeMD="3">

                <RadzenFormField Text="Estado"
                                 Style="width: 100%;">

                    <RadzenDropDown TValue="string"
                                    @bind-Value="estadoSeleccionado"
                                    Data="@(new[] { "Activa", "Próxima", "Cerrada" })"
                                    Placeholder="Todos"
                                    AllowClear="true"
                                    Style="width: 100%;" />

                </RadzenFormField>

            </RadzenColumn>


            <!-- BUSCAR -->

            <RadzenColumn Size="12" SizeMD="5">

                <RadzenFormField Text="Buscar convocatoria"
                                 Style="width: 100%;">

                    <RadzenTextBox TValue="string"
                                   @bind-Value="busqueda"
                                   Placeholder="Nombre o código"
                                   Style="width: 100%;" />

                </RadzenFormField>

            </RadzenColumn>


            <!-- BOTÓN -->

            <RadzenColumn Size="12" SizeMD="2">

                <RadzenButton Text="Buscar"
                              Icon="search"
                              ButtonStyle="ButtonStyle.Primary"
                              Click="@CargarConvocatoriasAsync"
                              Style="width: 100%;" />

            </RadzenColumn>

        </RadzenRow>

    </RadzenCard>


    <!-- ====================================================== -->
    <!-- TABLA DE CONVOCATORIAS                                 -->
    <!-- ====================================================== -->

    <RadzenCard Style="
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        overflow-x: auto;">

        <RadzenText Text="Convocatorias"
                    TextStyle="TextStyle.H6"
                    Style="
        color: #1565c0;
        font-weight: 700;
        margin-bottom: 5px;" />

        <RadzenText Text="Listado de convocatorias de becas"
                    Style="
        color: #6b7280;
        font-size: 13px;
        margin-bottom: 20px;" />


        @if (!string.IsNullOrWhiteSpace(errorCarga))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Text="@errorCarga" />
        }
        @if (cargando)
        {
            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" />
        }
        <RadzenDataGrid TItem="ConvocatoriaDto"
                        Data="ConvocatoriasFiltradas"
                        AllowPaging="true"
                        PageSize="10"
                        AllowSorting="true"
                        AllowFiltering="true"
                        Responsive="true"
                        Style="width: 100%;">

            <Columns>

                <!-- CÓDIGO -->

                <RadzenDataGridColumn TItem="ConvocatoriaDto"
                                      Property="IdConvocatoria"
                                      Title="Código"
                                      Width="100px">
                </RadzenDataGridColumn>


                <!-- NOMBRE -->

                <RadzenDataGridColumn TItem="ConvocatoriaDto"
                                      Property="Nombre"
                                      Title="Nombre"
                                      Width="250px">
                </RadzenDataGridColumn>


                <!-- FECHA INICIO -->

                <RadzenDataGridColumn TItem="ConvocatoriaDto"
                                      Property="FechaInicio"
                                      Title="Fecha inicio"
                                      Width="140px">
                    <Template Context="item">@item.FechaInicio.ToString("dd/MM/yyyy")</Template>
                </RadzenDataGridColumn>


                <!-- FECHA FIN -->

                <RadzenDataGridColumn TItem="ConvocatoriaDto"
                                      Property="FechaFin"
                                      Title="Fecha fin"
                                      Width="140px">
                    <Template Context="item">@item.FechaFin.ToString("dd/MM/yyyy")</Template>
                </RadzenDataGridColumn>


                <!-- CUPOS -->

                <RadzenDataGridColumn TItem="ConvocatoriaDto"
                                      Property="Cupos"
                                      Title="Cupos"
                                      Width="100px">
                </RadzenDataGridColumn>


                <!-- ESTADO -->

                <RadzenDataGridColumn TItem="ConvocatoriaDto"
                                      Title="Estado"
                                      Width="130px">

                    <Template Context="convocatoria">

                        <RadzenBadge Text="@convocatoria.Estado"
                                     BadgeStyle="BadgeStyle.Primary" />

                    </Template>

                </RadzenDataGridColumn>


                <!-- ACCIONES -->

                <RadzenDataGridColumn TItem="ConvocatoriaDto"
                                      Title="Acciones"
                                      Width="170px">

                    <Template Context="convocatoria">

                        <RadzenStack Orientation="Orientation.Horizontal"
                                     Gap="0.3rem">

                            <RadzenButton Icon="edit"
                                          ButtonStyle="ButtonStyle.Light"
                                          Size="ButtonSize.Small"
                                          Click="@(() => EditarConvocatoria(convocatoria.IdConvocatoria))" />

                            <RadzenButton Icon="visibility"
                                          ButtonStyle="ButtonStyle.Light"
                                          Size="ButtonSize.Small"
                                          Click="@(() => VerConvocatoria(convocatoria.IdConvocatoria))" />

                            <RadzenButton Icon="delete"
                                          ButtonStyle="ButtonStyle.Danger"
                                          Size="ButtonSize.Small"
                                          Click="@(() => ConfirmarEliminacion(convocatoria.IdConvocatoria))" />

                        </RadzenStack>

                    </Template>

                </RadzenDataGridColumn>

            </Columns>

        </RadzenDataGrid>

    </RadzenCard>

</RadzenStack>


@code {

    private List<ConvocatoriaDto> convocatorias = new();
    private string? estadoSeleccionado;
    private string busqueda = string.Empty;
    private string? errorCarga;
    private bool cargando;
    private bool guardando;
    private bool mostrarFormulario;
    private int? idConvocatoriaEditando;
    private int? idConvocatoriaPorEliminar;
    private ConvocatoriaDto? convocatoriaDetalle;
    private ConvocatoriaGuardarDto formConvocatoria = new() { Estado = "Próxima", FechaInicio = DateTime.Today, FechaFin = DateTime.Today.AddMonths(1) };
    private IEnumerable<ConvocatoriaDto> ConvocatoriasFiltradas => convocatorias.Where(c =>
        (string.IsNullOrWhiteSpace(estadoSeleccionado) || c.Estado.Equals(estadoSeleccionado, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(busqueda) ||
         c.Nombre.Contains(busqueda.Trim(), StringComparison.OrdinalIgnoreCase) ||
         c.IdConvocatoria.ToString().Contains(busqueda.Trim(), StringComparison.OrdinalIgnoreCase)));

    protected override Task OnInitializedAsync() => CargarConvocatoriasAsync();

    private async Task CargarConvocatoriasAsync()
    {
        cargando = true;
        errorCarga = null;
        try
        {
            convocatorias = await Api.ObtenerConvocatoriasAsync();
        }
        catch (Exception ex)
        {
            errorCarga = $"No se pudieron cargar las convocatorias: {ex.Message}";
            Notifications.Notify(NotificationSeverity.Error, "Error al cargar convocatorias", ex.Message);
        }
        finally
        {
            cargando = false;
        }
    }


    private void AbrirNuevaConvocatoria()
    {
        idConvocatoriaEditando = null;
        convocatoriaDetalle = null;
        formConvocatoria = new ConvocatoriaGuardarDto { Estado = "Próxima", FechaInicio = DateTime.Today, FechaFin = DateTime.Today.AddMonths(1) };
        mostrarFormulario = true;
    }


    private async Task VerConvocatoria(int id)
    {
        try
        {
            convocatoriaDetalle = await Api.ObtenerConvocatoriaAsync(id);
            if (convocatoriaDetalle is null)
                Notifications.Notify(NotificationSeverity.Warning, "Convocatoria no encontrada", "Actualiza la lista e inténtalo de nuevo.");
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error, "No se pudo cargar el detalle", ex.Message);
        }
    }


    private void ConfirmarEliminacion(int id)
    {
        idConvocatoriaPorEliminar = id;
    }


    private async Task EditarConvocatoria(int id)
    {
        try
        {
            var convocatoria = await Api.ObtenerConvocatoriaAsync(id);
            if (convocatoria is null)
            {
                Notifications.Notify(NotificationSeverity.Warning, "Convocatoria no encontrada", "Actualiza la lista e inténtalo de nuevo.");
                return;
            }
            idConvocatoriaEditando = id;
            convocatoriaDetalle = null;
            formConvocatoria = new ConvocatoriaGuardarDto
            {
                Nombre = convocatoria.Nombre,
                Descripcion = convocatoria.Descripcion,
                FechaInicio = convocatoria.FechaInicio,
                FechaFin = convocatoria.FechaFin,
                Cupos = convocatoria.Cupos,
                Estado = convocatoria.Estado
            };
            mostrarFormulario = true;
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error, "No se pudo cargar la convocatoria", ex.Message);
        }
    }

    private void CancelarFormulario()
    {
        mostrarFormulario = false;
        idConvocatoriaEditando = null;
    }

    private async Task GuardarConvocatoriaAsync()
    {
        if (string.IsNullOrWhiteSpace(formConvocatoria.Nombre) || formConvocatoria.FechaFin < formConvocatoria.FechaInicio || formConvocatoria.Cupos < 0)
        {
            Notifications.Notify(NotificationSeverity.Warning, "Revisa los datos", "Completa el nombre y verifica las fechas y los cupos.");
            return;
        }

        guardando = true;
        try
        {
            if (idConvocatoriaEditando.HasValue)
            {
                await Api.ActualizarConvocatoriaAsync(idConvocatoriaEditando.Value, formConvocatoria);
                Notifications.Notify(NotificationSeverity.Success, "Convocatoria actualizada", "Los cambios se guardaron correctamente.");
            }
            else
            {
                await Api.GuardarConvocatoriaAsync(formConvocatoria);
                Notifications.Notify(NotificationSeverity.Success, "Convocatoria creada", "Se guardó correctamente.");
            }
            CancelarFormulario();
            await CargarConvocatoriasAsync();
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error, "No se pudo guardar la convocatoria", ex.Message);
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task EliminarConvocatoriaAsync()
    {
        if (!idConvocatoriaPorEliminar.HasValue) return;

        guardando = true;
        try
        {
            await Api.EliminarConvocatoriaAsync(idConvocatoriaPorEliminar.Value);
            idConvocatoriaPorEliminar = null;
            Notifications.Notify(NotificationSeverity.Success, "Convocatoria eliminada", "Se eliminó correctamente.");
            await CargarConvocatoriasAsync();
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error, "No se pudo eliminar la convocatoria", ex.Message);
        }
        finally
        {
            guardando = false;
        }
    }

}

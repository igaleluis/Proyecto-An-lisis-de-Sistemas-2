@page "/adminconvocatorias"

@using Radzen
@using Radzen.Blazor
@using Modals
@inject DialogService DialogService

<PageTitle>Administración de Convocatorias</PageTitle>

<RadzenStack Gap="1.5rem"
             Style="padding: 2rem; background-color: #f4f7fb; min-height: 100vh;">

    <!-- ====================================================== -->
    <!-- ENCABEZADO                                             -->
    <!-- ====================================================== -->

    <RadzenCard Style="
        background: linear-gradient(135deg, #1565c0, #1e88e5);
        color: white;
        border-radius: 16px;
        border: none;
        padding: 2rem;">

        <RadzenRow AlignItems="AlignItems.Center">

            <RadzenColumn Size="12" SizeMD="8">

                <RadzenText Text="Administración de Convocatorias"
                            TextStyle="TextStyle.H4"
                            Style="
                color: white;
                font-weight: 700;
                margin-bottom: 6px;" />

                <RadzenText Text="Crear, editar y gestionar convocatorias de becas"
                            Style="
                color: rgba(255,255,255,0.9);
                font-size: 15px;" />

            </RadzenColumn>

            <RadzenColumn Size="12"
                          SizeMD="4"
                          Style="text-align: right;">

                <RadzenButton Text="Nueva Convocatoria"
                              Icon="add"
                              ButtonStyle="ButtonStyle.Light"
                              Click="@AbrirNuevaConvocatoria" />

            </RadzenColumn>

        </RadzenRow>

    </RadzenCard>


    <!-- ====================================================== -->
    <!-- ESTADÍSTICAS                                           -->
    <!-- ====================================================== -->

    <RadzenRow>

        <!-- ACTIVAS -->

        <RadzenColumn Size="12" SizeMD="4">

            <RadzenCard Style="
                border-radius: 12px;
                border: 1px solid #e5e7eb;">

                <RadzenRow AlignItems="AlignItems.Center">

                    <RadzenColumn Size="8">

                        <RadzenText Text="Activas"
                                    Style="
                        color: #6b7280;
                        font-size: 13px;" />

                        <RadzenText Text=""
                                    TextStyle="TextStyle.H4"
                                    Style="
                        color: #1565c0;
                        font-weight: 700;
                        margin-top: 5px;" />

                    </RadzenColumn>

                    <RadzenColumn Size="4"
                                  Style="text-align: right;">

                        <RadzenIcon Icon="check_circle"
                                    Style="
                        font-size: 38px;
                        color: #1565c0;" />

                    </RadzenColumn>

                </RadzenRow>

            </RadzenCard>

        </RadzenColumn>


        <!-- PRÓXIMAS -->

        <RadzenColumn Size="12" SizeMD="4">

            <RadzenCard Style="
                border-radius: 12px;
                border: 1px solid #e5e7eb;">

                <RadzenRow AlignItems="AlignItems.Center">

                    <RadzenColumn Size="8">

                        <RadzenText Text="Próximas"
                                    Style="
                        color: #6b7280;
                        font-size: 13px;" />

                        <RadzenText Text=""
                                    TextStyle="TextStyle.H4"
                                    Style="
                        color: #64b5f6;
                        font-weight: 700;
                        margin-top: 5px;" />

                    </RadzenColumn>

                    <RadzenColumn Size="4"
                                  Style="text-align: right;">

                        <RadzenIcon Icon="event"
                                    Style="
                        font-size: 38px;
                        color: #64b5f6;" />

                    </RadzenColumn>

                </RadzenRow>

            </RadzenCard>

        </RadzenColumn>


        <!-- CERRADAS -->

        <RadzenColumn Size="12" SizeMD="4">

            <RadzenCard Style="
                border-radius: 12px;
                border: 1px solid #e5e7eb;">

                <RadzenRow AlignItems="AlignItems.Center">

                    <RadzenColumn Size="8">

                        <RadzenText Text="Cerradas"
                                    Style="
                        color: #6b7280;
                        font-size: 13px;" />

                        <RadzenText Text=""
                                    TextStyle="TextStyle.H4"
                                    Style="
                        color: #94a3b8;
                        font-weight: 700;
                        margin-top: 5px;" />

                    </RadzenColumn>

                    <RadzenColumn Size="4"
                                  Style="text-align: right;">

                        <RadzenIcon Icon="lock"
                                    Style="
                        font-size: 38px;
                        color: #94a3b8;" />

                    </RadzenColumn>

                </RadzenRow>

            </RadzenCard>

        </RadzenColumn>

    </RadzenRow>


    <!-- ====================================================== -->
    <!-- FILTROS                                                -->
    <!-- ====================================================== -->

    <RadzenCard Style="
        border-radius: 12px;
        background-color: #f7fbff;
        border: 1px solid #e3edf7;">

        <RadzenText Text="Filtros de búsqueda"
                    TextStyle="TextStyle.H6"
                    Style="
        color: #1565c0;
        font-weight: 700;
        margin-bottom: 5px;" />

        <RadzenText Text="Utilice los filtros para encontrar una convocatoria."
                    Style="
        color: #6b7280;
        font-size: 13px;
        margin-bottom: 20px;" />

        <RadzenRow AlignItems="AlignItems.End">

            <!-- ESTADO -->

            <RadzenColumn Size="12" SizeMD="3">

                <RadzenFormField Text="Estado"
                                 Style="width: 100%;">

                    <RadzenDropDown TValue="string"
                                    Data="@(new[] { "Activa", "Próxima", "Cerrada" })"
                                    Placeholder="Todos"
                                    AllowClear="true"
                                    Style="width: 100%;" />

                </RadzenFormField>

            </RadzenColumn>


            <!-- BUSCAR -->

            <RadzenColumn Size="12" SizeMD="5">

                <RadzenFormField Text="Buscar convocatoria"
                                 Style="width: 100%;">

                    <RadzenTextBox TValue="string"
                                   Placeholder="Nombre o código"
                                   Style="width: 100%;" />

                </RadzenFormField>

            </RadzenColumn>


            <!-- BOTÓN -->

            <RadzenColumn Size="12" SizeMD="2">

                <RadzenButton Text="Buscar"
                              Icon="search"
                              ButtonStyle="ButtonStyle.Primary"
                              Style="width: 100%;" />

            </RadzenColumn>

        </RadzenRow>

    </RadzenCard>


    <!-- ====================================================== -->
    <!-- TABLA DE CONVOCATORIAS                                 -->
    <!-- ====================================================== -->

    <RadzenCard Style="
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        overflow-x: auto;">

        <RadzenText Text="Convocatorias"
                    TextStyle="TextStyle.H6"
                    Style="
        color: #1565c0;
        font-weight: 700;
        margin-bottom: 5px;" />

        <RadzenText Text="Listado de convocatorias de becas"
                    Style="
        color: #6b7280;
        font-size: 13px;
        margin-bottom: 20px;" />


        <RadzenDataGrid TItem="object"
                        Data="@convocatorias"
                        AllowPaging="true"
                        PageSize="10"
                        AllowSorting="true"
                        AllowFiltering="true"
                        Responsive="true"
                        Style="width: 100%;">

            <Columns>

                <!-- CÓDIGO -->

                <RadzenDataGridColumn TItem="object"
                                      Title="Código"
                                      Width="100px">
                </RadzenDataGridColumn>


                <!-- NOMBRE -->

                <RadzenDataGridColumn TItem="object"
                                      Title="Nombre"
                                      Width="250px">
                </RadzenDataGridColumn>


                <!-- FECHA INICIO -->

                <RadzenDataGridColumn TItem="object"
                                      Title="Fecha inicio"
                                      Width="140px">
                </RadzenDataGridColumn>


                <!-- FECHA FIN -->

                <RadzenDataGridColumn TItem="object"
                                      Title="Fecha fin"
                                      Width="140px">
                </RadzenDataGridColumn>


                <!-- CUPOS -->

                <RadzenDataGridColumn TItem="object"
                                      Title="Cupos"
                                      Width="100px">
                </RadzenDataGridColumn>


                <!-- ESTADO -->

                <RadzenDataGridColumn TItem="object"
                                      Title="Estado"
                                      Width="130px">

                    <Template Context="convocatoria">

                        <RadzenBadge Text=""
                                     BadgeStyle="BadgeStyle.Primary" />

                    </Template>

                </RadzenDataGridColumn>


                <!-- ACCIONES -->

                <RadzenDataGridColumn TItem="object"
                                      Title="Acciones"
                                      Width="170px">

                    <Template Context="convocatoria">

                        <RadzenStack Orientation="Orientation.Horizontal"
                                     Gap="0.3rem">

                            <RadzenButton Icon="edit"
                                          ButtonStyle="ButtonStyle.Light"
                                          Size="ButtonSize.Small" />

                            <RadzenButton Icon="visibility"
                                          ButtonStyle="ButtonStyle.Light"
                                          Size="ButtonSize.Small" />

                            <RadzenButton Icon="delete"
                                          ButtonStyle="ButtonStyle.Danger"
                                          Size="ButtonSize.Small" />

                        </RadzenStack>

                    </Template>

                </RadzenDataGridColumn>

            </Columns>

        </RadzenDataGrid>

    </RadzenCard>

</RadzenStack>


@code {

    private List<object> convocatorias = new();


    async Task AbrirNuevaConvocatoria()
    {
        var result = await DialogService.OpenAsync<NuevaConvocatoriaDialog>(
            "Nueva Convocatoria",
            null,
            new DialogOptions
            {
                Width = "700px",
                Resizable = true,
                Draggable = true
            });

        if (result == true)
        {
            // Aquí después puedes recargar las convocatorias
        }
    }


    async Task VerConvocatoria(int id)
    {
        await DialogService.OpenAsync<DetalleConvocatoriaDialog>(
            "Detalle de Convocatoria",
            new Dictionary<string, object>
            {
                { "Id", id }
            },
            new DialogOptions
            {
                Width = "600px",
                Draggable = true
            });
    }


    async Task ConfirmarEliminacion(int id)
    {
        var result = await DialogService.OpenAsync<ConfirmarEliminacionDialog>(
            "Confirmar eliminación",
            new Dictionary<string, object>
            {
                { "Id", id }
            },
            new DialogOptions
            {
                Width = "450px",
                Draggable = true
            });

        if (result == true)
        {
            // Aquí posteriormente llamas al API para eliminar
        }
    }


    async Task EditarConvocatoria(int id)
    {
        var result = await DialogService.OpenAsync<EditarConvocatoriaDialog>(
            "Editar Convocatoria",
            new Dictionary<string, object>
            {
                { "Id", id }
            },
            new DialogOptions
            {
                Width = "700px",
                Resizable = true,
                Draggable = true
            });

        if (result == true)
        {
            // Aquí posteriormente recargas la tabla
        }
    }

}
@code {

    // --- Estado de filtros ---
    string? estadoFiltro;
    string? tipoFiltro;
    string? busqueda;

    readonly string[] estados = { "Activa", "Próxima", "Cerrada" };
    readonly string[] tipos = { "Nacional", "Internacional", "Internos" };

    // --- Estado de modales ---
    bool mostrarFormulario;
    bool mostrarDetalle;
    bool mostrarConfirmarEliminar;
    bool esNuevaConvocatoria;
    string? mensajeError;

    ConvocatoriaDemo? convocatoriaForm;
    ConvocatoriaDemo? convocatoriaDetalle;
    ConvocatoriaDemo? convocatoriaAEliminar;

    // --- Datos demo ---
    List<ConvocatoriaDemo> convocatorias = new()
    {
        new ConvocatoriaDemo { IdConvocatoria = 1, Codigo = "CONV-2026-001", Nombre = "Beca Nacional Universitaria 2026", Tipo = "Nacional", FechaInicio = new(2026,3,1),   FechaFin = new(2026,12,15), Monto = 15000, Estado = "Activa" },
        new ConvocatoriaDemo { IdConvocatoria = 2, Codigo = "CONV-2026-002", Nombre = "Beca Internacional Posgrado",        Tipo = "Internacional", FechaInicio = new(2026,11,1),  FechaFin = new(2027,3,31),  Monto = 45000, Estado = "Próxima" },
        new ConvocatoriaDemo { IdConvocatoria = 3, Codigo = "CONV-2025-015", Nombre = "Beca Técnica Media",                Tipo = "Nacional", FechaInicio = new(2025,9,1),   FechaFin = new(2025,12,15), Monto = 8000,  Estado = "Cerrada" },
        new ConvocatoriaDemo { IdConvocatoria = 4, Codigo = "CONV-2026-003", Nombre = "Beca Investigación Interna",       Tipo = "Internos", FechaInicio = new(2026,4,15),  FechaFin = new(2026,10,15), Monto = 12000, Estado = "Activa" },
        new ConvocatoriaDemo { IdConvocatoria = 5, Codigo = "CONV-2025-018", Nombre = "Beca Deportiva Nacional",          Tipo = "Nacional", FechaInicio = new(2025,6,1),   FechaFin = new(2025,9,30),  Monto = 10000, Estado = "Cerrada" },
    };

    List<ConvocatoriaDemo> convocatoriasFiltradas = new();

    protected override void OnInitialized()
    {
        convocatoriasFiltradas = new List<ConvocatoriaDemo>(convocatorias);
    }

    // --- Filtro ---
    void Buscar()
    {
        convocatoriasFiltradas = convocatorias.Where(c =>
            (string.IsNullOrWhiteSpace(estadoFiltro) || c.Estado == estadoFiltro) &&
            (string.IsNullOrWhiteSpace(tipoFiltro) || c.Tipo == tipoFiltro) &&
            (string.IsNullOrWhiteSpace(busqueda) || c.Nombre.Contains(busqueda, StringComparison.OrdinalIgnoreCase)
                                                       || c.Codigo.Contains(busqueda, StringComparison.OrdinalIgnoreCase))
        ).ToList();
    }

    // --- Formulario (crear / editar) ---
    void AbrirFormulario(ConvocatoriaDemo? conv)
    {
        esNuevaConvocatoria = conv is null;
        mensajeError = null;

        convocatoriaForm = esNuevaConvocatoria
            ? new ConvocatoriaDemo { Tipo = tipos[0], FechaInicio = DateTime.Today, FechaFin = DateTime.Today }
            : new ConvocatoriaDemo
            {
                IdConvocatoria = conv!.IdConvocatoria,
                Codigo = conv.Codigo,
                Nombre = conv.Nombre,
                Tipo = conv.Tipo,
                FechaInicio = conv.FechaInicio,
                FechaFin = conv.FechaFin,
                Monto = conv.Monto,
                Estado = conv.Estado
            };

        mostrarFormulario = true;
    }

    void CerrarFormulario()
    {
        mostrarFormulario = false;
        convocatoriaForm = null;
        mensajeError = null;
    }

    void GuardarFormulario()
    {
        if (convocatoriaForm is null) return;

        if (string.IsNullOrWhiteSpace(convocatoriaForm.Nombre))
        {
            mensajeError = "El nombre es obligatorio.";
            return;
        }

        if (convocatoriaForm.FechaFin.Date < convocatoriaForm.FechaInicio.Date)
        {
            mensajeError = "La fecha de fin no puede ser anterior a la fecha de inicio.";
            return;
        }

        if (convocatoriaForm.Monto < 0)
        {
            mensajeError = "El monto no puede ser negativo.";
            return;
        }

        if (esNuevaConvocatoria)
        {
            int nuevoId = convocatorias.Count == 0 ? 1 : convocatorias.Max(x => x.IdConvocatoria) + 1;
            convocatoriaForm.IdConvocatoria = nuevoId;
            convocatoriaForm.Codigo = $"CONV-{DateTime.Today.Year}-{nuevoId:000}";
            convocatoriaForm.Estado = DeterminarEstado(convocatoriaForm);
            convocatorias.Add(convocatoriaForm);
        }
        else
        {
            var original = convocatorias.First(x => x.IdConvocatoria == convocatoriaForm.IdConvocatoria);
            original.Nombre = convocatoriaForm.Nombre;
            original.Tipo = convocatoriaForm.Tipo;
            original.FechaInicio = convocatoriaForm.FechaInicio;
            original.FechaFin = convocatoriaForm.FechaFin;
            original.Monto = convocatoriaForm.Monto;
            original.Estado = DeterminarEstado(original);
        }

        Buscar();
        CerrarFormulario();
    }

    string DeterminarEstado(ConvocatoriaDemo c)
    {
        var hoy = DateTime.Today;
        if (hoy < c.FechaInicio.Date) return "Próxima";
        if (hoy > c.FechaFin.Date) return "Cerrada";
        return "Activa";
    }

    // --- Detalle ---
    void VerDetalle(ConvocatoriaDemo conv)
    {
        convocatoriaDetalle = conv;
        mostrarDetalle = true;
    }

    // --- Eliminar ---
    void PedirEliminar(ConvocatoriaDemo conv)
    {
        convocatoriaAEliminar = conv;
        mostrarConfirmarEliminar = true;
    }

    void ConfirmarEliminar()
    {
        if (convocatoriaAEliminar is not null)
        {
            convocatorias.Remove(convocatoriaAEliminar);
            Buscar();
        }

        mostrarConfirmarEliminar = false;
        convocatoriaAEliminar = null;
    }

    // --- Modelo demo ---
    public class ConvocatoriaDemo
    {
        public int IdConvocatoria { get; set; }
        public string Codigo { get; set; } = "";
        public string Nombre { get; set; } = "";
        public string Tipo { get; set; } = "";
        public DateTime FechaInicio { get; set; }
        public DateTime FechaFin { get; set; }
        public decimal Monto { get; set; }
        public string Estado { get; set; } = "";
    }

}

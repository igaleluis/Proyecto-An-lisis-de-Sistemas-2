@page "/gestionar-comites-evaluadores"

@using Radzen
@using Radzen.Blazor

<PageTitle>Gestionar Comités Evaluadores</PageTitle>

<RadzenStack Gap="1.5rem"
             Style="padding: 2rem; background-color: #f4f7fb; min-height: 100vh;">

    <!-- ====================================================== -->
    <!-- ENCABEZADO                                             -->
    <!-- ====================================================== -->

    <RadzenCard Style="background: linear-gradient(135deg, #1565c0, #1976d2); color: white;">

        <RadzenStack Gap="0.5rem">

            <RadzenText Text="Gestión de comités evaluadores"
                        TextStyle="TextStyle.H3"
                        Style="color: white; margin: 0;" />

            <RadzenText Text="Administre los comités evaluadores de la plataforma"
                        Style="color: white; margin: 0;" />

        </RadzenStack>

    </RadzenCard>


    <!-- ====================================================== -->
    <!-- REGISTRAR COMITÉ                                       -->
    <!-- ====================================================== -->

    <RadzenCard>

        <RadzenStack Gap="1.5rem">

            <RadzenStack Gap="0.5rem">

                <RadzenText Text="Registrar comité"
                            TextStyle="TextStyle.H5"
                            Style="margin: 0;" />

                <RadzenText Text="Ingrese la información del nuevo comité evaluador."
                            Style="margin: 0; color: #666;" />

            </RadzenStack>


            <!-- DATOS DEL COMITÉ -->

            <RadzenRow Gap="1rem">

                <!-- NOMBRE -->

                <RadzenColumn Size="12"
                              SizeMD="6">

                    <RadzenFormField Text="Nombre del comité"
                                     Variant="Variant.Outlined"
                                     Style="width: 100%;">

                        <RadzenTextBox @bind-Value="nombreComite"
                                       Placeholder="Ingrese el nombre del comité"
                                       Style="width: 100%;" />

                    </RadzenFormField>

                </RadzenColumn>


                <!-- FECHA -->

                <RadzenColumn Size="12"
                              SizeMD="6">

                    <RadzenFormField Text="Fecha"
                                     Variant="Variant.Outlined"
                                     Style="width: 100%;">

                        <RadzenDatePicker @bind-Value="fechaComite"
                                          DateFormat="dd/MM/yyyy"
                                          Style="width: 100%;" />

                    </RadzenFormField>

                </RadzenColumn>


                <!-- DESCRIPCIÓN -->

                <RadzenColumn Size="12">

                    <RadzenFormField Text="Descripción"
                                     Variant="Variant.Outlined"
                                     Style="width: 100%;">

                        <RadzenTextArea @bind-Value="descripcionComite"
                                        Placeholder="Ingrese la descripción del comité"
                                        Rows="4"
                                        Style="width: 100%;" />

                    </RadzenFormField>

                </RadzenColumn>

            </RadzenRow>


            <!-- ====================================================== -->
            <!-- EVALUADORES                                             -->
            <!-- ====================================================== -->

            <RadzenCard Variant="Variant.Outlined">

                <RadzenStack Gap="1rem">

                    <RadzenText Text="Asignar evaluadores"
                                TextStyle="TextStyle.H6"
                                Style="margin: 0;" />

                    <RadzenText Text="Seleccione los evaluadores que formarán parte del comité."
                                Style="margin: 0; color: #666;" />


                    <RadzenStack Gap="0.8rem">

                        @foreach (var evaluador in evaluadores)
                        {
                            <RadzenCard Variant="Variant.Outlined">

                                <RadzenStack Orientation="Orientation.Horizontal"
                                             Gap="1rem"
                                             AlignItems="AlignItems.Center">

                                    <RadzenCheckBox @bind-Value="evaluador.Seleccionado" />

                                    <RadzenStack Gap="0.2rem">

                                        <RadzenText Text="@evaluador.Nombre"
                                                    TextStyle="TextStyle.Body1"
                                                    Style="font-weight: 600; margin: 0;" />

                                        <RadzenText Text="@evaluador.Cargo"
                                                    Style="margin: 0; color: #666;" />

                                    </RadzenStack>

                                </RadzenStack>

                            </RadzenCard>
                        }

                    </RadzenStack>

                </RadzenStack>

            </RadzenCard>


            <!-- ====================================================== -->
            <!-- BOTONES                                                 -->
            <!-- ====================================================== -->

            <RadzenStack Orientation="Orientation.Horizontal"
                         Gap="1rem"
                         JustifyContent="JustifyContent.End">

                <RadzenButton Text="Cancelar"
                              Icon="close"
                              ButtonStyle="ButtonStyle.Light"
                              Click="@Cancelar" />

                <RadzenButton Text="Guardar comité"
                              Icon="save"
                              ButtonStyle="ButtonStyle.Primary"
                              Click="@GuardarComite" />

            </RadzenStack>

        </RadzenStack>

    </RadzenCard>


    <!-- ====================================================== -->
    <!-- COMITÉS REGISTRADOS                                    -->
    <!-- ====================================================== -->

    <RadzenCard>

        <RadzenStack Gap="1.5rem">

            <RadzenStack Gap="0.5rem">

                <RadzenText Text="Comités registrados"
                            TextStyle="TextStyle.H5"
                            Style="margin: 0;" />

                <RadzenText Text="Consulte y administre los comités evaluadores registrados."
                            Style="margin: 0; color: #666;" />

            </RadzenStack>


            <RadzenDataGrid Data="@comites"
                            TItem="ComiteMock"
                            AllowPaging="true"
                            PageSize="5"
                            AllowSorting="true"
                            AllowFiltering="true"
                            Responsive="true"
                            EmptyText="No hay comités registrados">

                <Columns>

                    <!-- ID -->

                    <RadzenDataGridColumn TItem="ComiteMock"
                                          Property="IdComite"
                                          Title="ID"
                                          Width="80px">

                        <Template Context="comite">

                            @comite.IdComite.ToString("D3")

                        </Template>

                    </RadzenDataGridColumn>


                    <!-- NOMBRE -->

                    <RadzenDataGridColumn TItem="ComiteMock"
                                          Property="Nombre"
                                          Title="Nombre del comité" />


                    <!-- FECHA -->

                    <RadzenDataGridColumn TItem="ComiteMock"
                                          Property="Fecha"
                                          Title="Fecha">

                        <Template Context="comite">

                            @comite.Fecha.ToString("dd/MM/yyyy")

                        </Template>

                    </RadzenDataGridColumn>


                    <!-- EVALUADORES -->

                    <RadzenDataGridColumn TItem="ComiteMock"
                                          Title="Evaluadores">

                        <Template Context="comite">

                            @comite.Evaluadores.Count

                        </Template>

                    </RadzenDataGridColumn>


                    <!-- ESTADO -->

                    <RadzenDataGridColumn TItem="ComiteMock"
                                          Property="Estado"
                                          Title="Estado">

                        <Template Context="comite">

                            <RadzenBadge Text="@comite.Estado"
                                         BadgeStyle="@ObtenerBadgeEstado(comite.Estado)" />

                        </Template>

                    </RadzenDataGridColumn>


                    <!-- ACCIONES -->

                    <RadzenDataGridColumn TItem="ComiteMock"
                                          Title="Acciones"
                                          Sortable="false"
                                          Filterable="false"
                                          Width="180px">

                        <Template Context="comite">

                            <RadzenStack Orientation="Orientation.Horizontal"
                                         Gap="0.5rem">

                                <RadzenButton Icon="edit"
                                              Text="Editar"
                                              ButtonStyle="ButtonStyle.Light"
                                              Size="ButtonSize.Small"
                                              Click="@(() => EditarComite(comite))" />

                                <RadzenButton Icon="visibility"
                                              Text="Ver"
                                              ButtonStyle="ButtonStyle.Secondary"
                                              Size="ButtonSize.Small"
                                              Click="@(() => VerComite(comite))" />

                            </RadzenStack>

                        </Template>

                    </RadzenDataGridColumn>

                </Columns>

            </RadzenDataGrid>

        </RadzenStack>

    </RadzenCard>

</RadzenStack>


@code {

    // ============================================================
    // DATOS DEL COMITÉ
    // ============================================================

    private string nombreComite = "";

    private DateTime? fechaComite = DateTime.Today;

    private string descripcionComite = "";


    // ============================================================
    // EVALUADORES MOCK
    // Corresponden a la tabla Evaluador
    // ============================================================

    private List<EvaluadorMock> evaluadores = new()
    {
        new EvaluadorMock
        {
            IdEvaluador = 1,
            IdUsuario = 1,
            Nombre = "Juan Pérez López",
            Cargo = "Analista académico"
        },

        new EvaluadorMock
        {
            IdEvaluador = 2,
            IdUsuario = 2,
            Nombre = "María García López",
            Cargo = "Coordinadora"
        },

        new EvaluadorMock
        {
            IdEvaluador = 3,
            IdUsuario = 3,
            Nombre = "Carlos Hernández",
            Cargo = "Supervisor"
        }
    };


    // ============================================================
    // COMITÉS MOCK
    // ============================================================

    private List<ComiteMock> comites = new()
    {
        new ComiteMock
        {
            IdComite = 1,
            Nombre = "Comité de Becas 2026",
            Fecha = new DateTime(2026, 9, 15),
            Descripcion = "Comité encargado de evaluar las solicitudes de becas universitarias.",
            Estado = "Activo",
            Evaluadores = new List<int> { 1, 2, 3 }
        },

        new ComiteMock
        {
            IdComite = 2,
            Nombre = "Comité de Evaluación General",
            Fecha = new DateTime(2026, 9, 20),
            Descripcion = "Comité encargado de realizar evaluaciones generales de solicitudes.",
            Estado = "Activo",
            Evaluadores = new List<int> { 1, 2 }
        }
    };


    // ============================================================
    // GUARDAR
    // ============================================================

    private void GuardarComite()
    {
        if (string.IsNullOrWhiteSpace(nombreComite))
            return;


        var evaluadoresSeleccionados = evaluadores
            .Where(e => e.Seleccionado)
            .Select(e => e.IdEvaluador)
            .ToList();


        comites.Add(new ComiteMock
        {
            IdComite = comites.Count + 1,

            Nombre = nombreComite,

            Fecha = fechaComite ?? DateTime.Today,

            Descripcion = descripcionComite,

            Estado = "Activo",

            Evaluadores = evaluadoresSeleccionados
        });


        LimpiarFormulario();
    }


    // ============================================================
    // CANCELAR
    // ============================================================

    private void Cancelar()
    {
        LimpiarFormulario();
    }


    // ============================================================
    // LIMPIAR
    // ============================================================

    private void LimpiarFormulario()
    {
        nombreComite = "";

        descripcionComite = "";

        fechaComite = DateTime.Today;

        foreach (var evaluador in evaluadores)
        {
            evaluador.Seleccionado = false;
        }
    }


    // ============================================================
    // EDITAR
    // ============================================================

    private void EditarComite(ComiteMock comite)
    {
        nombreComite = comite.Nombre;

        fechaComite = comite.Fecha;

        descripcionComite = comite.Descripcion;


        foreach (var evaluador in evaluadores)
        {
            evaluador.Seleccionado =
                comite.Evaluadores.Contains(evaluador.IdEvaluador);
        }
    }


    // ============================================================
    // VER
    // ============================================================

    private void VerComite(ComiteMock comite)
    {
        // Próximamente se mostrará el detalle del comité.
    }


    // ============================================================
    // BADGE ESTADO
    // ============================================================

    private BadgeStyle ObtenerBadgeEstado(string estado)
    {
        return estado switch
        {
            "Activo" => BadgeStyle.Success,
            "Inactivo" => BadgeStyle.Light,
            "Finalizado" => BadgeStyle.Info,
            _ => BadgeStyle.Light
        };
    }


    // ============================================================
    // EVALUADOR
    // ============================================================

    public class EvaluadorMock
    {
        public int IdEvaluador { get; set; }

        public int IdUsuario { get; set; }

        public string Nombre { get; set; } = "";

        public string Cargo { get; set; } = "";

        public bool Seleccionado { get; set; }
    }


    // ============================================================
    // COMITÉ
    // ============================================================

    public class ComiteMock
    {
        public int IdComite { get; set; }

        public string Nombre { get; set; } = "";

        public DateTime Fecha { get; set; }

        public string Descripcion { get; set; } = "";

        public string Estado { get; set; } = "";

        public List<int> Evaluadores { get; set; } = new();
    }

}
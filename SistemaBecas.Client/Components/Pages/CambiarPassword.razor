@page "/cambiar-password"

@using Radzen
@using Radzen.Blazor
@using SistemaBecas.Library.Dtos

@inject NotificationService NotificationService
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Sistema de Becas - Cambiar contraseña</PageTitle>

<RadzenStack JustifyContent="JustifyContent.Center"
             AlignItems="AlignItems.Center"
             Style="min-height: 100vh; padding: 2rem; background-color: #f4f7fb;">

    <RadzenCard Variant="Variant.Outlined"
                Style="width: 100%; max-width: 450px;">

        <RadzenStack Gap="1.5rem">

            <!-- ENCABEZADO -->

            <RadzenStack Gap="0.5rem"
                         AlignItems="AlignItems.Center">

                <RadzenIcon Icon="lock"
                            Style="font-size: 48px; color: #1565c0;" />

                <RadzenText Text="Nueva contraseña"
                            TextStyle="TextStyle.H4"
                            Style="color: #1565c0; font-weight: 700; margin: 0;" />

                <RadzenText Text="Ingrese su nueva contraseña"
                            Style="color: #666; margin: 0;" />

            </RadzenStack>


            <!-- NUEVA CONTRASEÑA -->

            <RadzenFormField Text="Nueva contraseña"
                             Variant="Variant.Outlined"
                             Style="width: 100%;">

                <RadzenPassword @bind-Value="nuevaPassword"
                                Placeholder="Ingrese su nueva contraseña"
                                Style="width: 100%;" />

            </RadzenFormField>


            <!-- CONFIRMAR CONTRASEÑA -->

            <RadzenFormField Text="Confirmar contraseña"
                             Variant="Variant.Outlined"
                             Style="width: 100%;">

                <RadzenPassword @bind-Value="confirmarPassword"
                                Placeholder="Confirme su nueva contraseña"
                                Style="width: 100%;" />

            </RadzenFormField>


            <!-- BOTÓN -->

            <RadzenButton Text="Cambiar contraseña"
                          Icon="lock_reset"
                          ButtonStyle="ButtonStyle.Primary"
                          Size="ButtonSize.Large"
                          Click="@Cambiar"
                          Disabled="@cargando"
                          Style="width: 100%;" />


            <!-- REGRESAR -->

            <RadzenStack AlignItems="AlignItems.Center">

                <RadzenLink Text="← Regresar al inicio de sesión"
                            Path="/login" />

            </RadzenStack>

        </RadzenStack>

    </RadzenCard>


    <RadzenText Text="Sistema de Becas"
                Style="color: #666; margin: 0;" />

</RadzenStack>


@code {

    private string correo = "";
    private string codigo = "";

    private string nuevaPassword = "";
    private string confirmarPassword = "";

    private bool cargando = false;

    protected override void OnInitialized()
    {
        var uri =
            NavigationManager.ToAbsoluteUri(
                NavigationManager.Uri);

        var query =
            Microsoft.AspNetCore.WebUtilities.QueryHelpers
                .ParseQuery(uri.Query);

        if (query.TryGetValue("correo", out var correoParametro))
        {
            correo = correoParametro.ToString();
        }

        if (query.TryGetValue("codigo", out var codigoParametro))
        {
            codigo = codigoParametro.ToString();
        }
    }

    private async Task Cambiar()
    {
        if (string.IsNullOrWhiteSpace(nuevaPassword))
        {
            NotificationService.Notify(
                NotificationSeverity.Warning,
                "Campo requerido",
                "Ingrese una nueva contraseña.");

            return;
        }

        if (nuevaPassword.Length < 8)
        {
            NotificationService.Notify(
                NotificationSeverity.Warning,
                "Contraseña inválida",
                "La contraseña debe tener al menos 8 caracteres.");

            return;
        }

        if (nuevaPassword != confirmarPassword)
        {
            NotificationService.Notify(
                NotificationSeverity.Warning,
                "Contraseñas diferentes",
                "Las contraseñas no coinciden.");

            return;
        }

        try
        {
            cargando = true;

            var httpClient =
                HttpClientFactory.CreateClient("Api");

            var dto = new CambiarPasswordDto
            {
                Correo = correo,
                Codigo = codigo,
                NuevaPassword = nuevaPassword
            };

            var response =
                await httpClient.PostAsJsonAsync(
                    "api/Password/cambiar",
                    dto);

            if (!response.IsSuccessStatusCode)
            {
                NotificationService.Notify(
                    NotificationSeverity.Error,
                    "Error",
                    "El código no es válido o ha expirado.");

                return;
            }

            NotificationService.Notify(
                NotificationSeverity.Success,
                "Contraseña cambiada",
                "Tu contraseña fue cambiada correctamente.");

            NavigationManager.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(
                NotificationSeverity.Error,
                "Error",
                $"No fue posible cambiar la contraseña: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }
}
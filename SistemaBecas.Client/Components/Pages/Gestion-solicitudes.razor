@page "/gestion-solicitudes"

@using Radzen
@using Radzen.Blazor

<PageTitle>Gestión de Solicitudes</PageTitle>

<RadzenStack Gap="1.5rem"
             Style="
    padding: 2rem;
    background-color: #f4f7fb;
    min-height: 100vh;">

    <!-- ====================================================== -->
    <!-- ENCABEZADO                                             -->
    <!-- ====================================================== -->

    <RadzenCard Style="
        background: linear-gradient(135deg, #1565c0, #1e88e5);
        color: white;
        border-radius: 16px;
        border: none;
        padding: 2rem;">

        <RadzenRow AlignItems="AlignItems.Center">

            <RadzenColumn Size="12" SizeMD="8">

                <RadzenText Text="Gestión de Solicitudes"
                            TextStyle="TextStyle.H4"
                            Style="
                color: white;
                font-weight: 700;
                margin-bottom: 6px;" />

                <RadzenText Text="Administración y seguimiento de solicitudes de beca"
                            Style="
                color: rgba(255,255,255,0.9);
                font-size: 15px;" />

            </RadzenColumn>

            <RadzenColumn Size="12"
                          SizeMD="4"
                          Style="text-align: right;">

                <RadzenBadge Text="7 solicitudes"
                             Style="
                background: rgba(255,255,255,0.2);
                color: white;
                padding: 8px 14px;
                border-radius: 20px;
                font-size: 14px;" />

            </RadzenColumn>

        </RadzenRow>

    </RadzenCard>


    <!-- ====================================================== -->
    <!-- ESTADÍSTICAS                                           -->
    <!-- ====================================================== -->

    <RadzenRow>

        <RadzenColumn Size="12" SizeMD="4">

            <RadzenCard Style="
                border-radius: 12px;
                border: 1px solid #e5e7eb;
                box-shadow: 0 2px 8px rgba(21,101,192,0.10);">

                <RadzenRow AlignItems="AlignItems.Center">

                    <RadzenColumn Size="8">

                        <RadzenText Text="Pendientes"
                                    Style="
                        color: #6b7280;
                        font-size: 13px;" />

                        <RadzenText Text="3"
                                    TextStyle="TextStyle.H4"
                                    Style="
                        color: #64b5f6;
                        font-weight: 700;
                        margin-top: 5px;" />

                    </RadzenColumn>

                    <RadzenColumn Size="4"
                                  Style="text-align: right;">

                        <RadzenIcon Icon="hourglass_empty"
                                    Style="
                        font-size: 38px;
                        color: #64b5f6;" />

                    </RadzenColumn>

                </RadzenRow>

            </RadzenCard>

        </RadzenColumn>


        <RadzenColumn Size="12" SizeMD="4">

            <RadzenCard Style="
                border-radius: 12px;
                border: 1px solid #e5e7eb;
                box-shadow: 0 2px 8px rgba(21,101,192,0.10);">

                <RadzenRow AlignItems="AlignItems.Center">

                    <RadzenColumn Size="8">

                        <RadzenText Text="Aprobadas"
                                    Style="
                        color: #6b7280;
                        font-size: 13px;" />

                        <RadzenText Text="2"
                                    TextStyle="TextStyle.H4"
                                    Style="
                        color: #1565c0;
                        font-weight: 700;
                        margin-top: 5px;" />

                    </RadzenColumn>

                    <RadzenColumn Size="4"
                                  Style="text-align: right;">

                        <RadzenIcon Icon="check_circle"
                                    Style="
                        font-size: 38px;
                        color: #1565c0;" />

                    </RadzenColumn>

                </RadzenRow>

            </RadzenCard>

        </RadzenColumn>


        <RadzenColumn Size="12" SizeMD="4">

            <RadzenCard Style="
                border-radius: 12px;
                border: 1px solid #e5e7eb;
                box-shadow: 0 2px 8px rgba(21,101,192,0.10);">

                <RadzenRow AlignItems="AlignItems.Center">

                    <RadzenColumn Size="8">

                        <RadzenText Text="Rechazadas"
                                    Style="
                        color: #6b7280;
                        font-size: 13px;" />

                        <RadzenText Text="2"
                                    TextStyle="TextStyle.H4"
                                    Style="
                        color: #94a3b8;
                        font-weight: 700;
                        margin-top: 5px;" />

                    </RadzenColumn>

                    <RadzenColumn Size="4"
                                  Style="text-align: right;">

                        <RadzenIcon Icon="cancel"
                                    Style="
                        font-size: 38px;
                        color: #94a3b8;" />

                    </RadzenColumn>

                </RadzenRow>

            </RadzenCard>

        </RadzenColumn>

    </RadzenRow>


    <!-- ====================================================== -->
    <!-- FILTROS                                                -->
    <!-- ====================================================== -->

    <RadzenCard Style="
        border-radius: 12px;
        background-color: #f7fbff;
        border: 1px solid #e3edf7;">

        <RadzenText Text="Filtros de búsqueda"
                    TextStyle="TextStyle.H6"
                    Style="
        color: #1565c0;
        font-weight: 700;
        margin-bottom: 5px;" />

        <RadzenText Text="Utilice los filtros para encontrar una solicitud."
                    Style="
        color: #6b7280;
        font-size: 13px;
        margin-bottom: 20px;" />

        <RadzenRow AlignItems="AlignItems.End">

            <!-- ESTADO -->

            <RadzenColumn Size="12" SizeMD="3">

                <RadzenFormField Text="Estado"
                                 Style="width: 100%;">

                    <RadzenDropDown TValue="string"
                                    @bind-Value="estadoSeleccionado"
                                    Data="@estados"
                                    Placeholder="Todos"
                                    AllowClear="true"
                                    Style="width: 100%;" />

                </RadzenFormField>

            </RadzenColumn>


            <!-- CONVOCATORIA -->

            <RadzenColumn Size="12" SizeMD="3">

                <RadzenFormField Text="Convocatoria"
                                 Style="width: 100%;">

                    <RadzenDropDown TValue="int?"
                                    @bind-Value="convocatoriaSeleccionada"
                                    Data="@convocatorias"
                                    TextProperty="Nombre"
                                    ValueProperty="IdConvocatoria"
                                    Placeholder="Todas"
                                    AllowClear="true"
                                    Style="width: 100%;" />

                </RadzenFormField>

            </RadzenColumn>


            <!-- BUSCAR ESTUDIANTE -->

            <RadzenColumn Size="12" SizeMD="4">

                <RadzenFormField Text="Buscar estudiante"
                                 Style="width: 100%;">

                    <RadzenTextBox @bind-Value="busqueda"
                                   Placeholder="Nombre o DPI"
                                   Style="width: 100%;" />

                </RadzenFormField>

            </RadzenColumn>


            <RadzenColumn Size="12" SizeMD="2">

                <RadzenButton Text="Buscar"
                              Icon="search"
                              ButtonStyle="ButtonStyle.Primary"
                              Style="width: 100%;" />

            </RadzenColumn>

        </RadzenRow>

    </RadzenCard>


    <!-- ====================================================== -->
    <!-- TABLA                                                   -->
    <!-- ====================================================== -->

    <RadzenCard Style="
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        overflow-x: auto;">

        <RadzenText Text="Solicitudes"
                    TextStyle="TextStyle.H6"
                    Style="
        color: #1565c0;
        font-weight: 700;
        margin-bottom: 5px;" />

        <RadzenText Text="Listado de solicitudes registradas"
                    Style="
        color: #6b7280;
        font-size: 13px;
        margin-bottom: 20px;" />


        <RadzenDataGrid Data="@solicitudes"
                        TItem="SolicitudMock"
                        AllowPaging="true"
                        PageSize="7"
                        AllowSorting="true"
                        AllowFiltering="false"
                        Responsive="true">

            <Columns>

                <!-- Solicitud -->

                <RadzenDataGridColumn TItem="SolicitudMock"
                                      Property="IdSolicitud"
                                      Title="Solicitud"
                                      Width="100px" />

                <!-- Estudiante -->

                <RadzenDataGridColumn TItem="SolicitudMock"
                                      Title="Estudiante"
                                      Width="220px">

                    <Template Context="solicitud">

                        <strong>
                            @solicitud.NombreEstudiante
                        </strong>

                        <br />

                        <small style="color:#6b7280;">
                            DPI: @solicitud.DPI
                        </small>

                    </Template>

                </RadzenDataGridColumn>


                <!-- Convocatoria -->

                <RadzenDataGridColumn TItem="SolicitudMock"
                                      Title="Convocatoria"
                                      Width="230px">

                    <Template Context="solicitud">
                        @solicitud.NombreConvocatoria
                    </Template>

                </RadzenDataGridColumn>


                <!-- Fecha -->

                <RadzenDataGridColumn TItem="SolicitudMock"
                                      Property="FechaSolicitud"
                                      Title="Fecha solicitud"
                                      FormatString="{0:dd/MM/yyyy}"
                                      Width="140px" />


                <!-- Evaluación -->

                <RadzenDataGridColumn TItem="SolicitudMock"
                                      Title="Punteo"
                                      Width="100px">

                    <Template Context="solicitud">

                        @if (solicitud.Punteo.HasValue)
                        {
                            <RadzenBadge Text="@solicitud.Punteo.Value.ToString("0.##")"
                                         BadgeStyle="BadgeStyle.Primary" />
                        }
                        else
                        {
                            <RadzenBadge Text="Pendiente"
                                         BadgeStyle="BadgeStyle.Light" />
                        }

                    </Template>

                </RadzenDataGridColumn>


                <!-- Estado -->

                <RadzenDataGridColumn TItem="SolicitudMock"
                                      Title="Estado"
                                      Width="130px">

                    <Template Context="solicitud">

                        @if (solicitud.Estado == "Pendiente")
                        {
                            <RadzenBadge Text="Pendiente"
                                         BadgeStyle="BadgeStyle.Info"
                                         IsPill="true" />
                        }
                        else if (solicitud.Estado == "Aprobada")
                        {
                            <RadzenBadge Text="Aprobada"
                                         BadgeStyle="BadgeStyle.Success"
                                         IsPill="true" />
                        }
                        else
                        {
                            <RadzenBadge Text="Rechazada"
                                         BadgeStyle="BadgeStyle.Danger"
                                         IsPill="true" />
                        }

                    </Template>

                </RadzenDataGridColumn>


                <!-- Acciones -->

                <RadzenDataGridColumn TItem="SolicitudMock"
                                      Title="Acciones"
                                      Width="180px">

                    <Template Context="solicitud">

                        <RadzenStack Orientation="Orientation.Horizontal"
                                     Gap="0.3rem">

                            <RadzenButton Icon="visibility"
                                          ButtonStyle="ButtonStyle.Light"
                                          Size="ButtonSize.Small" />

                            @if (solicitud.Estado == "Pendiente")
                            {
                                <RadzenButton Icon="check"
                                              ButtonStyle="ButtonStyle.Success"
                                              Size="ButtonSize.Small" />

                                <RadzenButton Icon="close"
                                              ButtonStyle="ButtonStyle.Danger"
                                              Size="ButtonSize.Small" />
                            }

                        </RadzenStack>

                    </Template>

                </RadzenDataGridColumn>

            </Columns>

        </RadzenDataGrid>

    </RadzenCard>

</RadzenStack>



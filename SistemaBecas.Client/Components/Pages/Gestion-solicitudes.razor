@page "/gestion-solicitudes"

@using Radzen
@using Radzen.Blazor
@using SistemaBecas.Client.Services
@using SistemaBecas.Library.Dtos
@using Components.Modals
@inject DialogService DialogService
@inject GestionApiClient Api
@inject NotificationService Notifications

<PageTitle>Gestión de Solicitudes</PageTitle>

<RadzenStack Gap="1.5rem"
             Style="
    padding: 2rem;
    background-color: #f4f7fb;
    min-height: 100vh;">

    <!-- ====================================================== -->
    <!-- ENCABEZADO                                             -->
    <!-- ====================================================== -->

    <RadzenCard Style="
        background: linear-gradient(135deg, #1565c0, #1e88e5);
        color: white;
        border-radius: 16px;
        border: none;
        padding: 2rem;">

        <RadzenRow AlignItems="AlignItems.Center">

            <RadzenColumn Size="12" SizeMD="8">

                <RadzenText Text="Gestión de Solicitudes"
                            TextStyle="TextStyle.H4"
                            Style="
                color: white;
                font-weight: 700;
                margin-bottom: 6px;" />

                <RadzenText Text="Administración y seguimiento de solicitudes de beca"
                            Style="
                color: rgba(255,255,255,0.9);
                font-size: 15px;" />

            </RadzenColumn>

            <RadzenColumn Size="12"
                          SizeMD="4"
                          Style="text-align: right;">

                <RadzenBadge Text="@($"{solicitudes.Count} solicitudes")"
                             Style="
                background: rgba(255,255,255,0.2);
                color: white;
                padding: 8px 14px;
                border-radius: 20px;
                font-size: 14px;" />

            </RadzenColumn>

        </RadzenRow>

    </RadzenCard>


    <!-- ====================================================== -->
    <!-- ESTADÍSTICAS                                           -->
    <!-- ====================================================== -->

    <RadzenRow>

        <RadzenColumn Size="12" SizeMD="4">

            <RadzenCard Style="
                border-radius: 12px;
                border: 1px solid #e5e7eb;
                box-shadow: 0 2px 8px rgba(21,101,192,0.10);">

                <RadzenRow AlignItems="AlignItems.Center">

                    <RadzenColumn Size="8">

                        <RadzenText Text="Pendientes"
                                    Style="
                        color: #6b7280;
                        font-size: 13px;" />

                        <RadzenText Text="@solicitudes.Count(s => s.Estado == "Pendiente").ToString()"
                                    TextStyle="TextStyle.H4"
                                    Style="
                        color: #64b5f6;
                        font-weight: 700;
                        margin-top: 5px;" />

                    </RadzenColumn>

                    <RadzenColumn Size="4"
                                  Style="text-align: right;">

                        <RadzenIcon Icon="hourglass_empty"
                                    Style="
                        font-size: 38px;
                        color: #64b5f6;" />

                    </RadzenColumn>

                </RadzenRow>

            </RadzenCard>

        </RadzenColumn>


        <RadzenColumn Size="12" SizeMD="4">

            <RadzenCard Style="
                border-radius: 12px;
                border: 1px solid #e5e7eb;
                box-shadow: 0 2px 8px rgba(21,101,192,0.10);">

                <RadzenRow AlignItems="AlignItems.Center">

                    <RadzenColumn Size="8">

                        <RadzenText Text="Aprobadas"
                                    Style="
                        color: #6b7280;
                        font-size: 13px;" />

                        <RadzenText Text="@solicitudes.Count(s => s.Estado == "Aprobada").ToString()"
                                    TextStyle="TextStyle.H4"
                                    Style="
                        color: #1565c0;
                        font-weight: 700;
                        margin-top: 5px;" />

                    </RadzenColumn>

                    <RadzenColumn Size="4"
                                  Style="text-align: right;">

                        <RadzenIcon Icon="check_circle"
                                    Style="
                        font-size: 38px;
                        color: #1565c0;" />

                    </RadzenColumn>

                </RadzenRow>

            </RadzenCard>

        </RadzenColumn>


        <RadzenColumn Size="12" SizeMD="4">

            <RadzenCard Style="
                border-radius: 12px;
                border: 1px solid #e5e7eb;
                box-shadow: 0 2px 8px rgba(21,101,192,0.10);">

                <RadzenRow AlignItems="AlignItems.Center">

                    <RadzenColumn Size="8">

                        <RadzenText Text="Rechazadas"
                                    Style="
                        color: #6b7280;
                        font-size: 13px;" />

                        <RadzenText Text="@solicitudes.Count(s => s.Estado == "Rechazada").ToString()"
                                    TextStyle="TextStyle.H4"
                                    Style="
                        color: #94a3b8;
                        font-weight: 700;
                        margin-top: 5px;" />

                    </RadzenColumn>

                    <RadzenColumn Size="4"
                                  Style="text-align: right;">

                        <RadzenIcon Icon="cancel"
                                    Style="
                        font-size: 38px;
                        color: #94a3b8;" />

                    </RadzenColumn>

                </RadzenRow>

            </RadzenCard>

        </RadzenColumn>

    </RadzenRow>


    <!-- ====================================================== -->
    <!-- FILTROS                                                -->
    <!-- ====================================================== -->

    <RadzenCard Style="
        border-radius: 12px;
        background-color: #f7fbff;
        border: 1px solid #e3edf7;">

        <RadzenText Text="Filtros de búsqueda"
                    TextStyle="TextStyle.H6"
                    Style="
        color: #1565c0;
        font-weight: 700;
        margin-bottom: 5px;" />

        <RadzenText Text="Utilice los filtros para encontrar una solicitud."
                    Style="
        color: #6b7280;
        font-size: 13px;
        margin-bottom: 20px;" />

        <RadzenRow AlignItems="AlignItems.End">

            <!-- ESTADO -->

            <RadzenColumn Size="12" SizeMD="3">

                <RadzenFormField Text="Estado"
                                 Style="width: 100%;">

                    <RadzenDropDown TValue="string"
                                    @bind-Value="estadoSeleccionado"
                                    Data="@estados"
                                    Placeholder="Todos"
                                    AllowClear="true"
                                    Style="width: 100%;" />

                </RadzenFormField>

            </RadzenColumn>


            <!-- CONVOCATORIA -->

            <RadzenColumn Size="12" SizeMD="3">

                <RadzenFormField Text="Convocatoria"
                                 Style="width: 100%;">

                    <RadzenDropDown TValue="int?"
                                    @bind-Value="convocatoriaSeleccionada"
                                    Data="@convocatorias"
                                    TextProperty="Nombre"
                                    ValueProperty="IdConvocatoria"
                                    Placeholder="Todas"
                                    AllowClear="true"
                                    Style="width: 100%;" />

                </RadzenFormField>

            </RadzenColumn>


            <!-- BUSCAR ESTUDIANTE -->

            <RadzenColumn Size="12" SizeMD="4">

                <RadzenFormField Text="Buscar estudiante"
                                 Style="width: 100%;">

                    <RadzenTextBox @bind-Value="busqueda"
                                   Placeholder="Nombre o DPI"
                                   Style="width: 100%;" />

                </RadzenFormField>

            </RadzenColumn>


            <RadzenColumn Size="12" SizeMD="2">

                <RadzenButton Text="Buscar"
                              Icon="search"
                              ButtonStyle="ButtonStyle.Primary"
                              Click="@CargarSolicitudesAsync"
                              Style="width: 100%;" />

            </RadzenColumn>

        </RadzenRow>

    </RadzenCard>


    <!-- ====================================================== -->
    <!-- TABLA                                                   -->
    <!-- ====================================================== -->

    <RadzenCard Style="
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        overflow-x: auto;">

        <RadzenText Text="Solicitudes"
                    TextStyle="TextStyle.H6"
                    Style="
        color: #1565c0;
        font-weight: 700;
        margin-bottom: 5px;" />

        <RadzenText Text="Listado de solicitudes registradas"
                    Style="
        color: #6b7280;
        font-size: 13px;
        margin-bottom: 20px;" />


        @if (!string.IsNullOrWhiteSpace(errorCarga))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Text="@errorCarga" />
        }
        @if (cargando)
        {
            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" />
        }
        <RadzenDataGrid Data="@SolicitudesFiltradas"
                        TItem="SolicitudGestionDto"
                        AllowPaging="true"
                        PageSize="7"
                        AllowSorting="true"
                        AllowFiltering="false"
                        Responsive="true">

            <Columns>

                <!-- Solicitud -->

                <RadzenDataGridColumn TItem="SolicitudGestionDto"
                                      Property="IdSolicitud"
                                      Title="Solicitud"
                                      Width="100px" />

                <!-- Estudiante -->

                <RadzenDataGridColumn TItem="SolicitudGestionDto"
                                      Title="Estudiante"
                                      Width="220px">

                    <Template Context="solicitud">

                        <strong>
                            @solicitud.Estudiante
                        </strong>

                        <br />

                        <small style="color:#6b7280;">
                            DPI: @solicitud.Dpi
                        </small>

                    </Template>

                </RadzenDataGridColumn>


                <!-- Convocatoria -->

                <RadzenDataGridColumn TItem="SolicitudGestionDto"
                                      Title="Convocatoria"
                                      Width="230px">

                    <Template Context="solicitud">
                        @solicitud.Convocatoria
                    </Template>

                </RadzenDataGridColumn>


                <!-- Fecha -->

                <RadzenDataGridColumn TItem="SolicitudGestionDto"
                                      Property="FechaSolicitud"
                                      Title="Fecha solicitud"
                                      FormatString="{0:dd/MM/yyyy}"
                                      Width="140px" />


                <!-- Evaluación -->

                <RadzenDataGridColumn TItem="SolicitudGestionDto"
                                      Title="Punteo"
                                      Width="100px">

                    <Template Context="solicitud">

                        @if (solicitud.Punteo.HasValue)
                        {
                            <RadzenBadge Text="@solicitud.Punteo.Value.ToString("0.##")"
                                         BadgeStyle="BadgeStyle.Primary" />
                        }
                        else
                        {
                            <RadzenBadge Text="Pendiente"
                                         BadgeStyle="BadgeStyle.Light" />
                        }

                    </Template>

                </RadzenDataGridColumn>


                <!-- Estado -->

                <RadzenDataGridColumn TItem="SolicitudGestionDto"
                                      Title="Estado"
                                      Width="130px">

                    <Template Context="solicitud">

                        @if (solicitud.Estado == "Pendiente")
                        {
                            <RadzenBadge Text="Pendiente"
                                         BadgeStyle="BadgeStyle.Info"
                                         IsPill="true" />
                        }
                        else if (solicitud.Estado == "Aprobada")
                        {
                            <RadzenBadge Text="Aprobada"
                                         BadgeStyle="BadgeStyle.Success"
                                         IsPill="true" />
                        }
                        else if (solicitud.Estado == "En revisión" || solicitud.Estado == "En evaluación")
                        {
                            <RadzenBadge Text="@solicitud.Estado"
                                         BadgeStyle="BadgeStyle.Info"
                                         IsPill="true" />
                        }
                        else
                        {
                            <RadzenBadge Text="Rechazada"
                                         BadgeStyle="BadgeStyle.Danger"
                                         IsPill="true" />
                        }

                    </Template>

                </RadzenDataGridColumn>


                <!-- Acciones -->

                <RadzenDataGridColumn TItem="SolicitudGestionDto"
                                      Title="Acciones"
                                      Width="180px">

                    <Template Context="solicitud">

                        <RadzenStack Orientation="Orientation.Horizontal"
                                     Gap="0.3rem">

                            <RadzenButton Icon="visibility"
                                          ButtonStyle="ButtonStyle.Light"
                                          Size="ButtonSize.Small"
                                          Click="@(() => VerSolicitud(solicitud))" />

                            @if (solicitud.Estado == "Pendiente")
                            {
                                <RadzenButton Icon="check"
                                              ButtonStyle="ButtonStyle.Success"
                                              Size="ButtonSize.Small"
                                              Click="@(() => CambiarEstadoAsync(solicitud, "Aprobada"))" />

                                <RadzenButton Icon="close"
                                              ButtonStyle="ButtonStyle.Danger"
                                              Size="ButtonSize.Small"
                                              Click="@(() => CambiarEstadoAsync(solicitud, "Rechazada"))" />
                            }

                        </RadzenStack>

                    </Template>

                </RadzenDataGridColumn>

            </Columns>

        </RadzenDataGrid>

    </RadzenCard>

</RadzenStack>


@code {

    private string? estadoSeleccionado;
    private int? convocatoriaSeleccionada;
    private string busqueda = string.Empty;
    private string? errorCarga;


    private List<string> estados = new()
    {
        "Pendiente",
        "En revisión",
        "En evaluación",
        "Aprobada",
        "Rechazada"
    };


    private List<ConvocatoriaDto> convocatorias = new();
    private List<SolicitudGestionDto> solicitudes = new();
    private bool cargando;
    private IEnumerable<SolicitudGestionDto> SolicitudesFiltradas => solicitudes.Where(s =>
        (string.IsNullOrWhiteSpace(estadoSeleccionado) || s.Estado.Equals(estadoSeleccionado, StringComparison.OrdinalIgnoreCase)) &&
        (!convocatoriaSeleccionada.HasValue || s.IdConvocatoria == convocatoriaSeleccionada.Value) &&
        (string.IsNullOrWhiteSpace(busqueda) || s.Estudiante.Contains(busqueda, StringComparison.OrdinalIgnoreCase) || s.Dpi.Contains(busqueda, StringComparison.OrdinalIgnoreCase)));

    protected override Task OnInitializedAsync() => CargarSolicitudesAsync();

    private async Task CargarSolicitudesAsync()
    {
        cargando = true;
        errorCarga = null;
        try
        {
            solicitudes = await Api.ObtenerSolicitudesAsync();
            convocatorias = await Api.ObtenerConvocatoriasAsync();
        }
        catch (Exception ex)
        {
            errorCarga = $"No se pudieron cargar las solicitudes: {ex.Message}";
            Notifications.Notify(NotificationSeverity.Error, "Error al cargar", ex.Message);
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task VerSolicitud(SolicitudGestionDto solicitud)
    {
        var resultado = await DialogService.OpenAsync<DetalleSolicitud>(
            $"Solicitud #{solicitud.IdSolicitud}",
            new Dictionary<string, object?> { { "Solicitud", solicitud } },
            new DialogOptions { Width = "900px", Height = "800px", Resizable = true, Draggable = true });
        if (resultado == true)
            await CargarSolicitudesAsync();
    }

    private async Task CambiarEstadoAsync(SolicitudGestionDto solicitud, string estado)
    {
        try
        {
            await Api.ActualizarEstadoSolicitudAsync(solicitud.IdSolicitud, new SolicitudEstadoDto
            {
                Estado = estado,
                Observaciones = solicitud.Observaciones
            });
            Notifications.Notify(NotificationSeverity.Success, "Solicitud actualizada", $"Estado: {estado}.");
            await CargarSolicitudesAsync();
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error, "No se pudo actualizar", ex.Message);
        }
    }

}

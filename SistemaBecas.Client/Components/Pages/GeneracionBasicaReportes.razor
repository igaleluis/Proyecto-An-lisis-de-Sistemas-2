@page "/generacion-reportes"

@using Radzen
@using Radzen.Blazor

<PageTitle>Generación de Reportes</PageTitle>

<RadzenStack Gap="1.5rem"
             Style="padding: 2rem; background-color: #f4f7fb; min-height: 100vh;">

    <!-- ====================================================== -->
    <!-- ENCABEZADO                                             -->
    <!-- ====================================================== -->

    <RadzenCard Style="
        background: linear-gradient(135deg, #1565c0, #1e88e5);
        color: white;
        border-radius: 16px;
        border: none;
        padding: 2rem;">

        <RadzenRow AlignItems="AlignItems.Center">

            <RadzenColumn Size="12" SizeMD="8">

                <RadzenText Text="Generación de Reportes"
                            TextStyle="TextStyle.H4"
                            Style="
                color: white;
                font-weight: 700;
                margin-bottom: 6px;" />

                <RadzenText Text="Consulte y genere reportes básicos del sistema de becas"
                            Style="
                color: rgba(255,255,255,0.9);
                font-size: 15px;" />

            </RadzenColumn>

            <RadzenColumn Size="12"
                          SizeMD="4"
                          Style="text-align: right;">

                <RadzenIcon Icon="assessment"
                            Style="
                font-size: 55px;
                color: rgba(255,255,255,0.85);" />

            </RadzenColumn>

        </RadzenRow>

    </RadzenCard>


    <!-- ====================================================== -->
    <!-- ESTADÍSTICAS                                           -->
    <!-- ====================================================== -->

    <RadzenRow>

        <!-- SOLICITUDES -->

        <RadzenColumn Size="12" SizeMD="3">

            <RadzenCard Style="
                border-radius: 12px;
                border: 1px solid #e5e7eb;">

                <RadzenRow AlignItems="AlignItems.Center">

                    <RadzenColumn Size="8">

                        <RadzenText Text="Solicitudes"
                                    Style="
                        color: #6b7280;
                        font-size: 13px;" />

                        <RadzenText Text="20"
                                    TextStyle="TextStyle.H4"
                                    Style="
                        color: #1565c0;
                        font-weight: 700;
                        margin-top: 5px;" />

                    </RadzenColumn>

                    <RadzenColumn Size="4"
                                  Style="text-align:right;">

                        <RadzenIcon Icon="description"
                                    Style="
                        font-size: 38px;
                        color: #1565c0;" />

                    </RadzenColumn>

                </RadzenRow>

            </RadzenCard>

        </RadzenColumn>


        <!-- APROBADAS -->

        <RadzenColumn Size="12" SizeMD="3">

            <RadzenCard Style="
                border-radius: 12px;
                border: 1px solid #e5e7eb;">

                <RadzenRow AlignItems="AlignItems.Center">

                    <RadzenColumn Size="8">

                        <RadzenText Text="Aprobadas"
                                    Style="
                        color: #6b7280;
                        font-size: 13px;" />

                        <RadzenText Text="8"
                                    TextStyle="TextStyle.H4"
                                    Style="
                        color: #2e7d32;
                        font-weight: 700;
                        margin-top: 5px;" />

                    </RadzenColumn>

                    <RadzenColumn Size="4"
                                  Style="text-align:right;">

                        <RadzenIcon Icon="check_circle"
                                    Style="
                        font-size: 38px;
                        color: #2e7d32;" />

                    </RadzenColumn>

                </RadzenRow>

            </RadzenCard>

        </RadzenColumn>


        <!-- RECHAZADAS -->

        <RadzenColumn Size="12" SizeMD="3">

            <RadzenCard Style="
                border-radius: 12px;
                border: 1px solid #e5e7eb;">

                <RadzenRow AlignItems="AlignItems.Center">

                    <RadzenColumn Size="8">

                        <RadzenText Text="Rechazadas"
                                    Style="
                        color: #6b7280;
                        font-size: 13px;" />

                        <RadzenText Text="5"
                                    TextStyle="TextStyle.H4"
                                    Style="
                        color: #c62828;
                        font-weight: 700;
                        margin-top: 5px;" />

                    </RadzenColumn>

                    <RadzenColumn Size="4"
                                  Style="text-align:right;">

                        <RadzenIcon Icon="cancel"
                                    Style="
                        font-size: 38px;
                        color: #c62828;" />

                    </RadzenColumn>

                </RadzenRow>

            </RadzenCard>

        </RadzenColumn>


        <!-- BECAS -->

        <RadzenColumn Size="12" SizeMD="3">

            <RadzenCard Style="
                border-radius: 12px;
                border: 1px solid #e5e7eb;">

                <RadzenRow AlignItems="AlignItems.Center">

                    <RadzenColumn Size="8">

                        <RadzenText Text="Becas otorgadas"
                                    Style="
                        color: #6b7280;
                        font-size: 13px;" />

                        <RadzenText Text="7"
                                    TextStyle="TextStyle.H4"
                                    Style="
                        color: #7b1fa2;
                        font-weight: 700;
                        margin-top: 5px;" />

                    </RadzenColumn>

                    <RadzenColumn Size="4"
                                  Style="text-align:right;">

                        <RadzenIcon Icon="school"
                                    Style="
                        font-size: 38px;
                        color: #7b1fa2;" />

                    </RadzenColumn>

                </RadzenRow>

            </RadzenCard>

        </RadzenColumn>

    </RadzenRow>


    <!-- ====================================================== -->
    <!-- FILTROS                                                -->
    <!-- ====================================================== -->

    <RadzenCard Style="
        border-radius: 12px;
        background-color: #f7fbff;
        border: 1px solid #e3edf7;">

        <RadzenText Text="Filtros del reporte"
                    TextStyle="TextStyle.H6"
                    Style="
        color: #1565c0;
        font-weight: 700;
        margin-bottom: 5px;" />

        <RadzenText Text="Seleccione los criterios para generar el reporte."
                    Style="
        color: #6b7280;
        font-size: 13px;
        margin-bottom: 20px;" />

        <RadzenRow AlignItems="AlignItems.End">

            <!-- FECHA INICIO -->

            <RadzenColumn Size="12" SizeMD="3">

                <RadzenFormField Text="Fecha inicio"
                                 Variant="Variant.Outlined"
                                 Style="width:100%;">

                    <RadzenDatePicker TValue="DateTime?"
                                      @bind-Value="fechaInicio"
                                      Placeholder="Seleccione fecha"
                                      Style="width:100%;" />

                </RadzenFormField>

            </RadzenColumn>


            <!-- FECHA FIN -->

            <RadzenColumn Size="12" SizeMD="3">

                <RadzenFormField Text="Fecha fin"
                                 Variant="Variant.Outlined"
                                 Style="width:100%;">

                    <RadzenDatePicker TValue="DateTime?"
                                      @bind-Value="fechaFin"
                                      Placeholder="Seleccione fecha"
                                      Style="width:100%;" />

                </RadzenFormField>

            </RadzenColumn>


            <!-- CONVOCATORIA -->

            <RadzenColumn Size="12" SizeMD="3">

                <RadzenFormField Text="Convocatoria"
                                 Variant="Variant.Outlined"
                                 Style="width:100%;">

                    <RadzenDropDown TValue="int?"
                                    @bind-Value="convocatoriaSeleccionada"
                                    Data="@convocatorias"
                                    TextProperty="Nombre"
                                    ValueProperty="IdConvocatoria"
                                    Placeholder="Todas"
                                    AllowClear="true"
                                    Style="width:100%;" />

                </RadzenFormField>

            </RadzenColumn>


            <!-- ESTADO -->

            <RadzenColumn Size="12" SizeMD="3">

                <RadzenFormField Text="Estado"
                                 Variant="Variant.Outlined"
                                 Style="width:100%;">

                    <RadzenDropDown TValue="string"
                                    @bind-Value="estadoSeleccionado"
                                    Data="@estados"
                                    Placeholder="Todos"
                                    AllowClear="true"
                                    Style="width:100%;" />

                </RadzenFormField>

            </RadzenColumn>

        </RadzenRow>

    </RadzenCard>


    <!-- ====================================================== -->
    <!-- TIPOS DE REPORTES                                      -->
    <!-- ====================================================== -->

    <RadzenCard Style="
        border-radius: 12px;
        border: 1px solid #e5e7eb;">

        <RadzenText Text="Reportes disponibles"
                    TextStyle="TextStyle.H6"
                    Style="
        color:#1565c0;
        font-weight:700;
        margin-bottom:5px;" />

        <RadzenText Text="Seleccione el reporte que desea generar."
                    Style="
        color:#6b7280;
        font-size:13px;
        margin-bottom:20px;" />


        <RadzenRow>

            <!-- REPORTE DE SOLICITUDES -->

            <RadzenColumn Size="12" SizeMD="6">

                <RadzenCard Style="
                    border:1px solid #e5e7eb;
                    border-radius:12px;
                    height:100%;">

                    <RadzenRow AlignItems="AlignItems.Center">

                        <RadzenColumn Size="2">

                            <RadzenIcon Icon="description"
                                        Style="
                            font-size:42px;
                            color:#1565c0;" />

                        </RadzenColumn>

                        <RadzenColumn Size="7">

                            <RadzenText Text="Reporte de solicitudes"
                                        TextStyle="TextStyle.H6"
                                        Style="font-weight:700;" />

                            <RadzenText Text="Listado general de solicitudes registradas."
                                        Style="
                            color:#6b7280;
                            font-size:13px;" />

                        </RadzenColumn>

                        <RadzenColumn Size="3"
                                      Style="text-align:right;">

                            <RadzenButton Text="Generar"
                                          Icon="picture_as_pdf"
                                          ButtonStyle="ButtonStyle.Primary" />

                        </RadzenColumn>

                    </RadzenRow>

                </RadzenCard>

            </RadzenColumn>


            <!-- REPORTE POR ESTADO -->

            <RadzenColumn Size="12" SizeMD="6">

                <RadzenCard Style="
                    border:1px solid #e5e7eb;
                    border-radius:12px;
                    height:100%;">

                    <RadzenRow AlignItems="AlignItems.Center">

                        <RadzenColumn Size="2">

                            <RadzenIcon Icon="filter_alt"
                                        Style="
                            font-size:42px;
                            color:#1565c0;" />

                        </RadzenColumn>

                        <RadzenColumn Size="7">

                            <RadzenText Text="Solicitudes por estado"
                                        TextStyle="TextStyle.H6"
                                        Style="font-weight:700;" />

                            <RadzenText Text="Resumen de solicitudes según su estado."
                                        Style="
                            color:#6b7280;
                            font-size:13px;" />

                        </RadzenColumn>

                        <RadzenColumn Size="3"
                                      Style="text-align:right;">

                            <RadzenButton Text="Generar"
                                          Icon="picture_as_pdf"
                                          ButtonStyle="ButtonStyle.Primary" />

                        </RadzenColumn>

                    </RadzenRow>

                </RadzenCard>

            </RadzenColumn>


            <!-- REPORTE POR CONVOCATORIA -->

            <RadzenColumn Size="12" SizeMD="6">

                <RadzenCard Style="
                    border:1px solid #e5e7eb;
                    border-radius:12px;
                    height:100%;">

                    <RadzenRow AlignItems="AlignItems.Center">

                        <RadzenColumn Size="2">

                            <RadzenIcon Icon="campaign"
                                        Style="
                            font-size:42px;
                            color:#1565c0;" />

                        </RadzenColumn>

                        <RadzenColumn Size="7">

                            <RadzenText Text="Solicitudes por convocatoria"
                                        TextStyle="TextStyle.H6"
                                        Style="font-weight:700;" />

                            <RadzenText Text="Cantidad de solicitudes por convocatoria."
                                        Style="
                            color:#6b7280;
                            font-size:13px;" />

                        </RadzenColumn>

                        <RadzenColumn Size="3"
                                      Style="text-align:right;">

                            <RadzenButton Text="Generar"
                                          Icon="picture_as_pdf"
                                          ButtonStyle="ButtonStyle.Primary" />

                        </RadzenColumn>

                    </RadzenRow>

                </RadzenCard>

            </RadzenColumn>


            <!-- REPORTE DE EVALUACIONES -->

            <RadzenColumn Size="12" SizeMD="6">

                <RadzenCard Style="
                    border:1px solid #e5e7eb;
                    border-radius:12px;
                    height:100%;">

                    <RadzenRow AlignItems="AlignItems.Center">

                        <RadzenColumn Size="2">

                            <RadzenIcon Icon="fact_check"
                                        Style="
                            font-size:42px;
                            color:#1565c0;" />

                        </RadzenColumn>

                        <RadzenColumn Size="7">

                            <RadzenText Text="Reporte de evaluaciones"
                                        TextStyle="TextStyle.H6"
                                        Style="font-weight:700;" />

                            <RadzenText Text="Evaluaciones realizadas a las solicitudes."
                                        Style="
                            color:#6b7280;
                            font-size:13px;" />

                        </RadzenColumn>

                        <RadzenColumn Size="3"
                                      Style="text-align:right;">

                            <RadzenButton Text="Generar"
                                          Icon="picture_as_pdf"
                                          ButtonStyle="ButtonStyle.Primary" />

                        </RadzenColumn>

                    </RadzenRow>

                </RadzenCard>

            </RadzenColumn>


            <!-- REPORTE DE DECISIONES -->

            <RadzenColumn Size="12" SizeMD="6">

                <RadzenCard Style="
                    border:1px solid #e5e7eb;
                    border-radius:12px;
                    height:100%;">

                    <RadzenRow AlignItems="AlignItems.Center">

                        <RadzenColumn Size="2">

                            <RadzenIcon Icon="gavel"
                                        Style="
                            font-size:42px;
                            color:#1565c0;" />

                        </RadzenColumn>

                        <RadzenColumn Size="7">

                            <RadzenText Text="Reporte de decisiones"
                                        TextStyle="TextStyle.H6"
                                        Style="font-weight:700;" />

                            <RadzenText Text="Decisiones tomadas por el comité."
                                        Style="
                            color:#6b7280;
                            font-size:13px;" />

                        </RadzenColumn>

                        <RadzenColumn Size="3"
                                      Style="text-align:right;">

                            <RadzenButton Text="Generar"
                                          Icon="picture_as_pdf"
                                          ButtonStyle="ButtonStyle.Primary" />

                        </RadzenColumn>

                    </RadzenRow>

                </RadzenCard>

            </RadzenColumn>


            <!-- REPORTE DE BECAS -->

            <RadzenColumn Size="12" SizeMD="6">

                <RadzenCard Style="
                    border:1px solid #e5e7eb;
                    border-radius:12px;
                    height:100%;">

                    <RadzenRow AlignItems="AlignItems.Center">

                        <RadzenColumn Size="2">

                            <RadzenIcon Icon="school"
                                        Style="
                            font-size:42px;
                            color:#1565c0;" />

                        </RadzenColumn>

                        <RadzenColumn Size="7">

                            <RadzenText Text="Reporte de becas otorgadas"
                                        TextStyle="TextStyle.H6"
                                        Style="font-weight:700;" />

                            <RadzenText Text="Listado de estudiantes beneficiados."
                                        Style="
                            color:#6b7280;
                            font-size:13px;" />

                        </RadzenColumn>

                        <RadzenColumn Size="3"
                                      Style="text-align:right;">

                            <RadzenButton Text="Generar"
                                          Icon="picture_as_pdf"
                                          ButtonStyle="ButtonStyle.Primary" />

                        </RadzenColumn>

                    </RadzenRow>

                </RadzenCard>

            </RadzenColumn>

        </RadzenRow>

    </RadzenCard>


    <!-- ====================================================== -->
    <!-- ÚLTIMOS REPORTES                                       -->
    <!-- ====================================================== -->

    <RadzenCard Style="
        border-radius:12px;
        border:1px solid #e5e7eb;">

        <RadzenRow AlignItems="AlignItems.Center"
                   Style="margin-bottom:15px;">

            <RadzenColumn Size="8">

                <RadzenText Text="Reportes generados recientemente"
                            TextStyle="TextStyle.H6"
                            Style="
                color:#1565c0;
                font-weight:700;" />

            </RadzenColumn>

            <RadzenColumn Size="4"
                          Style="text-align:right;">

                <RadzenButton Text="Actualizar"
                              Icon="refresh"
                              ButtonStyle="ButtonStyle.Light" />

            </RadzenColumn>

        </RadzenRow>


        <RadzenDataGrid TItem="ReporteDto"
                        Data="@reportes"
                        AllowPaging="true"
                        PageSize="5"
                        AllowSorting="true"
                        Responsive="true">

            <Columns>

                <RadzenDataGridColumn TItem="ReporteDto"
                                      Property="Nombre"
                                      Title="Reporte" />

                <RadzenDataGridColumn TItem="ReporteDto"
                                      Property="Fecha"
                                      Title="Fecha"
                                      Width="150px">

                    <Template Context="reporte">

                        @reporte.Fecha.ToString("dd/MM/yyyy HH:mm")

                    </Template>

                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ReporteDto"
                                      Property="Usuario"
                                      Title="Generado por" />

                <RadzenDataGridColumn TItem="ReporteDto"
                                      Title="Acciones"
                                      Width="130px">

                    <Template Context="reporte">

                        <RadzenButton Icon="download"
                                      Text="Descargar"
                                      Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Light" />

                    </Template>

                </RadzenDataGridColumn>

            </Columns>

        </RadzenDataGrid>

    </RadzenCard>

</RadzenStack>


@code {

    // ============================================================
    // FILTROS
    // ============================================================

    private DateTime? fechaInicio;

    private DateTime? fechaFin;

    private int? convocatoriaSeleccionada;

    private string? estadoSeleccionado;


    // ============================================================
    // ESTADOS
    // ============================================================

    private List<string> estados = new()
    {
        "Pendiente",
        "En revisión",
        "En evaluación",
        "Aprobada",
        "Rechazada"
    };


    // ============================================================
    // CONVOCATORIAS MOCK
    // Corresponden a la tabla Convocatoria
    // ============================================================

    private List<ConvocatoriaMock> convocatorias = new()
    {
        new ConvocatoriaMock
        {
            IdConvocatoria = 1,
            Nombre = "Beca Nacional Universitaria 2026"
        },

        new ConvocatoriaMock
        {
            IdConvocatoria = 2,
            Nombre = "Beca Internacional Posgrado"
        },

        new ConvocatoriaMock
        {
            IdConvocatoria = 3,
            Nombre = "Beca Técnica Media"
        }
    };


    // ============================================================
    // REPORTES GENERADOS
    // ============================================================

    private List<ReporteDto> reportes = new()
    {
        new ReporteDto
        {
            Nombre = "Reporte de solicitudes",
            Fecha = new DateTime(2026, 9, 26, 10, 30, 0),
            Usuario = "Administrador"
        },

        new ReporteDto
        {
            Nombre = "Reporte de becas otorgadas",
            Fecha = new DateTime(2026, 9, 25, 15, 20, 0),
            Usuario = "Administrador"
        },

        new ReporteDto
        {
            Nombre = "Reporte de evaluaciones",
            Fecha = new DateTime(2026, 9, 24, 9, 45, 0),
            Usuario = "Comité de Becas"
        }
    };


    // ============================================================
    // MOCK CONVOCATORIA
    // ============================================================

    public class ConvocatoriaMock
    {
        public int IdConvocatoria { get; set; }

        public string Nombre { get; set; } = "";
    }


    // ============================================================
    // REPORTE
    // ============================================================

    public class ReporteDto
    {
        public string Nombre { get; set; } = "";

        public DateTime Fecha { get; set; }

        public string Usuario { get; set; } = "";
    }

}
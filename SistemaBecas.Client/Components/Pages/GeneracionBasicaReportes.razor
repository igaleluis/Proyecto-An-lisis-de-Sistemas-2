@page "/generacion-reportes"

@using Radzen
@using Radzen.Blazor
@using SistemaBecas.Client.Services.Reportes
@using SistemaBecas.Library.Dtos.Reportes

@inject IJSRuntime JS
@inject ReportesService ReportesService
@inject NotificationService NotificationService

<PageTitle>Generación de Reportes</PageTitle>

<!-- ENCABEZADO -->
<RadzenCard class="w-100 mb-4"
            Style="background: linear-gradient(135deg, #1976d2, #0d47a1); color: white;">
    <div style="padding: 20px;">
        <RadzenText Text="Generación de Reportes"
                    TextStyle="TextStyle.H4"
                    Style="color: white; font-weight: bold;" />

        <RadzenText Text="Genera y consulta los diferentes reportes del sistema de becas."
                    Style="color: white; margin-top: 5px;" />
    </div>
</RadzenCard>

<!-- ESTADÍSTICAS -->
<RadzenRow Gap="16px" class="mb-4">

    <RadzenColumn Size="12" SizeMD="3">
        <RadzenCard class="w-100"
                    Style="text-align: center; padding: 20px;">
            <RadzenText Text="@estadisticas.TotalSolicitudes.ToString()"
                        TextStyle="TextStyle.H3"
                        Style="font-weight: bold;" />

            <RadzenText Text="Solicitudes"
                        TextStyle="TextStyle.Body1" />
        </RadzenCard>
    </RadzenColumn>

    <RadzenColumn Size="12" SizeMD="3">
        <RadzenCard class="w-100"
                    Style="text-align: center; padding: 20px;">
            <RadzenText Text="@estadisticas.Aprobadas.ToString()"
                        TextStyle="TextStyle.H3"
                        Style="font-weight: bold; color: #2e7d32;" />

            <RadzenText Text="Aprobadas"
                        TextStyle="TextStyle.Body1" />
        </RadzenCard>
    </RadzenColumn>

    <RadzenColumn Size="12" SizeMD="3">
        <RadzenCard class="w-100"
                    Style="text-align: center; padding: 20px;">
            <RadzenText Text="@estadisticas.Rechazadas.ToString()"
                        TextStyle="TextStyle.H3"
                        Style="font-weight: bold; color: #c62828;" />

            <RadzenText Text="Rechazadas"
                        TextStyle="TextStyle.Body1" />
        </RadzenCard>
    </RadzenColumn>

    <RadzenColumn Size="12" SizeMD="3">
        <RadzenCard class="w-100"
                    Style="text-align: center; padding: 20px;">
            <RadzenText Text="@estadisticas.BecasOtorgadas.ToString()"
                        TextStyle="TextStyle.H3"
                        Style="font-weight: bold; color: #1565c0;" />

            <RadzenText Text="Becas otorgadas"
                        TextStyle="TextStyle.Body1" />
        </RadzenCard>
    </RadzenColumn>

</RadzenRow>

<!-- FILTROS -->
<RadzenCard class="w-100 mb-4"
            Style="padding: 16px;">

    <RadzenText Text="Filtros por fecha"
                TextStyle="TextStyle.H5"
                class="mb-3" />

    <RadzenRow Gap="12px" AlignItems="AlignItems.End">

        <!-- FECHA INICIO -->
        <RadzenColumn Size="12" SizeMD="4">
            <RadzenFormField Text="Fecha inicio"
                             class="w-100">
                <RadzenDatePicker @bind-Value="fechaInicio"
                                  DateFormat="dd/MM/yyyy"
                                  Max="fechaFin"
                                  class="w-100" />
            </RadzenFormField>
        </RadzenColumn>

        <!-- FECHA FIN -->
        <RadzenColumn Size="12" SizeMD="4">
            <RadzenFormField Text="Fecha fin"
                             class="w-100">
                <RadzenDatePicker @bind-Value="fechaFin"
                                  DateFormat="dd/MM/yyyy"
                                  Min="fechaInicio"
                                  class="w-100" />
            </RadzenFormField>
        </RadzenColumn>

        <!-- APLICAR FILTROS -->
        <RadzenColumn Size="6" SizeMD="2">
            <RadzenButton Text="Aplicar"
                          Icon="filter_alt"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="@AplicarFiltros"
                          Disabled="@cargandoReporte"
                          Style="width: 100%;" />
        </RadzenColumn>

        <!-- LIMPIAR FILTROS -->
        <RadzenColumn Size="6" SizeMD="2">
            <RadzenButton Text="Limpiar"
                          Icon="filter_alt_off"
                          ButtonStyle="ButtonStyle.Light"
                          Click="@LimpiarFiltros"
                          Disabled="@cargandoReporte"
                          Style="width: 100%;" />
        </RadzenColumn>

    </RadzenRow>
</RadzenCard>

<!-- REPORTES DISPONIBLES -->
<RadzenCard class="w-100 mb-4">

    <RadzenText Text="Reportes disponibles"
                TextStyle="TextStyle.H5"
                class="mb-4" />

    <RadzenRow Gap="16px">

        <!-- ESTADO DE SOLICITUDES -->
        <RadzenColumn Size="12" SizeMD="4">
            <RadzenCard Style="height: 100%;">

                <RadzenText Text="Solicitudes por estado"
                            TextStyle="TextStyle.H6"
                            Style="font-weight: bold;" />

                <RadzenText Text="Muestra las solicitudes y su estado actual."
                            Style="margin-top: 8px;" />

                <div style="margin-top: 20px;">
                    <RadzenButton Text="Generar PDF"
                                  Icon="picture_as_pdf"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="@GenerarEstadoSolicitudes"
                                  Disabled="@cargandoReporte" />
                </div>

            </RadzenCard>
        </RadzenColumn>

        <!-- SOLICITUDES POR CONVOCATORIA -->
        <RadzenColumn Size="12" SizeMD="4">
            <RadzenCard Style="height: 100%;">

                <RadzenText Text="Solicitudes por convocatoria"
                            TextStyle="TextStyle.H6"
                            Style="font-weight: bold;" />

                <RadzenText Text="Consulta el total recibido, en evaluación, aprobado y rechazado."
                            Style="margin-top: 8px;" />

                <div style="margin-top: 20px;">
                    <RadzenButton Text="Generar PDF"
                                  Icon="picture_as_pdf"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="@GenerarSolicitudesPorConvocatoria"
                                  Disabled="@cargandoReporte" />
                </div>

            </RadzenCard>
        </RadzenColumn>

        <!-- BECAS OTORGADAS -->
        <RadzenColumn Size="12" SizeMD="4">
            <RadzenCard Style="height: 100%;">

                <RadzenText Text="Reporte de becas otorgadas"
                            TextStyle="TextStyle.H6"
                            Style="font-weight: bold;" />

                <RadzenText Text="Consulta las becas otorgadas y sus beneficiarios."
                            Style="margin-top: 8px;" />

                <div style="margin-top: 20px;">
                    <RadzenButton Text="Generar PDF"
                                  Icon="picture_as_pdf"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="@GenerarBecasOtorgadas"
                                  Disabled="@cargandoReporte" />
                </div>

            </RadzenCard>
        </RadzenColumn>

        <!-- CONVOCATORIAS -->
        <RadzenColumn Size="12" SizeMD="4">
            <RadzenCard Style="height: 100%;">

                <RadzenText Text="Reporte de convocatorias"
                            TextStyle="TextStyle.H6"
                            Style="font-weight: bold;" />

                <RadzenText Text="Consulta las convocatorias, sus fechas, cupos y estado."
                            Style="margin-top: 8px;" />

                <div style="margin-top: 20px;">
                    <RadzenButton Text="Generar PDF"
                                  Icon="picture_as_pdf"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="@GenerarConvocatorias"
                                  Disabled="@cargandoReporte" />
                </div>

            </RadzenCard>
        </RadzenColumn>

    </RadzenRow>
</RadzenCard>

@code {
    // ============================================================
    // FILTROS
    // ============================================================

    private DateTime? fechaInicio;
    private DateTime? fechaFin;

    // ============================================================
    // ESTADÍSTICAS
    // ============================================================

    private EstadisticasReportesDto estadisticas = new();

    // ============================================================
    // ESTADO DE LA PÁGINA
    // ============================================================

    private bool cargandoReporte;

    protected override async Task OnInitializedAsync()
    {
        await CargarEstadisticas();
    }

    // ============================================================
    // CARGAR ESTADÍSTICAS
    // ============================================================

    private async Task<bool> CargarEstadisticas()
    {
        try
        {
            estadisticas = await ReportesService.ObtenerEstadisticas(
                fechaInicio,
                fechaFin);

            return true;
        }
        catch (Exception ex)
        {
            NotificationService.Notify(
                NotificationSeverity.Error,
                "Error al cargar estadísticas",
                $"No fue posible cargar las estadísticas: {ex.Message}");

            return false;
        }
    }

    // ============================================================
    // APLICAR FILTROS
    // ============================================================

    private async Task AplicarFiltros()
    {
        if (fechaInicio.HasValue &&
            fechaFin.HasValue &&
            fechaInicio.Value.Date > fechaFin.Value.Date)
        {
            NotificationService.Notify(
                NotificationSeverity.Warning,
                "Fechas inválidas",
                "La fecha inicial no puede ser posterior a la fecha final.");

            return;
        }

        var resultado = await CargarEstadisticas();

        if (resultado)
        {
            NotificationService.Notify(
                NotificationSeverity.Success,
                "Filtros aplicados",
                "Las estadísticas se actualizaron correctamente.");
        }
    }

    // ============================================================
    // LIMPIAR FILTROS
    // ============================================================

    private async Task LimpiarFiltros()
    {
        fechaInicio = null;
        fechaFin = null;

        var resultado = await CargarEstadisticas();

        if (resultado)
        {
            NotificationService.Notify(
                NotificationSeverity.Info,
                "Filtros limpiados",
                "Se eliminaron los filtros de fecha.");
        }
    }

    // ============================================================
    // GENERAR PDF DE SOLICITUDES POR CONVOCATORIA
    // ============================================================

    private async Task GenerarSolicitudesPorConvocatoria()
    {
        await EjecutarReporte(async () =>
        {
            var pdf = await ReportesService
                .GenerarSolicitudesPorConvocatoriaPdf(
                    fechaInicio,
                    fechaFin);

            await AbrirPdf(
                pdf,
                $"Reporte_Solicitudes_{DateTime.Now:yyyyMMdd_HHmmss}.pdf");
        });
    }

    // ============================================================
    // GENERAR PDF DE ESTADO DE SOLICITUDES
    // ============================================================

    private async Task GenerarEstadoSolicitudes()
    {
        await EjecutarReporte(async () =>
        {
            var pdf = await ReportesService.GenerarEstadoSolicitudesPdf(
                fechaInicio,
                fechaFin);

            await AbrirPdf(
                pdf,
                $"Reporte_Estado_Solicitudes_{DateTime.Now:yyyyMMdd_HHmmss}.pdf");
        });
    }

    // ============================================================
    // GENERAR PDF DE BECAS OTORGADAS
    // ============================================================

    private async Task GenerarBecasOtorgadas()
    {
        await EjecutarReporte(async () =>
        {
            var pdf = await ReportesService.GenerarBecasOtorgadasPdf(
                fechaInicio,
                fechaFin);

            await AbrirPdf(
                pdf,
                $"Reporte_Becas_Otorgadas_{DateTime.Now:yyyyMMdd_HHmmss}.pdf");
        });
    }

    // ============================================================
    // GENERAR PDF DE CONVOCATORIAS
    // ============================================================

    private async Task GenerarConvocatorias()
    {
        await EjecutarReporte(async () =>
        {
            var pdf = await ReportesService.GenerarConvocatoriasPdf(
                fechaInicio,
                fechaFin);

            await AbrirPdf(
                pdf,
                $"Reporte_Convocatorias_{DateTime.Now:yyyyMMdd_HHmmss}.pdf");
        });
    }

    // ============================================================
    // EJECUTAR REPORTE CON MANEJO DE ERRORES
    // ============================================================

    private async Task EjecutarReporte(Func<Task> accion)
    {
        if (fechaInicio.HasValue &&
            fechaFin.HasValue &&
            fechaInicio.Value.Date > fechaFin.Value.Date)
        {
            NotificationService.Notify(
                NotificationSeverity.Warning,
                "Fechas inválidas",
                "La fecha inicial no puede ser posterior a la fecha final.");

            return;
        }

        try
        {
            cargandoReporte = true;

            await accion();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(
                NotificationSeverity.Error,
                "Error al generar el reporte",
                $"No fue posible generar el reporte: {ex.Message}");
        }
        finally
        {
            cargandoReporte = false;
        }
    }

    // ============================================================
    // DESCARGAR PDF RECIBIDO DESDE LA API
    // ============================================================

    private async Task AbrirPdf(byte[] pdf, string nombreArchivo)
    {
        if (pdf == null || pdf.Length == 0)
        {
            NotificationService.Notify(
                NotificationSeverity.Warning,
                "PDF no disponible",
                "La API no devolvió un archivo PDF.");

            return;
        }

        var base64 = Convert.ToBase64String(pdf);

        await JS.InvokeVoidAsync(
            "descargarPdf",
            nombreArchivo,
            base64);

        NotificationService.Notify(
            NotificationSeverity.Success,
            "Reporte generado",
            $"El archivo {nombreArchivo} se descargó correctamente.");
    }
}

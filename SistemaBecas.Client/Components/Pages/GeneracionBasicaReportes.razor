@page "/generacion-reportes"

@using SistemaBecas.Client.Services.Reportes
@using SistemaBecas.Library.Dtos.Reportes

@inject IJSRuntime JS
@inject ReportesService ReportesService
@inject NavigationManager Navigation

<PageTitle>Generación de Reportes</PageTitle>

<!-- ENCABEZADO -->
<RadzenCard class="w-100 mb-4"
            Style="background: linear-gradient(135deg, #1976d2, #0d47a1); color: white;">

    <div style="padding: 20px;">

        <RadzenText Text="Generación de Reportes"
                    TextStyle="TextStyle.H4"
                    Style="color: white; font-weight: bold;" />

        <RadzenText Text="Genera y consulta los diferentes reportes del sistema de becas."
                    Style="color: white; margin-top: 5px;" />

    </div>

</RadzenCard>


<!-- ESTADÍSTICAS -->
<RadzenRow Gap="16px" class="mb-4">

    <!-- SOLICITUDES -->
    <RadzenColumn Size="12" SizeMD="3">

        <RadzenCard class="w-100"
                    Style="text-align: center; padding: 20px;">

            <RadzenText Text="20"
                        TextStyle="TextStyle.H3"
                        Style="font-weight: bold;" />

            <RadzenText Text="Solicitudes"
                        TextStyle="TextStyle.Body1" />

        </RadzenCard>

    </RadzenColumn>


    <!-- APROBADAS -->
    <RadzenColumn Size="12" SizeMD="3">

        <RadzenCard class="w-100"
                    Style="text-align: center; padding: 20px;">

            <RadzenText Text="8"
                        TextStyle="TextStyle.H3"
                        Style="font-weight: bold;" />

            <RadzenText Text="Aprobadas"
                        TextStyle="TextStyle.Body1" />

        </RadzenCard>

    </RadzenColumn>


    <!-- RECHAZADAS -->
    <RadzenColumn Size="12" SizeMD="3">

        <RadzenCard class="w-100"
                    Style="text-align: center; padding: 20px;">

            <RadzenText Text="5"
                        TextStyle="TextStyle.H3"
                        Style="font-weight: bold;" />

            <RadzenText Text="Rechazadas"
                        TextStyle="TextStyle.Body1" />

        </RadzenCard>

    </RadzenColumn>


    <!-- BECAS OTORGADAS -->
    <RadzenColumn Size="12" SizeMD="3">

        <RadzenCard class="w-100"
                    Style="text-align: center; padding: 20px;">

            <RadzenText Text="7"
                        TextStyle="TextStyle.H3"
                        Style="font-weight: bold;" />

            <RadzenText Text="Becas otorgadas"
                        TextStyle="TextStyle.Body1" />

        </RadzenCard>

    </RadzenColumn>

</RadzenRow>


<!-- FILTROS -->
<RadzenCard class="w-100 mb-4">

    <RadzenText Text="Filtros"
                TextStyle="TextStyle.H5"
                class="mb-4" />

    <RadzenRow Gap="16px">

        <!-- FECHA INICIO -->
        <RadzenColumn Size="12" SizeMD="3">

            <RadzenFormField Text="Fecha inicio"
                             class="w-100">

                <RadzenDatePicker @bind-Value="fechaInicio"
                                  DateFormat="dd/MM/yyyy"
                                  class="w-100" />

            </RadzenFormField>

        </RadzenColumn>


        <!-- FECHA FIN -->
        <RadzenColumn Size="12" SizeMD="3">

            <RadzenFormField Text="Fecha fin"
                             class="w-100">

                <RadzenDatePicker @bind-Value="fechaFin"
                                  DateFormat="dd/MM/yyyy"
                                  class="w-100" />

            </RadzenFormField>

        </RadzenColumn>


        <!-- CONVOCATORIA -->
        <RadzenColumn Size="12" SizeMD="3">

            <RadzenFormField Text="Convocatoria"
                             class="w-100">

                <RadzenDropDown @bind-Value="convocatoriaSeleccionada"
                                Data="@convocatorias"
                                TextProperty="Nombre"
                                ValueProperty="IdConvocatoria"
                                Placeholder="Seleccione..."
                                class="w-100" />

            </RadzenFormField>

        </RadzenColumn>


        <!-- ESTADO -->
        <RadzenColumn Size="12" SizeMD="3">

            <RadzenFormField Text="Estado"
                             class="w-100">

                <RadzenDropDown @bind-Value="estadoSeleccionado"
                                Data="@estados"
                                Placeholder="Seleccione..."
                                class="w-100" />

            </RadzenFormField>

        </RadzenColumn>

    </RadzenRow>

</RadzenCard>


<!-- REPORTES -->
<RadzenCard class="w-100 mb-4">

    <RadzenText Text="Reportes disponibles"
                TextStyle="TextStyle.H5"
                class="mb-4" />


    <RadzenRow Gap="16px">

        <!-- REPORTE DE SOLICITUDES -->
        <RadzenColumn Size="12" SizeMD="4">

            <RadzenCard Style="height: 100%;">

                <RadzenText Text="Reporte de solicitudes"
                            TextStyle="TextStyle.H6"
                            Style="font-weight: bold;" />

                <RadzenText Text="Consulta general de las solicitudes registradas."
                            Style="margin-top: 8px;" />

                <div style="margin-top: 20px;">

                    <RadzenButton Text="Generar"
                                  Icon="picture_as_pdf"
                                  ButtonStyle="ButtonStyle.Primary" />

                </div>

            </RadzenCard>

        </RadzenColumn>


        <!-- SOLICITUDES POR ESTADO -->
        <RadzenColumn Size="12" SizeMD="4">

            <RadzenCard Style="height: 100%;">

                <RadzenText Text="Solicitudes por estado"
                            TextStyle="TextStyle.H6"
                            Style="font-weight: bold;" />

                <RadzenText Text="Muestra las solicitudes agrupadas según su estado."
                            Style="margin-top: 8px;" />

                <div style="margin-top: 20px;">

                    <RadzenButton Text="Generar"
                                  Icon="picture_as_pdf"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="@GenerarEstadoSolicitudes"
                                  Disabled="@cargandoReporte" />

                </div>

            </RadzenCard>

        </RadzenColumn>


        <!-- SOLICITUDES POR CONVOCATORIA -->
        <RadzenColumn Size="12" SizeMD="4">

            <RadzenCard Style="height: 100%;">

                <RadzenText Text="Solicitudes por convocatoria"
                            TextStyle="TextStyle.H6"
                            Style="font-weight: bold;" />

                <RadzenText Text="Muestra la cantidad de solicitudes recibidas por cada convocatoria."
                            Style="margin-top: 8px;" />

                <div style="margin-top: 20px;">

                    <RadzenButton Text="Generar"
                                  Icon="picture_as_pdf"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="@GenerarSolicitudesPorConvocatoria"
                                  Disabled="@cargandoReporte" />

                </div>

            </RadzenCard>

        </RadzenColumn>


        <!-- REPORTE DE EVALUACIONES -->
        <RadzenColumn Size="12" SizeMD="4">

            <RadzenCard Style="height: 100%;">

                <RadzenText Text="Reporte de evaluaciones"
                            TextStyle="TextStyle.H6"
                            Style="font-weight: bold;" />

                <RadzenText Text="Consulta las evaluaciones realizadas a las solicitudes."
                            Style="margin-top: 8px;" />

                <div style="margin-top: 20px;">

                    <RadzenButton Text="Generar"
                                  Icon="picture_as_pdf"
                                  ButtonStyle="ButtonStyle.Primary" />

                </div>

            </RadzenCard>

        </RadzenColumn>


        <!-- REPORTE DE DECISIONES -->
        <RadzenColumn Size="12" SizeMD="4">

            <RadzenCard Style="height: 100%;">

                <RadzenText Text="Reporte de decisiones"
                            TextStyle="TextStyle.H6"
                            Style="font-weight: bold;" />

                <RadzenText Text="Muestra las decisiones tomadas sobre las solicitudes."
                            Style="margin-top: 8px;" />

                <div style="margin-top: 20px;">

                    <RadzenButton Text="Generar"
                                  Icon="picture_as_pdf"
                                  ButtonStyle="ButtonStyle.Primary" />

                </div>

            </RadzenCard>

        </RadzenColumn>


        <!-- REPORTE DE BECAS OTORGADAS -->
        <RadzenColumn Size="12" SizeMD="4">

            <RadzenCard Style="height: 100%;">

                <RadzenText Text="Reporte de becas otorgadas"
                            TextStyle="TextStyle.H6"
                            Style="font-weight: bold;" />

                <RadzenText Text="Consulta las becas que han sido otorgadas."
                            Style="margin-top: 8px;" />

                <div style="margin-top: 20px;">

                    
                    <RadzenButton Text="Generar"
                                  Icon="picture_as_pdf"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="@GenerarBecasOtorgadas"
                                  Disabled="@cargandoReporte" />


                </div>

            </RadzenCard>

        </RadzenColumn>

    </RadzenRow>

</RadzenCard>


<!-- RESULTADO DEL REPORTE 1 -->
@if (solicitudesPorConvocatoria.Any())
{
    <RadzenCard class="w-100 mb-4">

        <RadzenText Text="Solicitudes por convocatoria"
                    TextStyle="TextStyle.H5"
                    class="mb-4" />


        <RadzenDataGrid Data="@solicitudesPorConvocatoria"
                        TItem="SolicitudesPorConvocatoriaDto"
                        AllowPaging="true"
                        PageSize="10"
                        AllowSorting="true"
                        Responsive="true">

            <Columns>

                <!-- CONVOCATORIA -->
                <RadzenDataGridColumn TItem="SolicitudesPorConvocatoriaDto"
                                      Property="Convocatoria"
                                      Title="Convocatoria" />

                <!-- TOTAL -->
                <RadzenDataGridColumn TItem="SolicitudesPorConvocatoriaDto"
                                      Property="TotalSolicitudes"
                                      Title="Total solicitudes"
                                      TextAlign="TextAlign.Center" />

                <!-- EN EVALUACIÓN -->
                <RadzenDataGridColumn TItem="SolicitudesPorConvocatoriaDto"
                                      Property="EnEvaluacion"
                                      Title="En evaluación"
                                      TextAlign="TextAlign.Center" />

                <!-- APROBADAS -->
                <RadzenDataGridColumn TItem="SolicitudesPorConvocatoriaDto"
                                      Property="Aprobadas"
                                      Title="Aprobadas"
                                      TextAlign="TextAlign.Center" />

                <!-- RECHAZADAS -->
                <RadzenDataGridColumn TItem="SolicitudesPorConvocatoriaDto"
                                      Property="Rechazadas"
                                      Title="Rechazadas"
                                      TextAlign="TextAlign.Center" />

            </Columns>

        </RadzenDataGrid>

    </RadzenCard>
}


<!-- REPORTES GENERADOS RECIENTEMENTE -->
<RadzenCard class="w-100 mb-4">

    <RadzenText Text="Reportes generados recientemente"
                TextStyle="TextStyle.H5"
                class="mb-4" />

    <RadzenDataGrid Data="@reportesGenerados"
                    TItem="ReporteDto"
                    AllowPaging="true"
                    PageSize="10"
                    Responsive="true">

        <Columns>

            <RadzenDataGridColumn TItem="ReporteDto"
                                  Property="Nombre"
                                  Title="Reporte" />

            <RadzenDataGridColumn TItem="ReporteDto"
                                  Property="Fecha"
                                  Title="Fecha">

                <Template Context="reporte">

                    @reporte.Fecha.ToString("dd/MM/yyyy HH:mm")

                </Template>

            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="ReporteDto"
                                  Property="Usuario"
                                  Title="Usuario" />

        </Columns>

    </RadzenDataGrid>

</RadzenCard>


@code {

    // ============================================================
    // FILTROS
    // ============================================================

    private DateTime? fechaInicio;

    private DateTime? fechaFin;

    private int? convocatoriaSeleccionada;

    private string? estadoSeleccionado;


    // ============================================================
    // CONVOCATORIAS MOCK
    // ============================================================

    private List<ConvocatoriaMock> convocatorias = new()
    {
        new ConvocatoriaMock
        {
            IdConvocatoria = 1,
            Nombre = "Beca Nacional Universitaria 2026"
        },

        new ConvocatoriaMock
        {
            IdConvocatoria = 2,
            Nombre = "Beca Excelencia Académica 2026"
        },

        new ConvocatoriaMock
        {
            IdConvocatoria = 3,
            Nombre = "Beca Talento 2026"
        }
    };


    // ============================================================
    // ESTADOS MOCK
    // ============================================================

    private List<string> estados = new()
    {
        "Pendiente",
        "En revisión",
        "En evaluación",
        "Aprobada",
        "Rechazada"
    };


    // ============================================================
    // REPORTE 1
    // SOLICITUDES POR CONVOCATORIA
    // ============================================================

    private List<SolicitudesPorConvocatoriaDto>
        solicitudesPorConvocatoria = new();

    private bool cargandoReporte = false;


    // ============================================================
    // OBTENER REPORTE
    // ============================================================

    private void GenerarSolicitudesPorConvocatoria()
    {
        var url =
            "https://localhost:7088/api/Reportes/solicitudes-por-convocatoria/pdf";

        Navigation.NavigateTo(url, forceLoad: true);
    }
    
    // ============================================================
    // REPORTE 2
    // ESTADO DE SOLICITUDES
    // ============================================================

    private void GenerarEstadoSolicitudes()
    {
        var url =
            "https://localhost:7088/api/Reportes/estado-solicitudes/pdf";

        Navigation.NavigateTo(url, forceLoad: true);
    }

    //REPORTE 3

    private void GenerarBecasOtorgadas()
    {
        var url =
            "https://localhost:7088/api/Reportes/becas-otorgadas/pdf";

        Navigation.NavigateTo(url, forceLoad: true);
    }

    // ============================================================
    // REPORTES GENERADOS
    // ============================================================

    private List<ReporteDto> reportesGenerados = new()
    {
        new ReporteDto
        {
            Nombre = "Reporte de solicitudes",
            Fecha = DateTime.Now.AddMinutes(-30),
            Usuario = "Administrador"
        },

        new ReporteDto
        {
            Nombre = "Solicitudes por estado",
            Fecha = DateTime.Now.AddHours(-2),
            Usuario = "Administrador"
        },

        new ReporteDto
        {
            Nombre = "Reporte de evaluaciones",
            Fecha = DateTime.Now.AddDays(-1),
            Usuario = "Administrador"
        }
    };


    // ============================================================
    // CLASE CONVOCATORIA MOCK
    // ============================================================

    public class ConvocatoriaMock
    {
        public int IdConvocatoria { get; set; }

        public string Nombre { get; set; } = "";
    }


    // ============================================================
    // CLASE REPORTE
    // ============================================================

    public class ReporteDto
    {
        public string Nombre { get; set; } = "";

        public DateTime Fecha { get; set; }

        public string Usuario { get; set; } = "";
    }
}
@page "/recuperar-password"

@using Radzen
@using Radzen.Blazor
@using SistemaBecas.Library.Dtos

@inject NotificationService NotificationService
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Sistema de Becas - Recuperar contraseña</PageTitle>

<RadzenStack JustifyContent="JustifyContent.Center"
             AlignItems="AlignItems.Center"
             Style="min-height: 100vh; padding: 2rem; background-color: #f4f7fb;">

    <RadzenCard Variant="Variant.Outlined"
                Style="width: 100%; max-width: 450px;">

        <RadzenStack Gap="1.5rem">

            <!-- ENCABEZADO -->

            <RadzenStack Gap="0.5rem"
                         AlignItems="AlignItems.Center">

                <RadzenIcon Icon="lock_reset"
                            Style="font-size: 48px; color: #1565c0;" />

                <RadzenText Text="Recuperar contraseña"
                            TextStyle="TextStyle.H4"
                            Style="color: #1565c0; font-weight: 700; margin: 0;" />

                <RadzenText Text="Ingrese su correo electrónico"
                            Style="color: #666; margin: 0;" />

            </RadzenStack>


            <!-- CORREO -->

            <RadzenFormField Text="Correo electrónico"
                             Variant="Variant.Outlined"
                             Style="width: 100%;">

                <RadzenTextBox @bind-Value="correo"
                               Placeholder="Ingrese su correo"
                               Style="width: 100%;" />

            </RadzenFormField>


            <!-- BOTÓN -->

            <RadzenButton Text="Enviar código"
                          Icon="send"
                          ButtonStyle="ButtonStyle.Primary"
                          Size="ButtonSize.Large"
                          Click="@SolicitarCodigo"
                          Disabled="@cargando"
                          Style="width: 100%;" />


            <!-- REGRESAR -->

            <RadzenStack AlignItems="AlignItems.Center">

                <RadzenLink Text="← Regresar al inicio de sesión"
                            Path="/login" />

            </RadzenStack>

        </RadzenStack>

    </RadzenCard>


    <RadzenText Text="Sistema de Becas"
                Style="color: #666; margin: 0;" />

</RadzenStack>


@code {

    private string correo = "";

    private bool cargando = false;

    private async Task SolicitarCodigo()
    {
        if (string.IsNullOrWhiteSpace(correo))
        {
            NotificationService.Notify(
                NotificationSeverity.Warning,
                "Campo requerido",
                "Ingrese su correo electrónico.");

            return;
        }

        try
        {
            cargando = true;

            var httpClient =
                HttpClientFactory.CreateClient("Api");

            var dto = new RecuperarContraseñaDto
            {
                Correo = correo
            };

            var response =
                await httpClient.PostAsJsonAsync(
                    "api/Password/solicitar",
                    dto);

            if (!response.IsSuccessStatusCode)
            {
                NotificationService.Notify(
                    NotificationSeverity.Error,
                    "Error",
                    "No fue posible solicitar la recuperación.");

                return;
            }

            NotificationService.Notify(
                NotificationSeverity.Success,
                "Código enviado",
                "Revisa tu correo electrónico para obtener el código.");

            NavigationManager.NavigateTo(
                $"/verificar-codigo?correo={Uri.EscapeDataString(correo)}");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(
                NotificationSeverity.Error,
                "Error",
                $"No fue posible enviar el código: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }
}
@page "/consultar-estado-beca"

@using Radzen
@using Radzen.Blazor

<PageTitle>Consultar Estado de la Beca</PageTitle>

<RadzenStack Gap="1.5rem"
             Style="padding: 2rem; background-color: #f4f7fb; min-height: 100vh;">

    <!-- ENCABEZADO -->
    <RadzenCard Style="background: linear-gradient(135deg, #1565c0, #1976d2); color: white;">
        <RadzenStack Gap="0.5rem">
            <RadzenText Text="Consulta del estado de la beca"
                        TextStyle="TextStyle.H3"
                        Style="color: white; margin: 0;" />

            <RadzenText Text="Consulte el estado actual de su solicitud de beca"
                        Style="color: white; margin: 0;" />
        </RadzenStack>
    </RadzenCard>


    <!-- BUSCADOR -->
    <RadzenCard>

        <RadzenStack Gap="1rem">

            <RadzenText Text="Consultar solicitud"
                        TextStyle="TextStyle.H5"
                        Style="margin: 0;" />

            <RadzenText Text="Ingrese el número de solicitud para consultar su estado."
                        Style="margin: 0; color: #666;" />

            <RadzenRow Gap="1rem" AlignItems="AlignItems.End">

                <RadzenColumn Size="12" SizeMD="8">

                    <RadzenFormField Text="Número de solicitud"
                                     Variant="Variant.Outlined"
                                     Style="width: 100%;">

                        <RadzenTextBox @bind-Value="numeroSolicitud"
                                       Placeholder="Ej. 0001"
                                       Style="width: 100%;" />

                    </RadzenFormField>

                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="4">

                    <RadzenButton Text="Consultar"
                                  Icon="search"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Size="ButtonSize.Medium"
                                  Click="@ConsultarSolicitud"
                                  Style="width: 100%;" />

                </RadzenColumn>

            </RadzenRow>

        </RadzenStack>

    </RadzenCard>


    @if (mostrarResultado)
    {
        <!-- INFORMACIÓN DE LA SOLICITUD -->
        <RadzenCard>

            <RadzenStack Gap="1.5rem">

                <RadzenText Text="Información de la solicitud"
                            TextStyle="TextStyle.H5"
                            Style="margin: 0;" />

                <RadzenRow Gap="1.5rem">

                    <RadzenColumn Size="12" SizeMD="6">

                        <RadzenStack Gap="0.3rem">

                            <RadzenText Text="Número de solicitud"
                                        Style="font-weight: 600; color: #666; margin: 0;" />

                            <RadzenText Text="@($"#{solicitud.Numero}")"
                                        TextStyle="TextStyle.Body1"
                                        Style="margin: 0;" />

                        </RadzenStack>

                    </RadzenColumn>


                    <RadzenColumn Size="12" SizeMD="6">

                        <RadzenStack Gap="0.3rem">

                            <RadzenText Text="Estudiante"
                                        Style="font-weight: 600; color: #666; margin: 0;" />

                            <RadzenText Text="@solicitud.Estudiante"
                                        TextStyle="TextStyle.Body1"
                                        Style="margin: 0;" />

                        </RadzenStack>

                    </RadzenColumn>


                    <RadzenColumn Size="12" SizeMD="6">

                        <RadzenStack Gap="0.3rem">

                            <RadzenText Text="Convocatoria"
                                        Style="font-weight: 600; color: #666; margin: 0;" />

                            <RadzenText Text="@solicitud.Convocatoria"
                                        TextStyle="TextStyle.Body1"
                                        Style="margin: 0;" />

                        </RadzenStack>

                    </RadzenColumn>


                    <RadzenColumn Size="12" SizeMD="6">

                        <RadzenStack Gap="0.3rem">

                            <RadzenText Text="Fecha de solicitud"
                                        Style="font-weight: 600; color: #666; margin: 0;" />

                            <RadzenText Text="@solicitud.FechaSolicitud.ToString("dd/MM/yyyy")"
                                        TextStyle="TextStyle.Body1"
                                        Style="margin: 0;" />

                        </RadzenStack>

                    </RadzenColumn>

                </RadzenRow>

            </RadzenStack>

        </RadzenCard>


        <!-- ESTADO ACTUAL -->
        <RadzenCard>

            <RadzenStack Gap="1rem">

                <RadzenText Text="Estado actual"
                            TextStyle="TextStyle.H5"
                            Style="margin: 0;" />

                <RadzenStack Gap="0.8rem"
                             AlignItems="AlignItems.Start">

                    <RadzenBadge Text="@solicitud.Estado"
                                 BadgeStyle="BadgeStyle.Warning" />

                    <RadzenText Text="Su solicitud se encuentra actualmente en este estado."
                                Style="margin: 0; color: #666;" />

                </RadzenStack>

            </RadzenStack>

        </RadzenCard>


        <!-- HISTORIAL -->
        <RadzenCard>

            <RadzenStack Gap="1.5rem">

                <RadzenText Text="Historial de la solicitud"
                            TextStyle="TextStyle.H5"
                            Style="margin: 0;" />

                <RadzenStack Gap="1rem">

                    @foreach (var historial in historialSolicitud)
                    {
                        <RadzenCard Variant="Variant.Outlined">

                            <RadzenStack Gap="0.5rem">

                                <RadzenStack Orientation="Orientation.Horizontal"
                                             JustifyContent="JustifyContent.SpaceBetween"
                                             AlignItems="AlignItems.Center">

                                    <RadzenText Text="@historial.Estado"
                                                TextStyle="TextStyle.H6"
                                                Style="margin: 0;" />

                                    <RadzenBadge Text="@historial.Fecha.ToString("dd/MM/yyyy")"
                                                 BadgeStyle="BadgeStyle.Light" />

                                </RadzenStack>

                                <RadzenText Text="@historial.Descripcion"
                                            Style="margin: 0; color: #666;" />

                            </RadzenStack>

                        </RadzenCard>
                    }

                </RadzenStack>

            </RadzenStack>

        </RadzenCard>


        <!-- INFORMACIÓN DE LA BECA -->
        <RadzenCard>

            <RadzenStack Gap="1.5rem">

                <RadzenText Text="Información de la beca"
                            TextStyle="TextStyle.H5"
                            Style="margin: 0;" />

                <RadzenRow Gap="1.5rem">

                    <RadzenColumn Size="12" SizeMD="6">

                        <RadzenStack Gap="0.3rem">

                            <RadzenText Text="Estado"
                                        Style="font-weight: 600; color: #666; margin: 0;" />

                            <RadzenBadge Text="@beca.Estado"
                                         BadgeStyle="BadgeStyle.Warning" />

                        </RadzenStack>

                    </RadzenColumn>


                    <RadzenColumn Size="12" SizeMD="6">

                        <RadzenStack Gap="0.3rem">

                            <RadzenText Text="Monto"
                                        Style="font-weight: 600; color: #666; margin: 0;" />

                            <RadzenText Text="@beca.Monto"
                                        TextStyle="TextStyle.Body1"
                                        Style="margin: 0;" />

                        </RadzenStack>

                    </RadzenColumn>


                    <RadzenColumn Size="12" SizeMD="6">

                        <RadzenStack Gap="0.3rem">

                            <RadzenText Text="Fecha de inicio"
                                        Style="font-weight: 600; color: #666; margin: 0;" />

                            <RadzenText Text="@beca.FechaInicio"
                                        TextStyle="TextStyle.Body1"
                                        Style="margin: 0;" />

                        </RadzenStack>

                    </RadzenColumn>


                    <RadzenColumn Size="12" SizeMD="6">

                        <RadzenStack Gap="0.3rem">

                            <RadzenText Text="Fecha de finalización"
                                        Style="font-weight: 600; color: #666; margin: 0;" />

                            <RadzenText Text="@beca.FechaFin"
                                        TextStyle="TextStyle.Body1"
                                        Style="margin: 0;" />

                        </RadzenStack>

                    </RadzenColumn>

                </RadzenRow>

            </RadzenStack>

        </RadzenCard>
    }

</RadzenStack>


@code {

    private string numeroSolicitud = "";

    private bool mostrarResultado = false;


    private Solicitud solicitud = new()
    {
        Numero = "0001",
        Estudiante = "Juan Pérez",
        Convocatoria = "Becas Universitarias 2026",
        FechaSolicitud = new DateTime(2026, 9, 5),
        Estado = "En evaluación"
    };


    private List<Historial> historialSolicitud = new()
    {
        new Historial
        {
            Estado = "Solicitud registrada",
            Fecha = new DateTime(2026, 9, 5),
            Descripcion = "La solicitud fue registrada correctamente."
        },

        new Historial
        {
            Estado = "Documentación recibida",
            Fecha = new DateTime(2026, 9, 6),
            Descripcion = "La documentación requerida fue recibida."
        },

        new Historial
        {
            Estado = "En evaluación",
            Fecha = new DateTime(2026, 9, 7),
            Descripcion = "La solicitud se encuentra en proceso de evaluación."
        },

        new Historial
        {
            Estado = "Decisión del comité",
            Fecha = new DateTime(2026, 9, 7),
            Descripcion = "Pendiente de decisión por parte del comité evaluador."
        }
    };


    private Beca beca = new()
    {
        Estado = "Pendiente",
        Monto = "Pendiente",
        FechaInicio = "Pendiente",
        FechaFin = "Pendiente"
    };


    private void ConsultarSolicitud()
    {
        if (!string.IsNullOrWhiteSpace(numeroSolicitud))
        {
            mostrarResultado = true;
        }
    }


    public class Solicitud
    {
        public string Numero { get; set; } = "";

        public string Estudiante { get; set; } = "";

        public string Convocatoria { get; set; } = "";

        public DateTime FechaSolicitud { get; set; }

        public string Estado { get; set; } = "";
    }


    public class Historial
    {
        public string Estado { get; set; } = "";

        public DateTime Fecha { get; set; }

        public string Descripcion { get; set; } = "";
    }


    public class Beca
    {
        public string Estado { get; set; } = "";

        public string Monto { get; set; } = "";

        public string FechaInicio { get; set; } = "";

        public string FechaFin { get; set; } = "";
    }
}
@page "/registrar-estudiante"

@using Radzen
@using Radzen.Blazor

<PageTitle>Registro de estudiante</PageTitle>

<RadzenStack AlignItems="AlignItems.Center"
             Style="min-height: 100vh; padding: 2rem; background-color: #f4f7fb;">

    <RadzenCard Variant="Variant.Outlined"
                Style="width: 100%; max-width: 1100px; padding: 0; overflow: hidden;">

        <!-- ENCABEZADO -->
        <RadzenStack Gap="0.5rem"
                     AlignItems="AlignItems.Center"
                     JustifyContent="JustifyContent.Center"
                     Style="padding: 2rem; background: linear-gradient(135deg, #1565c0, #1976d2); color: white;">

            <RadzenIcon Icon="school"
                        Style="font-size: 40px; color: white;" />

            <RadzenText Text="Sistema de Becas"
                        TextStyle="TextStyle.H4"
                        Style="margin: 0; color: white; font-weight: 700;" />

            <RadzenText Text="Registro de estudiante"
                        TextStyle="TextStyle.Body1"
                        Style="margin: 0; color: white;" />

        </RadzenStack>


        <!-- CONTENIDO -->
        <RadzenStack Gap="1.5rem"
                     Style="padding: 2rem;">

            <!-- TÍTULO -->
            <RadzenStack Gap="0.25rem">

                <RadzenText Text="Datos del estudiante"
                            TextStyle="TextStyle.H5"
                            Style="margin: 0; color: #1565c0;" />

                <RadzenText Text="Complete la información solicitada para registrar al estudiante."
                            TextStyle="TextStyle.Body2"
                            Style="margin: 0; color: #666;" />

            </RadzenStack>


            <!-- NOMBRES Y APELLIDOS -->
            <RadzenRow Gap="1rem">

                <RadzenColumn Size="12" SizeMD="6">

                    <RadzenFormField Text="Nombres"
                                     Variant="Variant.Outlined"
                                     Style="width: 100%;">

                        <RadzenTextBox @bind-Value="nombres"
                                       Placeholder="Ingrese los nombres"
                                       Style="width: 100%;" />

                    </RadzenFormField>

                </RadzenColumn>


                <RadzenColumn Size="12" SizeMD="6">

                    <RadzenFormField Text="Apellidos"
                                     Variant="Variant.Outlined"
                                     Style="width: 100%;">

                        <RadzenTextBox @bind-Value="apellidos"
                                       Placeholder="Ingrese los apellidos"
                                       Style="width: 100%;" />

                    </RadzenFormField>

                </RadzenColumn>

            </RadzenRow>


            <!-- DPI Y FECHA DE NACIMIENTO -->
            <RadzenRow Gap="1rem">

                <RadzenColumn Size="12" SizeMD="6">

                    <RadzenFormField Text="DPI"
                                     Variant="Variant.Outlined"
                                     Style="width: 100%;">

                        <RadzenTextBox @bind-Value="dpi"
                                       Placeholder="Ingrese el número de DPI"
                                       Style="width: 100%;" />

                    </RadzenFormField>

                </RadzenColumn>


                <RadzenColumn Size="12" SizeMD="6">

                    <RadzenFormField Text="Fecha de nacimiento"
                                     Variant="Variant.Outlined"
                                     Style="width: 100%;">

                        <RadzenDatePicker @bind-Value="fechaNacimiento"
                                          DateFormat="dd/MM/yyyy"
                                          Placeholder="Seleccione la fecha"
                                          Style="width: 100%;" />

                    </RadzenFormField>

                </RadzenColumn>

            </RadzenRow>


            <!-- CORREO Y TELÉFONO -->
            <RadzenRow Gap="1rem">

                <RadzenColumn Size="12" SizeMD="6">

                    <RadzenFormField Text="Correo electrónico"
                                     Variant="Variant.Outlined"
                                     Style="width: 100%;">

                        <RadzenTextBox @bind-Value="correo"
                                       Placeholder="ejemplo@correo.com"
                                       Style="width: 100%;" />

                    </RadzenFormField>

                </RadzenColumn>


                <RadzenColumn Size="12" SizeMD="6">

                    <RadzenFormField Text="Teléfono"
                                     Variant="Variant.Outlined"
                                     Style="width: 100%;">

                        <RadzenTextBox @bind-Value="telefono"
                                       Placeholder="Ingrese el teléfono"
                                       Style="width: 100%;" />

                    </RadzenFormField>

                </RadzenColumn>

            </RadzenRow>


            <!-- DIRECCIÓN -->
            <RadzenFormField Text="Dirección"
                             Variant="Variant.Outlined"
                             Style="width: 100%;">

                <RadzenTextArea @bind-Value="direccion"
                                Rows="3"
                                Placeholder="Ingrese la dirección del estudiante"
                                Style="width: 100%;" />

            </RadzenFormField>


            <!-- ESTADO -->
            <RadzenFormField Text="Estado"
                             Variant="Variant.Outlined"
                             Style="width: 100%;">

                <RadzenDropDown @bind-Value="estadoSeleccionado"
                                Data="@estados"
                                Placeholder="Seleccione un estado"
                                Style="width: 100%;" />

            </RadzenFormField>


            <!-- BOTONES -->
            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.End"
                         Gap="0.75rem">

                <RadzenButton Text="Cancelar"
                              ButtonStyle="ButtonStyle.Light"
                              Variant="Variant.Outlined"
                              Icon="close" />

                <RadzenButton Text="Registrar estudiante"
                              ButtonStyle="ButtonStyle.Primary"
                              Icon="save" />

            </RadzenStack>


            <!-- SEGURIDAD -->
            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.Center"
                         Gap="0.5rem">

                <RadzenIcon Icon="lock"
                            Style="color: #666;" />

                <RadzenText Text="Información protegida"
                            TextStyle="TextStyle.Body2"
                            Style="margin: 0; color: #666;" />

            </RadzenStack>

        </RadzenStack>

    </RadzenCard>


    <!-- PIE -->
    <RadzenText Text="Sistema de Becas"
                TextStyle="TextStyle.Body2"
                Style="color: #666; margin-top: 1rem;" />

</RadzenStack>


@code {

    // Datos del estudiante
    private string nombres = string.Empty;

    private string apellidos = string.Empty;

    private string dpi = string.Empty;

    private DateTime? fechaNacimiento;

    private string correo = string.Empty;

    private string telefono = string.Empty;

    private string direccion = string.Empty;


    // Estado
    private string? estadoSeleccionado;

    private List<string> estados = new()
    {
        "Activo",
        "Inactivo"
    };

}
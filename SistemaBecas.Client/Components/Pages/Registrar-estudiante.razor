@page "/registrar-estudiante"

<PageTitle>Registro de estudiante</PageTitle>

<div class="container-fluid py-4">

    <div class="row justify-content-center">

        <div class="col-12 col-lg-10">

            <RadzenCard Variant="Variant.Outlined"
                        Style="width:100%; padding:0;">

                <!-- ENCABEZADO -->
                <RadzenStack Orientation="Orientation.Vertical"
                             AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.Center"
                             Gap="0.5rem"
                             class="bg-primary text-white p-4 rounded-top">

                    <RadzenIcon Icon="school"
                                Style="font-size:40px;" />

                    <RadzenText TextStyle="TextStyle.H4"
                                class="mb-0 text-white">
                        Sistema de Becas
                    </RadzenText>

                    <RadzenText TextStyle="TextStyle.Body1"
                                class="mb-0 text-white">
                        Registro de estudiante
                    </RadzenText>

                </RadzenStack>


                <!-- CONTENIDO -->
                <RadzenStack Gap="1.5rem"
                             class="p-4">

                    <!-- TÍTULO -->
                    <RadzenStack Gap="0.25rem">

                        <RadzenText TextStyle="TextStyle.H5"
                                    class="text-primary">
                            Datos del estudiante
                        </RadzenText>

                        <RadzenText TextStyle="TextStyle.Body2"
                                    class="text-muted">
                            Complete la información solicitada para registrar al estudiante.
                        </RadzenText>

                    </RadzenStack>


                    <!-- NOMBRES Y APELLIDOS -->
                    <RadzenRow Gap="1rem">

                        <RadzenColumn Size="12"
                                      SizeMD="6">

                            <RadzenFormField Text="Nombres"
                                             Variant="Variant.Outlined"
                                             Style="width:100%;">

                                <RadzenTextBox @bind-Value="nombres"
                                               Placeholder="Ingrese los nombres"
                                               Style="width:100%;" />

                            </RadzenFormField>

                        </RadzenColumn>


                        <RadzenColumn Size="12"
                                      SizeMD="6">

                            <RadzenFormField Text="Apellidos"
                                             Variant="Variant.Outlined"
                                             Style="width:100%;">

                                <RadzenTextBox @bind-Value="apellidos"
                                               Placeholder="Ingrese los apellidos"
                                               Style="width:100%;" />

                            </RadzenFormField>

                        </RadzenColumn>

                    </RadzenRow>


                    <!-- DPI Y FECHA DE NACIMIENTO -->
                    <RadzenRow Gap="1rem">

                        <RadzenColumn Size="12"
                                      SizeMD="6">

                            <RadzenFormField Text="DPI"
                                             Variant="Variant.Outlined"
                                             Style="width:100%;">

                                <RadzenTextBox @bind-Value="dpi"
                                               Placeholder="Ingrese el número de DPI"
                                               Style="width:100%;" />

                            </RadzenFormField>

                        </RadzenColumn>


                        <RadzenColumn Size="12"
                                      SizeMD="6">

                            <RadzenFormField Text="Fecha de nacimiento"
                                             Variant="Variant.Outlined"
                                             Style="width:100%;">

                                <RadzenDatePicker @bind-Value="fechaNacimiento"
                                                  DateFormat="dd/MM/yyyy"
                                                  Placeholder="Seleccione la fecha"
                                                  Style="width:100%;" />

                            </RadzenFormField>

                        </RadzenColumn>

                    </RadzenRow>


                    <!-- CORREO Y TELÉFONO -->
                    <RadzenRow Gap="1rem">

                        <RadzenColumn Size="12"
                                      SizeMD="6">

                            <RadzenFormField Text="Correo electrónico"
                                             Variant="Variant.Outlined"
                                             Style="width:100%;">

                                <RadzenTextBox @bind-Value="correo"
                                               Placeholder="ejemplo@correo.com"
                                               Style="width:100%;" />

                            </RadzenFormField>

                        </RadzenColumn>


                        <RadzenColumn Size="12"
                                      SizeMD="6">

                            <RadzenFormField Text="Teléfono"
                                             Variant="Variant.Outlined"
                                             Style="width:100%;">

                                <RadzenTextBox @bind-Value="telefono"
                                               Placeholder="Ingrese el teléfono"
                                               Style="width:100%;" />

                            </RadzenFormField>

                        </RadzenColumn>

                    </RadzenRow>


                    <!-- DIRECCIÓN -->
                    <RadzenFormField Text="Dirección"
                                     Variant="Variant.Outlined"
                                     Style="width:100%;">

                        <RadzenTextArea @bind-Value="direccion"
                                        Rows="3"
                                        Placeholder="Ingrese la dirección del estudiante"
                                        Style="width:100%;" />

                    </RadzenFormField>


                    <!-- ESTADO -->
                    <RadzenFormField Text="Estado"
                                     Variant="Variant.Outlined"
                                     Style="width:100%;">

                        <RadzenDropDown @bind-Value="estadoSeleccionado"
                                        Data="@estados"
                                        Placeholder="Seleccione un estado"
                                        Style="width:100%;" />

                    </RadzenFormField>


                    <!-- BOTONES -->
                    <RadzenStack Orientation="Orientation.Horizontal"
                                 JustifyContent="JustifyContent.End"
                                 Gap="0.75rem">

                        <RadzenButton Text="Cancelar"
                                      ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Outlined"
                                      Icon="close" />

                        <RadzenButton Text="Registrar estudiante"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Icon="save" />

                    </RadzenStack>


                    <!-- SEGURIDAD -->
                    <RadzenStack Orientation="Orientation.Horizontal"
                                 AlignItems="AlignItems.Center"
                                 JustifyContent="JustifyContent.Center"
                                 Gap="0.5rem"
                                 class="text-muted">

                        <RadzenIcon Icon="lock" />

                        <RadzenText TextStyle="TextStyle.Body2">
                            Información protegida
                        </RadzenText>

                    </RadzenStack>

                </RadzenStack>

            </RadzenCard>


            <!-- PIE -->
            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.Center"
                         class="mt-3">

                <RadzenText TextStyle="TextStyle.Body2"
                            class="text-muted">
                    Sistema de Becas
                </RadzenText>

            </RadzenStack>

        </div>

    </div>

</div>


@code {

    // Datos del estudiante
    private string nombres = string.Empty;
    private string apellidos = string.Empty;
    private string dpi = string.Empty;
    private DateTime? fechaNacimiento;
    private string correo = string.Empty;
    private string telefono = string.Empty;
    private string direccion = string.Empty;

    // Estado
    private string? estadoSeleccionado;

    private List<string> estados = new()
    {
        "Activo",
        "Inactivo"
    };

}
@page "/login"

@using Radzen
@using Radzen.Blazor
@using SistemaBecas.Client.Services.Login
@using SistemaBecas.Library.Dtos
@using SistemaBecas.Client.Services.Authentication
@using Microsoft.AspNetCore.Components.Authorization

@inject CustomAuthenticationStateProvider AuthenticationStateProvider
@inject NotificationService NotificationService
@inject ILoginService loginservice
@inject NavigationManager NavigationManager
@inject TokenService TokenService
@inject IJSRuntime JSRuntime


<PageTitle>Sistema de Becas - Login</PageTitle>

<RadzenStack JustifyContent="JustifyContent.Center"
             AlignItems="AlignItems.Center"
             Style="min-height: 100vh; padding: 2rem; background-color: #f4f7fb;">

    <!-- TARJETA DE LOGIN -->
    <RadzenCard Variant="Variant.Outlined"
                Style="width: 100%; max-width: 450px;">

        <RadzenStack Gap="1.5rem">

            <!-- ENCABEZADO -->
            <RadzenStack Gap="0.5rem"
                         AlignItems="AlignItems.Center">

                <RadzenIcon Icon="school"
                            Style="font-size: 48px; color: #1565c0;" />

                <RadzenText Text="Sistema de Becas"
                            TextStyle="TextStyle.H4"
                            Style="color: #1565c0; font-weight: 700; margin: 0;" />

                <RadzenText Text="Ingrese sus datos para acceder"
                            Style="color: #666; margin: 0;" />

            </RadzenStack>


            <!-- CORREO -->
            <RadzenFormField Text="Correo electrónico"
                             Variant="Variant.Outlined"
                             Style="width: 100%;">

                <RadzenTextBox @bind-Value="correo"
                               Placeholder="Ingrese su correo"
                               Style="width: 100%;" />

            </RadzenFormField>


            <!-- CONTRASEÑA -->
            <RadzenFormField Text="Contraseña"
                             Variant="Variant.Outlined"
                             Style="width: 100%;">

                <RadzenPassword @bind-Value="password"
                                Placeholder="Ingrese su contraseña"
                                Style="width: 100%;" />

            </RadzenFormField>


            <!-- BOTÓN -->
            <RadzenButton Text="Iniciar sesión"
                          Icon="login"
                          ButtonStyle="ButtonStyle.Primary"
                          Size="ButtonSize.Large"
                          Click="@IniciarSesion"
                          Style="width: 100%;" />


            <!-- SEGURIDAD -->
            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.Center"
                         AlignItems="AlignItems.Center"
                         Gap="0.5rem">

                <RadzenIcon Icon="lock"
                            Style="font-size: 18px; color: #666;" />

                <RadzenText Text="Acceso seguro"
                            Style="color: #666; margin: 0;" />

            </RadzenStack>


            <!-- RECUPERAR CONTRASEÑA -->
            <RadzenStack AlignItems="AlignItems.Center"
                         Gap="0.5rem">

                <RadzenLink Text="¿Olvidaste tu contraseña?"
                            Path="/recuperar-password" />

                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             Gap="0.3rem">

                    <RadzenText Text="¿No tienes una cuenta?"
                                Style="margin: 0; color: #666;" />

                    <RadzenLink Text="Regístrate"
                                Path="/registro-estudiante" />

                </RadzenStack>

            </RadzenStack>

        </RadzenStack>

    </RadzenCard>


    <!-- PIE -->
    <RadzenText Text="Sistema de Becas"
                Style="color: #666; margin: 0;" />

</RadzenStack>


@code {

    private string correo = "";

    private string password = "";

    private bool cargando = false;

    private async Task IniciarSesion()
    {
        if (string.IsNullOrWhiteSpace(correo) ||
            string.IsNullOrWhiteSpace(password))
        {
            NotificationService.Notify(
                NotificationSeverity.Warning,
                "Campos requeridos",
                "Ingrese su correo y contraseña.");

            return;
        }

        try
        {
            cargando = true;

            var loginDto = new LoginPeticiónDto
            {
                Correo = correo,
                Password = password
            };

            var resultado = await loginservice.LoginAsync(loginDto);


            if (resultado == null)
            {
                NotificationService.Notify(
                    NotificationSeverity.Error,
                    "Error de inicio de sesión",
                    "Correo o contraseña incorrectos.");

                return;
            }
            await AuthenticationStateProvider.IniciarSesion(
    resultado.Token);

            TokenService.GuardarToken(resultado.Token);

            Console.WriteLine("================================");
            Console.WriteLine("TOKEN GUARDADO DESDE LOGIN");
            Console.WriteLine(
                $"TOKEN EN TOKEN SERVICE: {!string.IsNullOrWhiteSpace(TokenService.ObtenerToken())}");
            Console.WriteLine("================================");


            NotificationService.Notify(
                NotificationSeverity.Success,
                "Bienvenido",
                $"Hola {resultado.Usuario.Nombres}");


            NavigationManager.NavigateTo("/");

        }
        catch (Exception ex)
        {
            NotificationService.Notify(
                NotificationSeverity.Error,
                "Error",
                $"No fue posible iniciar sesión: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }

}
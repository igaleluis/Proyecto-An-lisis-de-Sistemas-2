@page "/login"

@using Radzen
@using Radzen.Blazor

<PageTitle>Sistema de Becas - Login</PageTitle>

<RadzenStack JustifyContent="JustifyContent.Center"
             AlignItems="AlignItems.Center"
             Style="min-height: 100vh; padding: 2rem; background-color: #f4f7fb;">

    <!-- TARJETA DE LOGIN -->
    <RadzenCard Variant="Variant.Outlined"
                Style="width: 100%; max-width: 450px;">

        <RadzenStack Gap="1.5rem">

            <!-- ENCABEZADO -->
            <RadzenStack Gap="0.5rem"
                         AlignItems="AlignItems.Center">

                <RadzenIcon Icon="school"
                            Style="font-size: 48px; color: #1565c0;" />

                <RadzenText Text="Sistema de Becas"
                            TextStyle="TextStyle.H4"
                            Style="color: #1565c0; font-weight: 700; margin: 0;" />

                <RadzenText Text="Ingrese sus datos para acceder"
                            Style="color: #666; margin: 0;" />

            </RadzenStack>


            <!-- CORREO -->
            <RadzenFormField Text="Correo electrónico"
                             Variant="Variant.Outlined"
                             Style="width: 100%;">

                <RadzenTextBox @bind-Value="correo"
                               Placeholder="Ingrese su correo"
                               Style="width: 100%;" />

            </RadzenFormField>


            <!-- CONTRASEÑA -->
            <RadzenFormField Text="Contraseña"
                             Variant="Variant.Outlined"
                             Style="width: 100%;">

                <RadzenPassword @bind-Value="password"
                                Placeholder="Ingrese su contraseña"
                                Style="width: 100%;" />

            </RadzenFormField>


            <!-- BOTÓN -->
            <RadzenButton Text="Iniciar sesión"
                          Icon="login"
                          ButtonStyle="ButtonStyle.Primary"
                          Size="ButtonSize.Large"
                          Click="@IniciarSesion"
                          Style="width: 100%;" />


            <!-- SEGURIDAD -->
            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.Center"
                         AlignItems="AlignItems.Center"
                         Gap="0.5rem">

                <RadzenIcon Icon="lock"
                            Style="font-size: 18px; color: #666;" />

                <RadzenText Text="Acceso seguro"
                            Style="color: #666; margin: 0;" />

            </RadzenStack>


            <!-- RECUPERAR CONTRASEÑA -->
            <RadzenStack AlignItems="AlignItems.Center">

                <RadzenLink Text="¿Olvidaste tu contraseña?"
                            Path="#" />

            </RadzenStack>

        </RadzenStack>

    </RadzenCard>


    <!-- PIE -->
    <RadzenText Text="Sistema de Becas"
                Style="color: #666; margin: 0;" />

</RadzenStack>


@code {

    private string correo = "";

    private string password = "";


    private void IniciarSesion()
    {
        // Por ahora solamente es el prototipo.
        // La validación con la base de datos
        // se conectará posteriormente.
    }

}
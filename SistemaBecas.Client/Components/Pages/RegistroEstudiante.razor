
@page "/registro-estudiante"

@using Radzen
@using Radzen.Blazor
@using SistemaBecas.Library.Dtos
@using SistemaBecas.Client.Services.RegistroService
@using System.ComponentModel.DataAnnotations

@inject IRegistroService RegistroService
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService

<PageTitle>Registro de estudiante - Sistema de Becas</PageTitle>

<RadzenStack JustifyContent="JustifyContent.Center"
             AlignItems="AlignItems.Center"
             Style="min-height: 100vh; padding: 2rem; background-color: #f4f7fb;">

    <RadzenCard Variant="Variant.Outlined"
                Style="width: 100%; max-width: 550px;">

        <RadzenStack Gap="1.5rem">

            @* ENCABEZADO *@
            <RadzenStack Gap="0.5rem"
                         AlignItems="AlignItems.Center">

                <RadzenIcon Icon="school"
                            Style="font-size: 48px; color: #1565c0;" />

                <RadzenText Text="Registro de estudiante"
                            TextStyle="TextStyle.H4"
                            Style="color: #1565c0; font-weight: 700; margin: 0; text-align: center;" />

                <RadzenText Text="Crea tu cuenta para solicitar y gestionar tus becas."
                            Style="color: #666; margin: 0; text-align: center;" />

            </RadzenStack>

            @* AVISO *@
            <RadzenAlert AlertStyle="AlertStyle.Info"
                         Variant="Variant.Flat"
                         AllowClose="false">

                <strong>Registro exclusivo para estudiantes</strong>
                <br />
                Completa tus datos personales para crear tu cuenta en el Sistema de Becas.

            </RadzenAlert>

            @* FORMULARIO *@
            <RadzenTemplateForm TItem="RegistroEstudianteDto"
                                Data="@registro"
                                Submit="@Registrar">

                @* DATOS PERSONALES *@
                <RadzenText Text="Datos personales"
                            TextStyle="TextStyle.H6"
                            Style="font-weight: 600; margin-bottom: 15px;" />

                @* NOMBRES *@
                <RadzenFormField Text="Nombres"
                                 Variant="Variant.Outlined"
                                 Style="width: 100%; margin-bottom: 18px;">

                    <RadzenTextBox @bind-Value="@registro.Nombres"
                                   Name="Nombres"
                                   Style="width: 100%;"
                                   Placeholder="Ingresa tus nombres"
                                   MaxLength="100" />

                    <RadzenRequiredValidator Component="Nombres"
                                              Text="Los nombres son obligatorios."
                                              Popup="true" />
                </RadzenFormField>

                @* APELLIDOS *@
                <RadzenFormField Text="Apellidos"
                                 Variant="Variant.Outlined"
                                 Style="width: 100%; margin-bottom: 18px;">

                    <RadzenTextBox @bind-Value="@registro.Apellidos"
                                   Name="Apellidos"
                                   Style="width: 100%;"
                                   Placeholder="Ingresa tus apellidos"
                                   MaxLength="100" />

                    <RadzenRequiredValidator Component="Apellidos"
                                              Text="Los apellidos son obligatorios."
                                              Popup="true" />
                </RadzenFormField>

                @* DPI *@
                <RadzenFormField Text="DPI"
                                 Variant="Variant.Outlined"
                                 Style="width: 100%; margin-bottom: 18px;">

                    <RadzenTextBox @bind-Value="@registro.DPI"
                                   Name="DPI"
                                   Style="width: 100%;"
                                   Placeholder="Ingresa tu número de DPI"
                                   MaxLength="20" />

                    <RadzenRequiredValidator Component="DPI"
                                              Text="El DPI es obligatorio."
                                              Popup="true" />
                </RadzenFormField>

                @* FECHA DE NACIMIENTO *@
                <RadzenFormField Text="Fecha de nacimiento"
                                 Variant="Variant.Outlined"
                                 Style="width: 100%; margin-bottom: 18px;">

                    <RadzenDatePicker @bind-Value="@fechaNacimiento"
                                      Name="FechaNacimiento"
                                      DateFormat="dd/MM/yyyy"
                                      Max="@DateTime.Today"
                                      Style="width: 100%;"
                                      Placeholder="Selecciona tu fecha de nacimiento" />

                    <RadzenRequiredValidator Component="FechaNacimiento"
                                              Text="La fecha de nacimiento es obligatoria."
                                              Popup="true" />
                </RadzenFormField>

                @* TELÉFONO OPCIONAL *@
                <RadzenFormField Text="Teléfono (opcional)"
                                 Variant="Variant.Outlined"
                                 Style="width: 100%; margin-bottom: 18px;">

                    <RadzenTextBox @bind-Value="@registro.Telefono"
                                   Name="Telefono"
                                   Style="width: 100%;"
                                   Placeholder="Ingresa tu teléfono"
                                   MaxLength="30" />
                </RadzenFormField>

                @* DIRECCIÓN OPCIONAL *@
                <RadzenFormField Text="Dirección (opcional)"
                                 Variant="Variant.Outlined"
                                 Style="width: 100%; margin-bottom: 18px;">

                    <RadzenTextBox @bind-Value="@registro.Direccion"
                                   Name="Direccion"
                                   Style="width: 100%;"
                                   Placeholder="Ingresa tu dirección"
                                   MaxLength="255" />
                </RadzenFormField>

                <RadzenDivider />

                @* DATOS DE LA CUENTA *@
                <RadzenText Text="Datos de la cuenta"
                            TextStyle="TextStyle.H6"
                            Style="font-weight: 600; margin-bottom: 15px;" />

                @* CORREO *@
                <RadzenFormField Text="Correo electrónico"
                                 Variant="Variant.Outlined"
                                 Style="width: 100%; margin-bottom: 18px;">

                    <RadzenTextBox @bind-Value="@registro.Correo"
                                   Name="Correo"
                                   Style="width: 100%;"
                                   Placeholder="ejemplo@correo.com"
                                   MaxLength="150" />

                    <RadzenRequiredValidator Component="Correo"
                                              Text="El correo es obligatorio."
                                              Popup="true" />

                    <RadzenEmailValidator Component="Correo"
                                          Text="Ingresa un correo válido."
                                          Popup="true" />
                </RadzenFormField>

                @* CONTRASEÑA *@
                <RadzenFormField Text="Contraseña"
                                 Variant="Variant.Outlined"
                                 Style="width: 100%; margin-bottom: 18px;">

                    <RadzenPassword @bind-Value="@registro.Password"
                                    Name="Password"
                                    Style="width: 100%;"
                                    Placeholder="Mínimo 8 caracteres" />

                    <RadzenRequiredValidator Component="Password"
                                              Text="La contraseña es obligatoria."
                                              Popup="true" />
                </RadzenFormField>

                @* CONFIRMAR CONTRASEÑA *@
                <RadzenFormField Text="Confirmar contraseña"
                                 Variant="Variant.Outlined"
                                 Style="width: 100%; margin-bottom: 25px;">

                    <RadzenPassword @bind-Value="@confirmarPassword"
                                    Name="ConfirmarPassword"
                                    Style="width: 100%;"
                                    Placeholder="Repite tu contraseña" />

                    <RadzenRequiredValidator Component="ConfirmarPassword"
                                              Text="Confirma tu contraseña."
                                              Popup="true" />
                </RadzenFormField>

                @* BOTÓN REGISTRAR *@
                <RadzenButton Text="@(registrando ? "Creando cuenta..." : "Crear cuenta de estudiante")"
                              Icon="person_add"
                              ButtonType="ButtonType.Submit"
                              ButtonStyle="ButtonStyle.Primary"
                              Size="ButtonSize.Large"
                              Style="width: 100%;"
                              Disabled="@registrando" />

            </RadzenTemplateForm>

            @* VOLVER AL LOGIN *@
            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.Center"
                         AlignItems="AlignItems.Center"
                         Gap="0.3rem">

                <RadzenText Text="¿Ya tienes una cuenta?"
                            Style="margin: 0; color: #666;" />

                <RadzenLink Text="Iniciar sesión"
                            Path="/login" />

            </RadzenStack>

        </RadzenStack>

    </RadzenCard>

    @* PIE *@
    <RadzenText Text="Sistema de Becas"
                Style="color: #666; margin: 0;" />

</RadzenStack>

@code {
    private RegistroEstudianteDto registro = new();

    private string confirmarPassword = string.Empty;

    private DateTime? fechaNacimiento;

    private bool registrando = false;

    private async Task Registrar(RegistroEstudianteDto registro)
    {
        if (string.IsNullOrWhiteSpace(registro.Nombres) ||
            string.IsNullOrWhiteSpace(registro.Apellidos) ||
            string.IsNullOrWhiteSpace(registro.Correo) ||
            string.IsNullOrWhiteSpace(registro.DPI))
        {
            NotificationService.Notify(
                NotificationSeverity.Warning,
                "Datos incompletos",
                "Completa todos los campos obligatorios.");

            return;
        }

        if (string.IsNullOrWhiteSpace(registro.DPI))
        {
            NotificationService.Notify(
                NotificationSeverity.Warning,
                "DPI",
                "Ingresa tu número de DPI.");

            return;
        }

        if (!fechaNacimiento.HasValue)
        {
            NotificationService.Notify(
                NotificationSeverity.Warning,
                "Fecha de nacimiento",
                "Selecciona tu fecha de nacimiento.");

            return;
        }

        if (fechaNacimiento.Value.Date > DateTime.Today)
        {
            NotificationService.Notify(
                NotificationSeverity.Warning,
                "Fecha de nacimiento",
                "La fecha de nacimiento no puede ser futura.");

            return;
        }

        if (string.IsNullOrWhiteSpace(registro.Password))
        {
            NotificationService.Notify(
                NotificationSeverity.Warning,
                "Contraseña",
                "Ingresa una contraseña.");

            return;
        }

        if (registro.Password.Length < 8)
        {
            NotificationService.Notify(
                NotificationSeverity.Warning,
                "Contraseña",
                "La contraseña debe tener al menos 8 caracteres.");

            return;
        }

        if (registro.Password != confirmarPassword)
        {
            NotificationService.Notify(
                NotificationSeverity.Warning,
                "Contraseñas",
                "Las contraseñas no coinciden.");

            return;
        }

        try
        {
            registrando = true;

            // Transferir la fecha seleccionada al DTO
            registro.FechaNacimiento = fechaNacimiento.Value.Date;

            var resultado =
                await RegistroService.RegistrarEstudiante(registro);

            if (resultado == null)
            {
                NotificationService.Notify(
                    NotificationSeverity.Error,
                    "Registro",
                    "No fue posible crear la cuenta. Verifica los datos e inténtalo nuevamente.");

                return;
            }

            NotificationService.Notify(
                NotificationSeverity.Success,
                "Cuenta creada",
                "Tu cuenta de estudiante fue creada correctamente.");

            await Task.Delay(1200);

            NavigationManager.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(
                NotificationSeverity.Error,
                "Error de registro",
                ex.Message);
        }
        finally
        {
            registrando = false;
        }
    }
}

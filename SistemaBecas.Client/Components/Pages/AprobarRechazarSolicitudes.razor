@page "/aprobar-rechazar-solicitudes"


@using Radzen
@using Radzen.Blazor
@using SistemaBecas.Client.Services
@using SistemaBecas.Library.Dtos
@inject GestionApiClient Api
@inject NotificationService Notifications

<PageTitle>Administración de Solicitudes</PageTitle>

<RadzenStack Gap="1.5rem"
             Style="padding: 2rem; background-color: #f4f7fb; min-height: 100vh;">

    <!-- ====================================================== -->
    <!-- ENCABEZADO                                             -->
    <!-- ====================================================== -->

    <RadzenCard Style="
        background: linear-gradient(135deg, #1565c0, #1e88e5);
        color: white;
        border-radius: 16px;
        border: none;
        padding: 2rem;">

        <RadzenRow AlignItems="AlignItems.Center">

            <RadzenColumn Size="12" SizeMD="8">

                <RadzenText Text="Administración de Solicitudes"
                            TextStyle="TextStyle.H4"
                            Style="
                color: white;
                font-weight: 700;
                margin-bottom: 6px;" />

                <RadzenText Text="Revise, evalúe y gestione las solicitudes de becas"
                            Style="
                color: rgba(255,255,255,0.9);
                font-size: 15px;" />

            </RadzenColumn>

            <RadzenColumn Size="12"
                          SizeMD="4"
                          Style="text-align: right;">

                <RadzenButton Text="Actualizar"
                              Icon="refresh"
                              ButtonStyle="ButtonStyle.Light"
                              Click="@CargarSolicitudesAsync" />

            </RadzenColumn>

        </RadzenRow>

    </RadzenCard>


    <!-- ====================================================== -->
    <!-- ESTADÍSTICAS                                           -->
    <!-- ====================================================== -->

    <RadzenRow>

        <!-- PENDIENTES -->

        <RadzenColumn Size="12" SizeMD="3">

            <RadzenCard Style="
                border-radius: 12px;
                border: 1px solid #e5e7eb;">

                <RadzenRow AlignItems="AlignItems.Center">

                    <RadzenColumn Size="8">

                        <RadzenText Text="Pendientes"
                                    Style="
                        color: #6b7280;
                        font-size: 13px;" />

                        <RadzenText Text="@solicitudes.Count(s => s.Estado == "Pendiente").ToString()"
                                    TextStyle="TextStyle.H4"
                                    Style="
                        color: #1565c0;
                        font-weight: 700;
                        margin-top: 5px;" />

                    </RadzenColumn>

                    <RadzenColumn Size="4"
                                  Style="text-align: right;">

                        <RadzenIcon Icon="pending_actions"
                                    Style="
                        font-size: 38px;
                        color: #1565c0;" />

                    </RadzenColumn>

                </RadzenRow>

            </RadzenCard>

        </RadzenColumn>


        <!-- EN REVISIÓN -->

        <RadzenColumn Size="12" SizeMD="3">

            <RadzenCard Style="
                border-radius: 12px;
                border: 1px solid #e5e7eb;">

                <RadzenRow AlignItems="AlignItems.Center">

                    <RadzenColumn Size="8">

                        <RadzenText Text="En revisión"
                                    Style="
                        color: #6b7280;
                        font-size: 13px;" />

                        <RadzenText Text="@solicitudes.Count(s => s.Estado == "En revisión").ToString()"
                                    TextStyle="TextStyle.H4"
                                    Style="
                        color: #64b5f6;
                        font-weight: 700;
                        margin-top: 5px;" />

                    </RadzenColumn>

                    <RadzenColumn Size="4"
                                  Style="text-align: right;">

                        <RadzenIcon Icon="search"
                                    Style="
                        font-size: 38px;
                        color: #64b5f6;" />

                    </RadzenColumn>

                </RadzenRow>

            </RadzenCard>

        </RadzenColumn>


        <!-- APROBADAS -->

        <RadzenColumn Size="12" SizeMD="3">

            <RadzenCard Style="
                border-radius: 12px;
                border: 1px solid #e5e7eb;">

                <RadzenRow AlignItems="AlignItems.Center">

                    <RadzenColumn Size="8">

                        <RadzenText Text="Aprobadas"
                                    Style="
                        color: #6b7280;
                        font-size: 13px;" />

                        <RadzenText Text="@solicitudes.Count(s => s.Estado == "Aprobada").ToString()"
                                    TextStyle="TextStyle.H4"
                                    Style="
                        color: #2e7d32;
                        font-weight: 700;
                        margin-top: 5px;" />

                    </RadzenColumn>

                    <RadzenColumn Size="4"
                                  Style="text-align: right;">

                        <RadzenIcon Icon="check_circle"
                                    Style="
                        font-size: 38px;
                        color: #2e7d32;" />

                    </RadzenColumn>

                </RadzenRow>

            </RadzenCard>

        </RadzenColumn>


        <!-- RECHAZADAS -->

        <RadzenColumn Size="12" SizeMD="3">

            <RadzenCard Style="
                border-radius: 12px;
                border: 1px solid #e5e7eb;">

                <RadzenRow AlignItems="AlignItems.Center">

                    <RadzenColumn Size="8">

                        <RadzenText Text="Rechazadas"
                                    Style="
                        color: #6b7280;
                        font-size: 13px;" />

                        <RadzenText Text="@solicitudes.Count(s => s.Estado == "Rechazada").ToString()"
                                    TextStyle="TextStyle.H4"
                                    Style="
                        color: #c62828;
                        font-weight: 700;
                        margin-top: 5px;" />

                    </RadzenColumn>

                    <RadzenColumn Size="4"
                                  Style="text-align: right;">

                        <RadzenIcon Icon="cancel"
                                    Style="
                        font-size: 38px;
                        color: #c62828;" />

                    </RadzenColumn>

                </RadzenRow>

            </RadzenCard>

        </RadzenColumn>

    </RadzenRow>


    <!-- ====================================================== -->
    <!-- FILTROS                                                -->
    <!-- ====================================================== -->

    <RadzenCard Style="
        border-radius: 12px;
        background-color: #f7fbff;
        border: 1px solid #e3edf7;">

        <RadzenText Text="Filtros de búsqueda"
                    TextStyle="TextStyle.H6"
                    Style="
        color: #1565c0;
        font-weight: 700;
        margin-bottom: 5px;" />

        <RadzenText Text="Utilice los filtros para encontrar una solicitud."
                    Style="
        color: #6b7280;
        font-size: 13px;
        margin-bottom: 20px;" />

        <RadzenRow AlignItems="AlignItems.End">

            <!-- CONVOCATORIA -->

            <RadzenColumn Size="12" SizeMD="3">

                <RadzenFormField Text="Convocatoria"
                                 Style="width: 100%;">

                    <RadzenDropDown TValue="int?"
                                    @bind-Value="convocatoriaSeleccionada"
                                    Data="@convocatorias"
                                    TextProperty="Nombre"
                                    ValueProperty="IdConvocatoria"
                                    Placeholder="Todas"
                                    AllowClear="true"
                                    Style="width: 100%;" />

                </RadzenFormField>

            </RadzenColumn>


            <!-- ESTADO -->

            <RadzenColumn Size="12" SizeMD="3">

                <RadzenFormField Text="Estado"
                                 Style="width: 100%;">

                    <RadzenDropDown TValue="string"
                                    @bind-Value="estadoSeleccionado"
                                    Data="@(new[] {
                                                        "Pendiente",
                                                        "En revisión",
                                                        "En evaluación",
                                                        "Aprobada",
                                                        "Rechazada"
                                                    })"
                                    Placeholder="Todos"
                                    AllowClear="true"
                                    Style="width: 100%;" />

                </RadzenFormField>

            </RadzenColumn>


            <!-- ESTUDIANTE -->

            <RadzenColumn Size="12" SizeMD="4">

                <RadzenFormField Text="Buscar estudiante"
                                 Style="width: 100%;">

                    <RadzenTextBox TValue="string"
                                   @bind-Value="busqueda"
                                   Placeholder="Nombre, DPI o correo"
                                   Style="width: 100%;" />

                </RadzenFormField>

            </RadzenColumn>


            <!-- BUSCAR -->

            <RadzenColumn Size="12" SizeMD="2">

                <RadzenButton Text="Buscar"
                              Icon="search"
                              ButtonStyle="ButtonStyle.Primary"
                              Click="@CargarSolicitudesAsync"
                              Style="width: 100%;" />

            </RadzenColumn>

        </RadzenRow>

    </RadzenCard>


    <!-- ====================================================== -->
    <!-- TABLA DE SOLICITUDES                                   -->
    <!-- ====================================================== -->

    <RadzenCard Style="
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        overflow-x: auto;">

        <RadzenText Text="Solicitudes"
                    TextStyle="TextStyle.H6"
                    Style="
        color: #1565c0;
        font-weight: 700;
        margin-bottom: 5px;" />

        <RadzenText Text="Listado de solicitudes de becas"
                    Style="
        color: #6b7280;
        font-size: 13px;
        margin-bottom: 20px;" />


        @if (!string.IsNullOrWhiteSpace(errorCarga))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Text="@errorCarga" />
        }
        @if (cargando)
        {
            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" />
        }
        <RadzenDataGrid TItem="SolicitudGestionDto"
                        Data="@SolicitudesFiltradas"
                        AllowPaging="true"
                        PageSize="10"
                        AllowSorting="true"
                        AllowFiltering="true"
                        Responsive="true"
                        Style="width: 100%;">

            <Columns>

                <RadzenDataGridColumn TItem="SolicitudGestionDto"
                                      Property="IdSolicitud"
                                      Title="Solicitud"
                                      Width="100px">
                </RadzenDataGridColumn>


                <RadzenDataGridColumn TItem="SolicitudGestionDto"
                                      Property="Estudiante"
                                      Title="Estudiante"
                                      Width="220px">
                </RadzenDataGridColumn>


                <RadzenDataGridColumn TItem="SolicitudGestionDto"
                                      Property="Convocatoria"
                                      Title="Convocatoria"
                                      Width="250px">
                </RadzenDataGridColumn>


                <RadzenDataGridColumn TItem="SolicitudGestionDto"
                                      Property="FechaSolicitud"
                                      Title="Fecha"
                                      Width="130px">

                    <Template Context="solicitud">

                        @solicitud.FechaSolicitud.ToString("dd/MM/yyyy")

                    </Template>

                </RadzenDataGridColumn>


                <RadzenDataGridColumn TItem="SolicitudGestionDto"
                                      Property="Estado"
                                      Title="Estado"
                                      Width="140px">

                    <Template Context="solicitud">

                        @if (solicitud.Estado == "Pendiente")
                        {
                            <RadzenBadge Text="Pendiente"
                                         BadgeStyle="BadgeStyle.Warning" />
                        }
                        else if (solicitud.Estado == "En revisión")
                        {
                            <RadzenBadge Text="En revisión"
                                         BadgeStyle="BadgeStyle.Info" />
                        }
                        else if (solicitud.Estado == "Aprobada")
                        {
                            <RadzenBadge Text="Aprobada"
                                         BadgeStyle="BadgeStyle.Success" />
                        }
                        else if (solicitud.Estado == "En evaluación")
                        {
                            <RadzenBadge Text="En evaluación"
                                         BadgeStyle="BadgeStyle.Info" />
                        }
                        else
                        {
                            <RadzenBadge Text="Rechazada"
                                         BadgeStyle="BadgeStyle.Danger" />
                        }

                    </Template>

                </RadzenDataGridColumn>


                <RadzenDataGridColumn TItem="SolicitudGestionDto"
                                      Title="Acciones"
                                      Width="150px">

                    <Template Context="solicitud">

                        <RadzenButton Icon="visibility"
                                      Text="Ver"
                                      ButtonStyle="ButtonStyle.Light"
                                      Size="ButtonSize.Small"
                                      Click="@(() => VerSolicitud(solicitud))" />

                    </Template>

                </RadzenDataGridColumn>

            </Columns>

        </RadzenDataGrid>

    </RadzenCard>

    @if (solicitudSeleccionada is not null)
    {
        <RadzenCard>
            <RadzenRow AlignItems="AlignItems.Center">
                <RadzenColumn Size="10">
                    <RadzenText Text="@($"Revisión de solicitud #{solicitudSeleccionada.IdSolicitud}")" TextStyle="TextStyle.H6" />
                </RadzenColumn>
                <RadzenColumn Size="2" Style="text-align:right">
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Click="@CerrarDetalle" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="6"><RadzenText Text="@($"Estudiante: {solicitudSeleccionada.Estudiante}")" /></RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6"><RadzenText Text="@($"DPI: {solicitudSeleccionada.Dpi}")" /></RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6"><RadzenText Text="@($"Correo: {solicitudSeleccionada.Correo}")" /></RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6"><RadzenText Text="@($"Teléfono: {solicitudSeleccionada.Telefono}")" /></RadzenColumn>
                <RadzenColumn Size="12"><RadzenText Text="@($"Dirección: {solicitudSeleccionada.Direccion}")" /></RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6"><RadzenText Text="@($"Convocatoria: {solicitudSeleccionada.Convocatoria}")" /></RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6"><RadzenText Text="@($"Fecha: {solicitudSeleccionada.FechaSolicitud:dd/MM/yyyy} · Estado: {solicitudSeleccionada.Estado}")" /></RadzenColumn>
                <RadzenColumn Size="12"><RadzenText Text="@($"Observaciones anteriores: {solicitudSeleccionada.Observaciones}")" /></RadzenColumn>
                @if (solicitudSeleccionada.Punteo.HasValue)
                {
                    <RadzenColumn Size="12"><RadzenText Text="@($"Punteo: {solicitudSeleccionada.Punteo:0.##}")" /></RadzenColumn>
                }
                <RadzenColumn Size="12">
                    <RadzenFormField Text="Motivo del rechazo (obligatorio para rechazar)" Style="width:100%">
                        <RadzenTextArea @bind-Value="motivoRechazo" Rows="3" Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
            @if (solicitudSeleccionada.Estado == "Pendiente" || solicitudSeleccionada.Estado == "En revisión")
            {
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" Style="margin-top:1rem">
                    <RadzenButton Text="Rechazar" Icon="cancel" ButtonStyle="ButtonStyle.Danger"
                                  Click="@(() => GuardarDecisionAsync("Rechazada"))" Disabled="@guardandoDecision" />
                    <RadzenButton Text="Aprobar" Icon="check_circle" ButtonStyle="ButtonStyle.Success"
                                  Click="@(() => GuardarDecisionAsync("Aprobada"))" Disabled="@guardandoDecision" />
                </RadzenStack>
            }
        </RadzenCard>
    }

</RadzenStack>


@code {
    private List<SolicitudGestionDto> solicitudes = new();
    private List<ConvocatoriaDto> convocatorias = new();
    private int? convocatoriaSeleccionada;
    private string? estadoSeleccionado;
    private string busqueda = string.Empty;
    private string? errorCarga;
    private bool cargando;
    private bool guardandoDecision;
    private string motivoRechazo = string.Empty;
    private SolicitudGestionDto? solicitudSeleccionada;
    private IEnumerable<SolicitudGestionDto> SolicitudesFiltradas => solicitudes.Where(s =>
        (string.IsNullOrWhiteSpace(estadoSeleccionado) || s.Estado.Equals(estadoSeleccionado, StringComparison.OrdinalIgnoreCase)) &&
        (!convocatoriaSeleccionada.HasValue || s.IdConvocatoria == convocatoriaSeleccionada.Value) &&
        (string.IsNullOrWhiteSpace(busqueda) || s.Estudiante.Contains(busqueda, StringComparison.OrdinalIgnoreCase) || s.Dpi.Contains(busqueda, StringComparison.OrdinalIgnoreCase) || s.Correo.Contains(busqueda, StringComparison.OrdinalIgnoreCase)));

    protected override Task OnInitializedAsync() => CargarSolicitudesAsync();

    private async Task CargarSolicitudesAsync()
    {
        cargando = true;
        errorCarga = null;
        try
        {
            solicitudes = await Api.ObtenerSolicitudesAsync();
            convocatorias = await Api.ObtenerConvocatoriasAsync();
        }
        catch (Exception ex)
        {
            errorCarga = $"No se pudieron cargar las solicitudes: {ex.Message}";
            Notifications.Notify(NotificationSeverity.Error, "Error al cargar solicitudes", ex.Message);
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task VerSolicitud(SolicitudGestionDto solicitud)
    {
        solicitudSeleccionada = solicitud;
        motivoRechazo = string.Empty;
    }

    private void CerrarDetalle()
    {
        solicitudSeleccionada = null;
        motivoRechazo = string.Empty;
    }

    private async Task GuardarDecisionAsync(string estado)
    {
        if (solicitudSeleccionada is null) return;
        if (estado == "Rechazada" && string.IsNullOrWhiteSpace(motivoRechazo))
        {
            Notifications.Notify(NotificationSeverity.Warning, "Falta la justificación", "Escribe el motivo del rechazo.");
            return;
        }

        guardandoDecision = true;
        try
        {
            await Api.ActualizarEstadoSolicitudAsync(solicitudSeleccionada.IdSolicitud, new SolicitudEstadoDto
            {
                Estado = estado,
                Observaciones = estado == "Rechazada" ? motivoRechazo.Trim() : solicitudSeleccionada.Observaciones
            });
            Notifications.Notify(NotificationSeverity.Success, $"Solicitud {estado.ToLowerInvariant()}", "La decisión se guardó correctamente.");
            CerrarDetalle();
            await CargarSolicitudesAsync();
        }
        catch (Exception ex)
        {
            Notifications.Notify(NotificationSeverity.Error, "No se pudo guardar la decisión", ex.Message);
        }
        finally
        {
            guardandoDecision = false;
        }
    }
}

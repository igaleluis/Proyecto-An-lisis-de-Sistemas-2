    private IEnumerable<SolicitudModelo> solicitudesFiltradas =>
        solicitudes.Where(x =>
            (string.IsNullOrEmpty(estadoFiltro) ||
             x.Estado == estadoFiltro)
            &&
            (!convocatoriaFiltro.HasValue ||
             x.IdConvocatoria == convocatoriaFiltro.Value)
            &&
            (string.IsNullOrWhiteSpace(busqueda) ||
             x.Estudiante.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ||
             x.DPI.Contains(busqueda, StringComparison.OrdinalIgnoreCase))
        );


    private void Buscar()
    {
        // La propiedad solicitudesFiltradas se actualiza automáticamente.
        StateHasChanged();
    }


    private void SeleccionarSolicitud(SolicitudModelo solicitud)
    {
        AbrirDetalle(solicitud);
    }


    private async Task AbrirDetalle(SolicitudModelo solicitud)
    {
        var resultado = await DialogService.OpenAsync<GestionSolicitudDetalle>(
            $"Solicitud #{solicitud.IdSolicitud}",
            new Dictionary<string, object>
            {
            { "Solicitud", solicitud }
            },
            new DialogOptions
            {
                Width = "900px",
                Height = "90vh",
                Resizable = true,
                Draggable = true,
                CloseDialogOnOverlayClick = false
            });

        if (resultado is true)
        {
            await InvokeAsync(StateHasChanged);
        }
    }


    private void CerrarDetalle()
    {
        mostrarDetalle = false;
        solicitudSeleccionada = null;
    }


    private void AprobarSolicitud(SolicitudModelo solicitud)
    {
        if (string.IsNullOrWhiteSpace(justificacion))
        {
            justificacion = "Solicitud aprobada por cumplir con los requisitos establecidos.";
        }

        solicitud.Estado = "Aprobada";

        mostrarDetalle = false;

        StateHasChanged();
    }


    private void RechazarSolicitud(SolicitudModelo solicitud)
    {
        if (string.IsNullOrWhiteSpace(justificacion))
        {
            justificacion = "Solicitud rechazada por no cumplir con los requisitos establecidos.";
        }

        solicitud.Estado = "Rechazada";

        mostrarDetalle = false;

        StateHasChanged();
    }


    private BadgeStyle ObtenerBadgePunteo(decimal punteo)
    {
        if (punteo >= 90)
            return BadgeStyle.Success;

        if (punteo >= 75)
            return BadgeStyle.Info;

        if (punteo >= 60)
            return BadgeStyle.Warning;

        return BadgeStyle.Danger;
    }



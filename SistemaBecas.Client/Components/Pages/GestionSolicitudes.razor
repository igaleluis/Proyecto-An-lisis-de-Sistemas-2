@page "/gestion-solicitudes"
@inject DialogService DialogService
<PageTitle>Gestión de Solicitudes</PageTitle>


<div class="container-fluid">

    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Gestión de Solicitudes</h3>
            <p class="text-muted mb-0">
                Aprobar o rechazar solicitudes de beca
            </p>
        </div>

        <RadzenBadge Text="@($"{solicitudes.Count} solicitudes")"
                     BadgeStyle="BadgeStyle.Secondary"
                     IsPill = "true"
                     Style="font-size: 14px; padding: 8px 14px;" />
    </div>


    <!-- FILTROS -->
    <RadzenCard class="mb-4">

        <div class="mb-3">
            <h5 class="fw-bold mb-1">Filtros de búsqueda</h5>
            <span class="text-muted">
                Utilice los filtros para encontrar una solicitud.
            </span>
        </div>

        <RadzenRow Gap="1rem">

            <!-- ESTADO -->
            <RadzenColumn Size="12" SizeMD="3">

                <RadzenFormField Text="Estado" Variant="Variant.Outlined" Style="width:100%">
                    <RadzenDropDown @bind-Value="estadoFiltro"
                                    Data="@estados"
                                    Placeholder="Todos"
                                    AllowClear="true"
                                    Style="width:100%;" />
                </RadzenFormField>

            </RadzenColumn>


            <!-- CONVOCATORIA -->
            <RadzenColumn Size="12" SizeMD="3">

                <RadzenFormField Text="Convocatoria" Variant="Variant.Outlined" Style="width:100%">
                    <RadzenDropDown @bind-Value="convocatoriaFiltro"
                                    Data="@convocatorias"
                                    TextProperty="Nombre"
                                    ValueProperty="IdConvocatoria"
                                    Placeholder="Todas"
                                    AllowClear="true"
                                    Style="width:100%;" />
                </RadzenFormField>

            </RadzenColumn>


            <!-- BUSCAR ESTUDIANTE -->
            <RadzenColumn Size="12" SizeMD="4">

                <RadzenFormField Text="Buscar estudiante" Variant="Variant.Outlined" Style="width:100%">

                    <RadzenTextBox @bind-Value="busqueda"
                                   Placeholder="Nombre o DPI"
                                   Style="width:100%;" />

                </RadzenFormField>

            </RadzenColumn>


            <!-- BOTÓN -->
            <RadzenColumn Size="12" SizeMD="2" class="d-flex align-items-end">

                <RadzenButton Text="Buscar"
                              Icon="search"
                              ButtonStyle="ButtonStyle.Secondary"
                              Click="@Buscar"
                              Style="width:100%;" />

            </RadzenColumn>

        </RadzenRow>

    </RadzenCard>


    <!-- TARJETAS DE ESTADO -->

    <RadzenRow Gap="1rem" class="mb-4">

        <RadzenColumn Size="12" SizeMD="4">

            <RadzenCard class="status-card">

                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <div class="text-muted">Pendientes</div>
                        <h3 class="fw-bold mb-0">
                            @solicitudes.Count(x => x.Estado == "Pendiente")
                        </h3>
                    </div>

                    <RadzenIcon Icon="pending_actions"
                                Style="font-size:40px; color:#f59e0b;" />

                </div>

            </RadzenCard>

        </RadzenColumn>


        <RadzenColumn Size="12" SizeMD="4">

            <RadzenCard class="status-card">

                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <div class="text-muted">Aprobadas</div>
                        <h3 class="fw-bold mb-0">
                            @solicitudes.Count(x => x.Estado == "Aprobada")
                        </h3>
                    </div>

                    <RadzenIcon Icon="check_circle"
                                Style="font-size:40px; color:#16a34a;" />

                </div>

            </RadzenCard>

        </RadzenColumn>


        <RadzenColumn Size="12" SizeMD="4">

            <RadzenCard class="status-card">

                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <div class="text-muted">Rechazadas</div>
                        <h3 class="fw-bold mb-0">
                            @solicitudes.Count(x => x.Estado == "Rechazada")
                        </h3>
                    </div>

                    <RadzenIcon Icon="cancel"
                                Style="font-size:40px; color:#dc2626;" />

                </div>

            </RadzenCard>

        </RadzenColumn>

    </RadzenRow>


    <!-- TABLA -->

    <RadzenCard>

        <div class="d-flex justify-content-between align-items-center mb-3">

            <div>
                <h5 class="fw-bold mb-1">Solicitudes</h5>
                <span class="text-muted">
                    Listado de solicitudes de beca
                </span>
            </div>

        </div>


        <RadzenDataGrid @ref="grid"
                        Data="@solicitudesFiltradas"
                        TItem="SolicitudModelo"
                        AllowPaging="true"
                        AllowSorting="true"
                        AllowFiltering="true"
                        PageSize="8"
                        Responsive="true"
                        EmptyText="No se encontraron solicitudes.">

            <Columns>

                <!-- ID -->

                <RadzenDataGridColumn TItem="SolicitudDemo"
                                      Property="IdSolicitud"
                                      Title="Solicitud"
                                      Width="110px" />

                <!-- ESTUDIANTE -->

                <RadzenDataGridColumn TItem="SolicitudDemo"
                                      Title="Estudiante"
                                      Width="220px">

                    <Template Context="solicitud">

                        <div>
                            <div class="fw-semibold">
                                @solicitud.Estudiante
                            </div>

                            <small class="text-muted">
                                DPI: @solicitud.DPI
                            </small>
                        </div>

                    </Template>

                </RadzenDataGridColumn>


                <!-- CONVOCATORIA -->

                <RadzenDataGridColumn TItem="SolicitudDemo"
                                      Property="Convocatoria"
                                      Title="Convocatoria"
                                      Width="180px" />


                <!-- FECHA -->

                <RadzenDataGridColumn TItem="SolicitudDemo"
                                      Property="FechaSolicitud"
                                      Title="Fecha solicitud"
                                      Width="140px">

                    <Template Context="solicitud">
                        @solicitud.FechaSolicitud.ToString("dd/MM/yyyy")
                    </Template>

                </RadzenDataGridColumn>


                <!-- PUNTEO -->

                <RadzenDataGridColumn TItem="SolicitudDemo"
                                      Title="Punteo"
                                      Width="100px">

                    <Template Context="solicitud">

                        <RadzenBadge Text="@solicitud.Punteo.ToString()"
                                     BadgeStyle="@ObtenerBadgePunteo(solicitud.Punteo)" />

                    </Template>

                </RadzenDataGridColumn>


                <!-- ESTADO -->

                <RadzenDataGridColumn TItem="SolicitudDemo"
                                      Title="Estado"
                                      Width="130px">

                    <Template Context="solicitud">

                        @if (solicitud.Estado == "Pendiente")
                        {
                            <RadzenBadge Text="Pendiente"
                                         BadgeStyle="BadgeStyle.Warning" />
                        }
                        else if (solicitud.Estado == "Aprobada")
                        {
                            <RadzenBadge Text="Aprobada"
                                         BadgeStyle="BadgeStyle.Success" />
                        }
                        else
                        {
                            <RadzenBadge Text="Rechazada"
                                         BadgeStyle="BadgeStyle.Danger" />
                        }

                    </Template>

                </RadzenDataGridColumn>


                <!-- ACCIÓN -->

                <RadzenDataGridColumn TItem="SolicitudModelo"
                                      Title="Acciones"
                                      Width="130px"
                                      Sortable="false">

                    <Template Context="solicitud">

                        <RadzenButton Icon="visibility"
                                      Text="Ver"
                                      ButtonStyle="ButtonStyle.Light"
                                      Size="ButtonSize.Small"
                                      Click="@(() => AbrirDetalle(solicitud))" />

                    </Template>

                </RadzenDataGridColumn>

            </Columns>

        </RadzenDataGrid>

    </RadzenCard>

</div>





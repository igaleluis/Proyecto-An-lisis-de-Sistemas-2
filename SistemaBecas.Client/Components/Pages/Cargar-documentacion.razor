@page "/cargar-documentacion"

@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using SistemaBecas.Library.Dtos
@using Microsoft.AspNetCore.Authorization
@using SistemaBecas.Client.Services.Documentacion

@inject DocumentacionService DocumentacionService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

@attribute [Authorize(Roles = "Estudiante")]


<PageTitle>Sistema de Becas - Cargar documentación</PageTitle>

<RadzenStack Gap="1.5rem"
             Style="padding: 2rem; background-color: #f4f7fb; min-height: 100vh;">

    <!-- ====================================================== -->
    <!-- CONTENEDOR PRINCIPAL                                   -->
    <!-- ====================================================== -->

    <RadzenCard Style="
        max-width: 1000px;
        width: 100%;
        margin: 0 auto;
        padding: 0;
        overflow: hidden;
        border-radius: 16px;
        border: 1px solid #e5e7eb;">

        <!-- ================================================== -->
        <!-- ENCABEZADO                                         -->
        <!-- ================================================== -->

        <RadzenCard Style="
            background: linear-gradient(135deg, #1565c0, #1e88e5);
            color: white;
            border: none;
            border-radius: 0;
            padding: 2rem;">

            <RadzenStack AlignItems="AlignItems.Center"
                         Gap="0.5rem">

                <RadzenIcon Icon="description"
                            Style="
                font-size:48px;
                color:white;" />

                <RadzenText Text="Sistema de Becas"
                            TextStyle="TextStyle.H4"
                            Style="
                color:white;
                font-weight:700;
                margin:0;" />

                <RadzenText Text="Cargar documentación"
                            Style="
                color:rgba(255,255,255,0.9);
                font-size:16px;" />

            </RadzenStack>

        </RadzenCard>


        <!-- ================================================== -->
        <!-- CONTENIDO                                          -->
        <!-- ================================================== -->

        <RadzenStack Gap="1.5rem"
                     Style="padding:2rem;">

            <!-- TÍTULO -->

            <RadzenStack Gap="0.3rem">

                <RadzenText Text="Documentación de la solicitud"
                            TextStyle="TextStyle.H5"
                            Style="
                color:#1565c0;
                font-weight:700;" />

                <RadzenText Text="Seleccione una solicitud y cargue los documentos requeridos."
                            Style="
                color:#6b7280;
                font-size:14px;" />

            </RadzenStack>


            <!-- ================================================== -->
            <!-- SOLICITUD                                           -->
            <!-- ================================================== -->

            <RadzenFormField Text="Solicitud"
                             Variant="Variant.Outlined"
                             Style="width:100%;">

                <RadzenDropDown TValue="int?"
                                Data="@solicitudes"
                                TextProperty="TextoSolicitud"
                                ValueProperty="IdSolicitud"
                                @bind-Value="@solicitudSeleccionada"
                                Change="@SeleccionarSolicitud"
                                Placeholder="Seleccione una solicitud"
                                AllowClear="true"
                                Style="width:100%;" />

            </RadzenFormField>


            <!-- ================================================== -->
            <!-- INFORMACIÓN DE SOLICITUD                            -->
            <!-- ================================================== -->
            @if (solicitudActual != null)
            {
                <RadzenCard Variant="Variant.Outlined"
                            Style="
                    border-radius:12px;
                    background-color:#f8fafc;
                    padding:1.2rem;">

                    <RadzenRow>

                        <RadzenColumn Size="12"
                                      SizeMD="4">

                            <RadzenText Text="Solicitud"
                                        Style="
                            color:#6b7280;
                            font-size:12px;" />

                            <RadzenText Text="@($"#{solicitudActual.IdSolicitud:D4}")"
                                        Style="
                            font-weight:700;
                            margin-top:4px;" />

                        </RadzenColumn>


                        <RadzenColumn Size="12"
                                      SizeMD="4">

                            <RadzenText Text="Estado"
                                        Style="
                            color:#6b7280;
                            font-size:12px;" />

                            <RadzenText Text="@solicitudActual.Estado"
                                        Style="
                            font-weight:600;
                            margin-top:4px;" />

                        </RadzenColumn>


                        <RadzenColumn Size="12"
                                      SizeMD="4">

                            <RadzenText Text="Fecha de solicitud"
                                        Style="
                            color:#6b7280;
                            font-size:12px;" />

                            <RadzenText Text="@solicitudActual.FechaSolicitud.ToString("dd/MM/yyyy")"
                                        Style="
                            font-weight:600;
                            margin-top:4px;" />

                        </RadzenColumn>

                    </RadzenRow>

                </RadzenCard>
            }


            <!-- ================================================== -->
            <!-- DOCUMENTOS REQUERIDOS                              -->
            <!-- ================================================== -->

            <RadzenStack Gap="0.3rem">

                <RadzenText Text="Documentos requeridos"
                            TextStyle="TextStyle.H6"
                            Style="
                color:#1565c0;
                font-weight:700;" />

                <RadzenText Text="Adjunte los documentos correspondientes a la solicitud."
                            Style="
                color:#6b7280;
                font-size:14px;" />

            </RadzenStack>


            @if (solicitudSeleccionada != null)
            {
                @if (cargandoDocumentos)
                {
                    <RadzenStack AlignItems="AlignItems.Center"
                                 Gap="0.5rem"
                                 Style="padding:2rem;">

                        <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" />

                        <RadzenText Text="Cargando documentos..."
                                    Style="color:#6b7280;" />

                    </RadzenStack>
                }
                else if (documentos.Any())
                {
                    
                    @foreach(var documento in documentos)
                    {
                        <div class="mb-4 p-3 border rounded">

                            <div class="d-flex justify-content-between align-items-center">

                                <div>
                                    <h5 class="mb-1">
                                        @documento.Nombre
                                    </h5>

                                    @if (!string.IsNullOrWhiteSpace(documento.Descripcion))
                                    {
                                        <p class="text-muted mb-2">
                                            @documento.Descripcion
                                        </p>
                                    }

                                    <span class="badge
                                        @(documento.Estado == "Cargado"
                                              ? "bg-success"
                                              : "bg-warning text-dark")">

                                        @documento.Estado

                                    </span>
                                </div>

                                <div>

                                    @if (!string.IsNullOrWhiteSpace(
                                        documento.UrlArchivo))
                                    {
                                        <RadzenButton Text="Ver documento"
                                                      Icon="visibility"
                                                      ButtonStyle="ButtonStyle.Info"
                                                      Click="@(() =>
                                                                                  VerDocumento(
                                                                                      documento.UrlArchivo!))" />
                                    }

                                </div>

                            </div>

                            <div class="mt-3">

                                <InputFile accept=".pdf,.jpg,.jpeg,.png"
                                           OnChange="@((e) =>
                                                               SeleccionarArchivo(
                                                                   documento.IdDocumento,
                                                                   e))" />

                                @if (archivosSeleccionados
                                    .ContainsKey(documento.IdDocumento))
                                {
                                    <RadzenText Text="@archivosSeleccionados[
                                                                        documento.IdDocumento].Name"
                                                Style="display:block;margin-top:8px;" />
                                }

                            </div>

                        </div>
                    }


                }
                else
                {
                    <RadzenAlert AlertStyle="AlertStyle.Info">
                        No hay documentos requeridos para esta solicitud.
                    </RadzenAlert>
                }
            }
            else
            {
                <RadzenAlert AlertStyle="AlertStyle.Info">
                    Seleccione una solicitud para consultar los documentos requeridos.
                </RadzenAlert>
            }


            <!-- ================================================== -->
            <!-- OBSERVACIONES                                      -->
            <!-- ================================================== -->

            <RadzenFormField Text="Observaciones"
                             Variant="Variant.Outlined"
                             Style="width:100%;">

                <RadzenTextArea Rows="4"
                                @bind-Value="@observaciones"
                                Placeholder="Ingrese alguna observación sobre la documentación..."
                                Style="width:100%;" />

            </RadzenFormField>


            <!-- ================================================== -->
            <!-- MENSAJE                                             -->
            <!-- ================================================== -->
            @if (!string.IsNullOrWhiteSpace(mensaje))
            {
                <RadzenAlert AlertStyle="@(error
                                                     ? AlertStyle.Danger
                                                     : AlertStyle.Success)">

                    @mensaje

                </RadzenAlert>
            }


            <!-- ================================================== -->
            <!-- BOTONES                                             -->
            <!-- ================================================== -->

            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.End"
                         Gap="0.5rem">

                <RadzenButton Text="Cancelar"
                              Icon="close"
                              ButtonStyle="ButtonStyle.Light"
                              Variant="Variant.Outlined"
                              Click="@Cancelar"
                              Disabled="@subiendoDocumento" />


                <RadzenButton Text="@(subiendoDocumento
                                                      ? "Cargando..."
                                                      : "Guardar documentación")"
                              Icon="save"
                              ButtonStyle="ButtonStyle.Primary"
                              Click="@GuardarDocumento"
                              Disabled="@(solicitudSeleccionada == null
                                                      || !archivosSeleccionados.Any()
                                                      || subiendoDocumento)" />

            </RadzenStack>


            @if (subiendoDocumento)
            {
                <RadzenStack AlignItems="AlignItems.Center"
                             Gap="0.5rem">

                    <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" />

                    <RadzenText Text="Subiendo documentación..."
                                Style="color:#6b7280;" />

                </RadzenStack>
            }


            <!-- ================================================== -->
            <!-- SEGURIDAD                                           -->
            <!-- ================================================== -->

            <RadzenStack AlignItems="AlignItems.Center"
                         Gap="0.3rem"
                         Style="margin-top:0.5rem;">

                <RadzenIcon Icon="lock"
                            Style="
                color:#6b7280;
                font-size:20px;" />

                <RadzenText Text="Información protegida"
                            Style="
                color:#6b7280;
                font-size:13px;" />

            </RadzenStack>

        </RadzenStack>

    </RadzenCard>


    <!-- ====================================================== -->
    <!-- PIE                                                     -->
    <!-- ====================================================== -->

    <RadzenText Text="Sistema de Becas"
                Style="
    text-align:center;
    color:#6b7280;
    font-size:13px;" />

</RadzenStack>


@code {

    private int? solicitudSeleccionada;

    private string observaciones = "";

    private bool cargandoDocumentos = false;

    private bool subiendoDocumento = false;

    private string? mensaje;

    private bool error;

    private Dictionary<int, IBrowserFile> archivosSeleccionados = new();

    private List<SolicitudDocumentacionDto> solicitudes = new();

    private List<DocumentoSolicitudDto> documentos = new();

    private SolicitudDocumentacionDto? solicitudActual;


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        solicitudes =
            await DocumentacionService
                .ObtenerMisSolicitudes();

        StateHasChanged();
    }


    private async Task SeleccionarSolicitud(object value)
    {
        if (value == null)
        {
            solicitudSeleccionada = null;
            solicitudActual = null;

            documentos.Clear();

            archivosSeleccionados.Clear();

            mensaje = null;
            error = false;

            return;
        }

        solicitudSeleccionada =
            Convert.ToInt32(value);

        solicitudActual =
            solicitudes.FirstOrDefault(
                s => s.IdSolicitud ==
                     solicitudSeleccionada.Value);

        cargandoDocumentos = true;

        mensaje = null;
        error = false;

        archivosSeleccionados.Clear();

        documentos =
            await DocumentacionService
                .ObtenerDocumentosSolicitud(
                    solicitudSeleccionada.Value);

        cargandoDocumentos = false;
    }


    private string ObtenerIcono(
        string nombreDocumento)
    {
        if (nombreDocumento.Contains(
                "DPI",
                StringComparison.OrdinalIgnoreCase))
        {
            return "badge";
        }

        if (nombreDocumento.Contains(
                "estudios",
                StringComparison.OrdinalIgnoreCase))
        {
            return "school";
        }

        if (nombreDocumento.Contains(
                "notas",
                StringComparison.OrdinalIgnoreCase))
        {
            return "article";
        }

        return "description";
    }


    private void SeleccionarArchivo(
        int idDocumento,
        InputFileChangeEventArgs e)
    {
        archivosSeleccionados[idDocumento] =
            e.File;

        mensaje = null;
        error = false;
    }


    private async Task GuardarDocumento()
    {
        if (solicitudSeleccionada == null)
        {
            mensaje =
                "Debe seleccionar una solicitud.";

            error = true;

            return;
        }

        if (!archivosSeleccionados.Any())
        {
            mensaje =
                "Debe seleccionar al menos un documento.";

            error = true;

            return;
        }

        subiendoDocumento = true;

        mensaje = null;

        error = false;

        try
        {
            foreach (var archivo in archivosSeleccionados)
            {
                var idDocumento =
                    archivo.Key;

                var archivoSeleccionado =
                    archivo.Value;

                var resultado =
                    await DocumentacionService
                        .SubirDocumento(
                            solicitudSeleccionada.Value,
                            idDocumento,
                            archivoSeleccionado,
                            observaciones);

                if (!resultado)
                {
                    mensaje =
                        $"No fue posible cargar el documento con ID {idDocumento}.";

                    error = true;

                    return;
                }
            }

            mensaje =
                "Los documentos fueron cargados correctamente.";

            archivosSeleccionados.Clear();

            observaciones = "";

            documentos =
                await DocumentacionService
                    .ObtenerDocumentosSolicitud(
                        solicitudSeleccionada.Value);
        }
        catch (Exception ex)
        {
            mensaje =
                $"Error al cargar los documentos: {ex.Message}";

            error = true;
        }
        finally
        {
            subiendoDocumento = false;
        }
    }


    private void Cancelar()
    {
        solicitudSeleccionada = null;

        solicitudActual = null;

        documentos.Clear();

        observaciones = "";

        archivosSeleccionados.Clear();

        mensaje = null;

        error = false;
    }
    private async Task VerDocumento(string url)
    {
        await JSRuntime.InvokeVoidAsync(
            "open",
            url,
            "_blank");
    }

}